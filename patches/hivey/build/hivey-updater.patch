+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#include "chrome/browser/hivey/hivey_updater.h"
+
+#include <array>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/files/file.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/process/launch.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "base/version.h"
+#include "build/build_config.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/hivey/update_public_key.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/version_info/version_info.h"
+#include "crypto/hash.h"
+#include "crypto/keypair.h"
+#include "crypto/sign.h"
+#include "net/base/load_flags.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "url/gurl.h"
+
+#if BUILDFLAG(IS_WIN)
+#include "chrome/installer/util/install_util.h"
+#endif
+
+namespace hivey {
+
+namespace {
+
+constexpr char kManifestUrl[] =
+    "https://github.com/FlorianMartins/hivey-browser/releases/latest/download/"
+    "hivey-update.json";
+constexpr char kSignatureUrl[] =
+    "https://github.com/FlorianMartins/hivey-browser/releases/latest/download/"
+    "hivey-update.json.sig";
+
+constexpr base::TimeDelta kFirstCheckDelay = base::Minutes(10);
+constexpr base::TimeDelta kCheckInterval = base::Hours(12);
+constexpr base::TimeDelta kRetryDelay = base::Hours(1);
+constexpr base::TimeDelta kInstallerCleanupDelay = base::Minutes(15);
+constexpr size_t kMaxManifestSize = 64 * 1024;
+
+#if BUILDFLAG(IS_WIN)
+// Every installer the updater runs must come from this repository's releases.
+constexpr char kReleasesUrl[] =
+    "https://github.com/FlorianMartins/hivey-browser/releases/";
+constexpr int64_t kMaxInstallerSize = 512LL * 1024 * 1024;
+
+bool IsReleaseUrl(const GURL& url) {
+  return url.is_valid() && url.SchemeIs(url::kHttpsScheme) &&
+         base::StartsWith(url.spec(), kReleasesUrl);
+}
+#endif
+
+Updater* g_updater = nullptr;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("hivey_updater", R"(
+      semantics {
+        sender: "Hivey Browser updater"
+        description:
+          "Checks the latest Hivey Browser release and downloads its "
+          "installer when it is newer, so security fixes are applied."
+        trigger:
+          "10 minutes after the browser starts, then every 12 hours, or "
+          "'Check now' in Hivey Studio."
+        data:
+          "None: plain GET requests for public release files, without "
+          "cookies."
+        destination: OTHER
+        destination_other: "github.com (Hivey Browser releases)."
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Hivey Studio > About > Automatic updates."
+        policy_exception_justification: "Not implemented."
+      })");
+
+const char* PlatformKey() {
+#if BUILDFLAG(IS_WIN)
+  return "windows-x64";
+#elif BUILDFLAG(IS_LINUX)
+  return "linux-x64";
+#else
+  return "";
+#endif
+}
+
+std::unique_ptr<network::SimpleURLLoader> MakeLoader(const GURL& url) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader->SetRetryOptions(
+      2, network::SimpleURLLoader::RETRY_ON_NETWORK_CHANGE |
+             network::SimpleURLLoader::RETRY_ON_5XX);
+  return loader;
+}
+
+bool VerifyManifestSignature(const std::string& manifest,
+                             const std::string& signature) {
+  if (signature.size() != 64) {
+    return false;
+  }
+  const crypto::keypair::PublicKey key =
+      crypto::keypair::PublicKey::FromEd25519PublicKey(kHiveyUpdatePublicKey);
+  return crypto::sign::Verify(crypto::sign::ED25519, key,
+                              base::as_byte_span(manifest),
+                              base::as_byte_span(signature));
+}
+
+// Blocking: the downloaded file has the size and sha256 of the manifest.
+bool CheckInstallerFile(const base::FilePath& path,
+                        const std::string& sha256_hex,
+                        int64_t size) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid() || file.GetLength() != size) {
+    return false;
+  }
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  if (!crypto::hash::HashFile(crypto::hash::kSha256, &file, digest)) {
+    return false;
+  }
+  return base::EqualsCaseInsensitiveASCII(base::HexEncode(digest), sha256_hex);
+}
+
+void DeleteFileLater(const base::FilePath& path) {
+  base::ThreadPool::PostDelayedTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::GetDeleteFileCallback(path), kInstallerCleanupDelay);
+}
+
+PrefService* LocalState() {
+  return g_browser_process ? g_browser_process->local_state() : nullptr;
+}
+
+}  // namespace
+
+void RegisterUpdaterPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kAutoUpdateEnabled, true);
+  registry->RegisterTimePref(kUpdateLastCheck, base::Time());
+  registry->RegisterStringPref(kUpdateStatus, std::string());
+  registry->RegisterStringPref(kUpdateAvailableVersion, std::string());
+}
+
+Updater::Updater() {
+  DCHECK(!g_updater);
+  g_updater = this;
+  // Never a request at startup.
+  ScheduleNextCheck(kFirstCheckDelay);
+}
+
+Updater::~Updater() {
+  g_updater = nullptr;
+}
+
+// static
+Updater* Updater::Get() {
+  return g_updater;
+}
+
+void Updater::CheckNow() {
+  if (!checking_) {
+    StartCheck();
+  }
+}
+
+base::DictValue Updater::GetStatus() const {
+  PrefService* local_state = LocalState();
+  if (!local_state) {
+    return base::DictValue();
+  }
+  const base::Time last = local_state->GetTime(kUpdateLastCheck);
+  return base::DictValue()
+      .Set("enabled", local_state->GetBoolean(kAutoUpdateEnabled))
+      .Set("checking", checking_)
+      .Set("status", local_state->GetString(kUpdateStatus))
+      .Set("available", local_state->GetString(kUpdateAvailableVersion))
+      .Set("lastCheck", last.is_null() ? 0.0 : last.InMillisecondsFSinceUnixEpoch());
+}
+
+void Updater::ScheduleNextCheck(base::TimeDelta delay) {
+  timer_.Start(FROM_HERE, delay,
+               base::BindOnce(&Updater::OnTimer, base::Unretained(this)));
+}
+
+void Updater::OnTimer() {
+  PrefService* local_state = LocalState();
+  if (local_state && local_state->GetBoolean(kAutoUpdateEnabled)) {
+    StartCheck();
+  }
+  ScheduleNextCheck(kCheckInterval);
+}
+
+void Updater::StartCheck() {
+  checking_ = true;
+  loader_ = MakeLoader(GURL(kManifestUrl));
+  loader_->DownloadToString(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&Updater::OnManifestDownloaded,
+                     weak_factory_.GetWeakPtr()),
+      kMaxManifestSize);
+}
+
+void Updater::OnManifestDownloaded(std::optional<std::string> body) {
+  if (!body) {
+    Finish("error-network");
+    ScheduleNextCheck(kRetryDelay);
+    return;
+  }
+  loader_ = MakeLoader(GURL(kSignatureUrl));
+  loader_->DownloadToString(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&Updater::OnSignatureDownloaded,
+                     weak_factory_.GetWeakPtr(), std::move(*body)),
+      1024);
+}
+
+void Updater::OnSignatureDownloaded(std::string manifest,
+                                    std::optional<std::string> body) {
+  if (!body) {
+    Finish("error-network");
+    ScheduleNextCheck(kRetryDelay);
+    return;
+  }
+  if (!VerifyManifestSignature(manifest, *body)) {
+    LOG(ERROR) << "Hivey updater: the update manifest signature is invalid";
+    Finish("error-signature");
+    return;
+  }
+  std::optional<base::Value> parsed = base::JSONReader::Read(manifest);
+  if (!parsed || !parsed->is_dict()) {
+    Finish("error-manifest");
+    return;
+  }
+  OnManifestVerified(std::move(*parsed).TakeDict());
+}
+
+void Updater::OnManifestVerified(base::DictValue manifest) {
+  const std::string* version_string = manifest.FindString("version");
+  const base::DictValue* platform = manifest.FindDict(PlatformKey());
+  const base::Version latest(version_string ? *version_string : "");
+  if (!latest.IsValid() || !platform) {
+    Finish("error-manifest");
+    return;
+  }
+  if (latest.CompareTo(version_info::GetVersion()) <= 0) {
+    available_version_.clear();
+    Finish("up-to-date");
+    return;
+  }
+  available_version_ = *version_string;
+
+#if BUILDFLAG(IS_WIN)
+  const std::string* url = platform->FindString("url");
+  const std::string* sha256 = platform->FindString("sha256");
+  const std::optional<double> size = platform->FindDouble("size");
+  if (!url || !sha256 || !size || !IsReleaseUrl(GURL(*url)) ||
+      *size <= 0 || *size > kMaxInstallerSize) {
+    Finish("error-manifest");
+    return;
+  }
+  // A system-level install needs administrator rights: show the update in
+  // Hivey Studio instead.
+  if (!InstallUtil::IsPerUserInstall()) {
+    Finish("available");
+    return;
+  }
+  if (PrefService* local_state = LocalState()) {
+    local_state->SetString(kUpdateStatus, "downloading");
+  }
+  loader_ = MakeLoader(GURL(*url));
+  loader_->DownloadToTempFile(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&Updater::OnInstallerDownloaded,
+                     weak_factory_.GetWeakPtr(), *sha256,
+                     static_cast<int64_t>(*size)),
+      kMaxInstallerSize);
+#else
+  // Portable builds are replaced by the user from the release page.
+  Finish("available");
+#endif
+}
+
+void Updater::OnInstallerDownloaded(std::string expected_sha256,
+                                    int64_t expected_size,
+                                    base::FilePath path) {
+  if (path.empty()) {
+    Finish("error-download");
+    ScheduleNextCheck(kRetryDelay);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&CheckInstallerFile, path, std::move(expected_sha256),
+                     expected_size),
+      base::BindOnce(&Updater::OnInstallerChecked, weak_factory_.GetWeakPtr(),
+                     path));
+}
+
+void Updater::OnInstallerChecked(base::FilePath path, bool ok) {
+  if (!ok) {
+    LOG(ERROR) << "Hivey updater: the installer does not match the manifest";
+    DeleteFileLater(path);
+    Finish("error-download");
+    return;
+  }
+#if BUILDFLAG(IS_WIN)
+  // The installer updates the per-user install in place (new_chrome.exe while
+  // the browser runs); UpgradeDetector then offers "Relaunch to update".
+  base::CommandLine command(path);
+  command.AppendSwitch("do-not-launch-chrome");
+  base::LaunchOptions options;
+  options.start_hidden = true;
+  const bool launched = base::LaunchProcess(command, options).IsValid();
+  DeleteFileLater(path);
+  Finish(launched ? "installing" : "error-install");
+#else
+  DeleteFileLater(path);
+  Finish("available");
+#endif
+}
+
+void Updater::Finish(const std::string& status) {
+  checking_ = false;
+  loader_.reset();
+  if (PrefService* local_state = LocalState()) {
+    local_state->SetTime(kUpdateLastCheck, base::Time::Now());
+    local_state->SetString(kUpdateStatus, status);
+    local_state->SetString(kUpdateAvailableVersion, available_version_);
+  }
+}
+
+}  // namespace hivey
