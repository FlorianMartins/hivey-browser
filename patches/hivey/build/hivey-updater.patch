 // -------------------------------------------------------------------- about
 
+function updateStatusText(update) {
+  if (update.checking) {
+    return t('updateChecking');
+  }
+  const key = {
+    'up-to-date': 'updateUpToDate',
+    'downloading': 'updateDownloading',
+    'installing': 'updateInstalling',
+    'available': 'updateAvailable',
+  }[update.status] || (update.status ? 'updateError' : 'updateNever');
+  let text = t(key);
+  if (update.available && (key === 'updateAvailable' || key === 'updateInstalling')) {
+    text += ` (${update.available})`;
+  }
+  if (update.lastCheck) {
+    text += ` · ${t('updateLastCheck')} ${new Date(update.lastCheck).toLocaleString(document.documentElement.lang)}`;
+  }
+  return text;
+}
+
 function buildAbout() {
+  const update = state.update || {};
   return el('div', {},
             sectionHeader('aboutTitle', 'aboutText'),
             card(null,
                  el('div', {class: 'row'},
                     el('span', {class: 'row-label', text: t('version')}),
                     el('span', {class: 'mono', text: state.version})),
+                 prefToggle('hivey.update.enabled', 'autoUpdate', 'autoUpdateHint'),
+                 el('div', {class: 'row'},
+                    el('span', {class: 'row-hint', text: updateStatusText(update)}),
+                    el('span', {class: 'task-actions'},
+                       update.status === 'available' ? el('button', {
+                         class: 'button ghost', text: t('updateDownload'),
+                         onclick: () => openUrl('https://github.com/FlorianMartins/hivey-browser/releases/latest'),
+                       }) : null,
+                       el('button', {class: 'button', text: t('updateCheckNow'), disabled: update.checking,
+                                     onclick: () => chrome.send('checkForUpdates')}))),
                  linkRow({label: t('sourceCode'),
                           onClick: () => openUrl('https://github.com/FlorianMartins/hivey-browser')}),
                  linkRow({label: t('flags'), onClick: () => openUrl('chrome://flags')})));
