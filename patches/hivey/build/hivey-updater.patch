+// Hivey: chrome/VERSION's PATCH holds the upstream patch number times 100 plus
+// the Hivey revision, so that Hivey-only releases install as updates. Web
+// pages get the upstream Chromium version, like every other Chromium user.
+std::string WebVisibleVersionNumber() {
+  const base::Version& version = version_info::GetVersion();
+  const std::vector<uint32_t>& c = version.components();
+  if (!version.IsValid() || c.size() != 4 || c[3] < 100) {
+    return std::string(version_info::GetVersionNumber());
+  }
+  return base::StringPrintf("%u.%u.%u.%u", c[0], c[1], c[2], c[3] / 100);
+}
