+// the LICENSE file of the Hivey Browser repository.
+
+#ifndef CHROME_BROWSER_HIVEY_HIVEY_UPDATER_H_
+#define CHROME_BROWSER_HIVEY_HIVEY_UPDATER_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+
+class PrefRegistrySimple;
+
+namespace network {
+class SimpleURLLoader;
+}
+
+namespace hivey {
+
+// Local State prefs of the updater.
+inline constexpr char kAutoUpdateEnabled[] = "hivey.update.enabled";
+inline constexpr char kUpdateLastCheck[] = "hivey.update.last_check";
+inline constexpr char kUpdateStatus[] = "hivey.update.status";
+inline constexpr char kUpdateAvailableVersion[] = "hivey.update.available";
+
+void RegisterUpdaterPrefs(PrefRegistrySimple* registry);
+
+// Keeps Hivey Browser up to date without any Google service.
+//
+// No request at startup: the first check runs 10 minutes after launch, then
+// every 12 hours, and never when the user turned automatic updates off. A
+// check downloads hivey-update.json and its Ed25519 signature from the
+// latest GitHub release, verifies the signature with the public key compiled
+// into the browser, and compares versions. On Windows (per-user install) the
+// installer named in the signed manifest is downloaded, checked against its
+// size and sha256 from the manifest, and run silently; the browser then
+// offers "Relaunch to update" (UpgradeDetector). On Linux the new version is
+// shown in Hivey Studio with its download page.
+class Updater {
+ public:
+  Updater();
+  Updater(const Updater&) = delete;
+  Updater& operator=(const Updater&) = delete;
+  ~Updater();
+
+  // The browser's updater, or null before PostBrowserStart / in tests.
+  static Updater* Get();
+
+  // Starts a check now (Hivey Studio's "Check now"), even if automatic
+  // updates are off. Does nothing while a check is running.
+  void CheckNow();
+
+  // Status for Hivey Studio: enabled, status, last check, available version.
+  base::DictValue GetStatus() const;
+
+ private:
+  void ScheduleNextCheck(base::TimeDelta delay);
+  void OnTimer();
+  void StartCheck();
+  void OnManifestDownloaded(std::optional<std::string> body);
+  void OnSignatureDownloaded(std::string manifest,
+                             std::optional<std::string> body);
+  void OnManifestVerified(base::DictValue manifest);
+  void OnInstallerDownloaded(std::string expected_sha256,
+                             int64_t expected_size,
+                             base::FilePath path);
+  void OnInstallerChecked(base::FilePath path, bool ok);
+  void Finish(const std::string& status);
+
+  bool checking_ = false;
+  std::string available_version_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<Updater> weak_factory_{this};
+};
+
+}  // namespace hivey
+
+#endif  // CHROME_BROWSER_HIVEY_HIVEY_UPDATER_H_
