+// Hivey: true if `path` is `dir` or inside it, ignoring case.
+bool IsSameOrInsideDir(const base::FilePath& path, const base::FilePath& dir) {
+  if (dir.empty()) {
+    return false;
+  }
+  const std::wstring root = dir.StripTrailingSeparators().value();
+  const std::wstring_view value = path.value();
+  return value.size() >= root.size() &&
+         base::FilePath::CompareEqualIgnoreCase(value.substr(0, root.size()),
+                                                root) &&
+         (value.size() == root.size() ||
+          base::FilePath::IsSeparator(value[root.size()]));
+}
+
+// Hivey: the folder chosen in the setup wizard for a new per-user install
+// (`distribution.hivey_install_dir`, or --hivey-install-dir), or an empty path
+// if there is none or it is unsuitable. It must be:
+// - absolute and not the root of a volume;
+// - outside Program Files and Windows: install_static treats a browser under
+//   Program Files as a system-level install (HKLM, no self-update);
+// - missing, empty or already holding chrome.exe: uninstall deletes
+//   everything in the install folder, which must never hold the user's files.
+base::FilePath GetHiveyInstallDirFromPrefs(
+    const installer::InitialPreferences& prefs,
+    bool system_install) {
+  base::FilePath dir;
+  if (system_install ||
+      !prefs.GetPath(installer::initial_preferences::kHiveyInstallDir, &dir) ||
+      dir.empty()) {
+    return {};
+  }
+  dir = dir.NormalizePathSeparators().StripTrailingSeparators();
+  if (!dir.IsAbsolute() || dir.ReferencesParent() || dir == dir.DirName()) {
+    LOG(ERROR) << "Install folder refused (not absolute): " << dir;
+    return {};
+  }
+  for (int key : {base::DIR_PROGRAM_FILES, base::DIR_PROGRAM_FILESX86,
+                  base::DIR_PROGRAM_FILES6432, base::DIR_WINDOWS}) {
+    base::FilePath system_dir;
+    if (key == base::DIR_WINDOWS) {
+      base::PathService::Get(key, &system_dir);
+    } else {
+      system_dir = GetPathWithEnvironmentFallback(key);
+    }
+    if (IsSameOrInsideDir(dir, system_dir)) {
+      LOG(ERROR) << "Install folder refused (system folder): " << dir;
+      return {};
+    }
+  }
+  if (base::DirectoryExists(dir) && !base::IsDirectoryEmpty(dir) &&
+      !base::PathExists(dir.Append(installer::kChromeExe))) {
+    LOG(ERROR) << "Install folder refused (not empty): " << dir;
+    return {};
+  }
+  return dir;
+}
