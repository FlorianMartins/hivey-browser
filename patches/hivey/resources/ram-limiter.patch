+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#include "chrome/browser/performance_manager/policies/hivey_memory_limit_policy.h"
+
+#include <cstdint>
+
+#include "base/byte_size.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "chrome/browser/performance_manager/policies/discard_eligibility_policy.h"
+#include "chrome/browser/performance_manager/policies/page_discarding_helper.h"
+#include "components/memory_pressure/reclaim_target.h"
+#include "components/performance_manager/public/graph/process_node.h"
+
+namespace performance_manager::policies {
+
+BASE_FEATURE(kHiveyMemoryLimit, base::FEATURE_DISABLED_BY_DEFAULT);
+BASE_FEATURE_PARAM(int,
+                   kHiveyMemoryLimitMb,
+                   &kHiveyMemoryLimit,
+                   "limit_mb",
+                   4096);
+
+namespace {
+
+constexpr base::TimeDelta kCheckInterval = base::Seconds(30);
+// Longer than ProcessMetricsDecorator's refresh interval (2 minutes).
+constexpr base::TimeDelta kCooldownAfterDiscard = base::Minutes(2) + base::Seconds(30);
+
+}  // namespace
+
+HiveyMemoryLimitPolicy::HiveyMemoryLimitPolicy() = default;
+HiveyMemoryLimitPolicy::~HiveyMemoryLimitPolicy() = default;
+
+void HiveyMemoryLimitPolicy::OnPassedToGraph(Graph* graph) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(PageDiscardingHelper::GetFromGraph(graph))
+      << "HiveyMemoryLimitPolicy needs a PageDiscardingHelper in the graph.";
+  metrics_interest_token_ =
+      ProcessMetricsDecorator::RegisterInterestForProcessMetrics(graph);
+  timer_.Start(FROM_HERE, kCheckInterval,
+               base::BindRepeating(&HiveyMemoryLimitPolicy::CheckMemoryUsage,
+                                   base::Unretained(this)));
+}
+
+void HiveyMemoryLimitPolicy::OnTakenFromGraph(Graph* graph) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  timer_.Stop();
+  metrics_interest_token_.reset();
+}
+
+void HiveyMemoryLimitPolicy::CheckMemoryUsage() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!last_discard_.is_null() &&
+      base::TimeTicks::Now() - last_discard_ < kCooldownAfterDiscard) {
+    return;
+  }
+  const int limit_mb = kHiveyMemoryLimitMb.Get();
+  if (limit_mb <= 0) {
+    return;
+  }
+  const uint64_t limit_kb = static_cast<uint64_t>(limit_mb) * 1024;
+
+  uint64_t total_kb = 0;
+  for (const ProcessNode* process : GetOwningGraph()->GetAllProcessNodes()) {
+    total_kb += process->GetPrivateFootprint().InKiB();
+  }
+  if (total_kb <= limit_kb) {
+    return;
+  }
+
+  // Reclaim the excess plus 10% of the limit, so usage settles below it.
+  const uint64_t reclaim_kb = total_kb - limit_kb + limit_kb / 10;
+  VLOG(1) << "Hivey memory limit: " << total_kb / 1024 << " MiB used, limit "
+          << limit_mb << " MiB, reclaiming " << reclaim_kb / 1024 << " MiB";
+  const std::optional<base::TimeTicks> discarded =
+      PageDiscardingHelper::GetFromGraph(GetOwningGraph())
+          ->DiscardMultiplePages(
+              memory_pressure::ReclaimTarget(base::KiB(reclaim_kb)),
+              /*discard_protected_tabs=*/false,
+              DiscardEligibilityPolicy::DiscardReason::PROACTIVE);
+  if (discarded) {
+    last_discard_ = *discarded;
+  }
+}
+
+}  // namespace performance_manager::policies
