+#ifndef CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_HIVEY_MEMORY_LIMIT_POLICY_H_
+#define CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_HIVEY_MEMORY_LIMIT_POLICY_H_
+
+#include <memory>
+
+#include "base/feature_list.h"
+#include "base/metrics/field_trial_params.h"
+#include "base/sequence_checker.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/performance_manager/public/decorators/process_metrics_decorator.h"
+#include "components/performance_manager/public/graph/graph.h"
+
+namespace performance_manager::policies {
+
+// RAM limiter, like Opera GX: when the private memory of all the browser's
+// processes goes over a limit the user picked, background tabs are discarded
+// (least recently used first, with the usual protections: audio, forms being
+// filled, pinned...) until memory is back under the limit.
+BASE_DECLARE_FEATURE(kHiveyMemoryLimit);
+// The limit, in MiB.
+BASE_DECLARE_FEATURE_PARAM(int, kHiveyMemoryLimitMb);
+
+class HiveyMemoryLimitPolicy : public GraphOwned {
+ public:
+  HiveyMemoryLimitPolicy();
+  ~HiveyMemoryLimitPolicy() override;
+  HiveyMemoryLimitPolicy(const HiveyMemoryLimitPolicy&) = delete;
+  HiveyMemoryLimitPolicy& operator=(const HiveyMemoryLimitPolicy&) = delete;
+
+  // GraphOwned:
+  void OnPassedToGraph(Graph* graph) override;
+  void OnTakenFromGraph(Graph* graph) override;
+
+ private:
+  void CheckMemoryUsage();
+
+  // Keeps process memory measurements flowing while the policy is alive.
+  std::unique_ptr<ProcessMetricsDecorator::ScopedMetricsInterestToken>
+      metrics_interest_token_;
+  base::RepeatingTimer timer_;
+  // Measurements refresh every few minutes: after discarding, wait for fresh
+  // numbers instead of discarding again on stale ones.
+  base::TimeTicks last_discard_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+}  // namespace performance_manager::policies
+
+#endif  // CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_HIVEY_MEMORY_LIMIT_POLICY_H_
