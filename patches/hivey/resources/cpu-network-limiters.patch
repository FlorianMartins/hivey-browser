+#ifndef CHROME_BROWSER_HIVEY_HIVEY_RESOURCE_LIMITS_H_
+#define CHROME_BROWSER_HIVEY_HIVEY_RESOURCE_LIMITS_H_
+
+#include <map>
+#include <memory>
+
+#include "base/scoped_multi_source_observation.h"
+#include "base/unguessable_token.h"
+#include "build/build_config.h"
+#include "chrome/browser/chrome_browser_main_extra_parts.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/render_process_host_creation_observer.h"
+#include "content/public/browser/render_process_host_observer.h"
+
+#if BUILDFLAG(IS_WIN)
+#include "base/win/scoped_handle.h"
+#endif
+
+class PrefRegistrySimple;
+
+namespace hivey {
+
+// Local State prefs of the resource limiters (Hivey Studio > Resources).
+// CPU limit of each tab process, in percent of the whole machine (0 = off).
+inline constexpr char kCpuLimitPercent[] = "hivey.cpu_limit_percent";
+// Browser-wide network bandwidth limit, in kilobits per second (0 = off).
+inline constexpr char kNetworkLimitKbps[] = "hivey.network_limit_kbps";
+
+void RegisterResourceLimitsPrefs(PrefRegistrySimple* registry);
+
+// Whether this platform supports the CPU limiter (Windows: job objects).
+bool IsCpuLimiterSupported();
+
+// Applies the network limit from Local State to the network service. Called
+// when the pref changes and after the network service (re)starts.
+void ApplyNetworkLimit();
+
+// Hivey's GX-style resource limiters. The RAM limiter is a performance
+// manager policy (hivey_memory_limit_policy); this applies the other two:
+//  - CPU: each renderer (tab) process gets its own Windows job object with a
+//    hard CPU-rate cap, nested in its sandbox job. Changes apply live.
+//  - Network: one throttling profile in the network service shared by every
+//    request, see network::HiveyGlobalThrottlingProfileId().
+class ResourceLimits : public content::RenderProcessHostCreationObserver,
+                       public content::RenderProcessHostObserver {
+ public:
+  ResourceLimits();
+  ResourceLimits(const ResourceLimits&) = delete;
+  ResourceLimits& operator=(const ResourceLimits&) = delete;
+  ~ResourceLimits() override;
+
+  // content::RenderProcessHostCreationObserver:
+  void OnRenderProcessHostCreated(content::RenderProcessHost* host) override;
+
+  // content::RenderProcessHostObserver:
+  void RenderProcessReady(content::RenderProcessHost* host) override;
+  void RenderProcessExited(
+      content::RenderProcessHost* host,
+      const content::ChildProcessTerminationInfo& info) override;
+  void RenderProcessHostDestroyed(content::RenderProcessHost* host) override;
+
+ private:
+  void OnCpuLimitChanged();
+  void ApplyCpuLimit(content::RenderProcessHost* host);
+
+  PrefChangeRegistrar local_state_registrar_;
+  base::ScopedMultiSourceObservation<content::RenderProcessHost,
+                                     content::RenderProcessHostObserver>
+      observed_hosts_{this};
+#if BUILDFLAG(IS_WIN)
+  // Job object of each capped renderer, by RenderProcessHost ID.
+  std::map<int, base::win::ScopedHandle> jobs_;
+#endif
+};
+
+// Owns ResourceLimits for the lifetime of the browser's main loop.
+class ChromeBrowserMainExtraPartsHivey : public ChromeBrowserMainExtraParts {
+ public:
+  ChromeBrowserMainExtraPartsHivey();
+  ChromeBrowserMainExtraPartsHivey(const ChromeBrowserMainExtraPartsHivey&) =
+      delete;
+  ChromeBrowserMainExtraPartsHivey& operator=(
+      const ChromeBrowserMainExtraPartsHivey&) = delete;
+  ~ChromeBrowserMainExtraPartsHivey() override;
+
+  // ChromeBrowserMainExtraParts:
+  void PostBrowserStart() override;
+  void PostMainMessageLoopRun() override;
+
+ private:
+  std::unique_ptr<ResourceLimits> resource_limits_;
+};
+
+}  // namespace hivey
+
+#endif  // CHROME_BROWSER_HIVEY_HIVEY_RESOURCE_LIMITS_H_
