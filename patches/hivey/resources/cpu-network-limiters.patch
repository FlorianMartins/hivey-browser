+#ifndef SERVICES_NETWORK_PUBLIC_CPP_HIVEY_THROTTLING_H_
+#define SERVICES_NETWORK_PUBLIC_CPP_HIVEY_THROTTLING_H_
+
+#include "base/unguessable_token.h"
+
+namespace network {
+
+// Hivey: throttling profile of the browser-wide network limiter. Requests
+// that DevTools does not throttle use the conditions set for this profile
+// (NetworkContext::SetNetworkConditions), so one bandwidth budget is shared
+// by every tab and download.
+inline base::UnguessableToken HiveyGlobalThrottlingProfileId() {
+  return base::UnguessableToken::Deserialize(0x48697665794e6574ull,
+                                             0x4c696d6974657221ull)
+      .value();
+}
+
+}  // namespace network
+
+#endif  // SERVICES_NETWORK_PUBLIC_CPP_HIVEY_THROTTLING_H_
