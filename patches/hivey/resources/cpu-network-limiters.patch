+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#include "chrome/browser/hivey/hivey_resource_limits.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/time/time.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/net/system_network_context_manager.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/child_process_termination_info.h"
+#include "content/public/browser/render_process_host.h"
+#include "services/network/public/cpp/hivey_throttling.h"
+#include "services/network/public/mojom/network_context.mojom.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+#endif
+
+namespace hivey {
+
+namespace {
+
+// Identifies the browser as the client that set the limiter's conditions.
+base::UnguessableToken NetworkLimitClientId() {
+  return base::UnguessableToken::Deserialize(0x4869766579436c69ull,
+                                             0x656e740000000001ull)
+      .value();
+}
+
+#if BUILDFLAG(IS_WIN)
+int CpuLimitPercent() {
+  PrefService* local_state = g_browser_process->local_state();
+  return local_state ? local_state->GetInteger(kCpuLimitPercent) : 0;
+}
+
+// Sets (percent > 0) or removes the hard CPU-rate cap of a job object.
+// CpuRate is in hundredths of a percent of all the machine's processors.
+bool SetJobCpuRate(HANDLE job, int percent) {
+  JOBOBJECT_CPU_RATE_CONTROL_INFORMATION info = {};
+  if (percent > 0) {
+    info.ControlFlags =
+        JOB_OBJECT_CPU_RATE_CONTROL_ENABLE | JOB_OBJECT_CPU_RATE_CONTROL_HARD_CAP;
+    info.CpuRate = static_cast<DWORD>(percent) * 100;
+  }
+  return ::SetInformationJobObject(job, JobObjectCpuRateControlInformation,
+                                   &info, sizeof(info));
+}
+#endif
+
+}  // namespace
+
+void RegisterResourceLimitsPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterIntegerPref(kCpuLimitPercent, 0);
+  registry->RegisterIntegerPref(kNetworkLimitKbps, 0);
+}
+
+bool IsCpuLimiterSupported() {
+#if BUILDFLAG(IS_WIN)
+  return true;
+#else
+  return false;
+#endif
+}
+
+void ApplyNetworkLimit() {
+  PrefService* local_state = g_browser_process->local_state();
+  SystemNetworkContextManager* manager =
+      g_browser_process->system_network_context_manager();
+  if (!local_state || !manager) {
+    return;
+  }
+  const int kbps = local_state->GetInteger(kNetworkLimitKbps);
+  std::vector<network::mojom::MatchedNetworkConditionsPtr> conditions;
+  if (kbps > 0) {
+    auto limit = network::mojom::NetworkConditions::New();
+    limit->latency = base::TimeDelta();
+    // Bytes per second, shared by downloads and uploads of every tab.
+    limit->download_throughput = kbps * 1000.0 / 8;
+    limit->upload_throughput = limit->download_throughput;
+    // An empty pattern matches every URL.
+    conditions.push_back(network::mojom::MatchedNetworkConditions::New(
+        std::string(), std::move(limit)));
+  }
+  // No conditions removes the limit.
+  manager->GetContext()->SetNetworkConditions(
+      network::HiveyGlobalThrottlingProfileId(), NetworkLimitClientId(),
+      std::move(conditions));
+}
+
+ResourceLimits::ResourceLimits() {
+  if (PrefService* local_state = g_browser_process->local_state()) {
+    local_state_registrar_.Init(local_state);
+    local_state_registrar_.Add(
+        kCpuLimitPercent, base::BindRepeating(&ResourceLimits::OnCpuLimitChanged,
+                                              base::Unretained(this)));
+    local_state_registrar_.Add(kNetworkLimitKbps,
+                               base::BindRepeating(&ApplyNetworkLimit));
+  }
+  ApplyNetworkLimit();
+  // Tabs opened before this point (session restore) get the CPU limit too.
+  for (auto it = content::RenderProcessHost::AllHostsIterator(); !it.IsAtEnd();
+       it.Advance()) {
+    OnRenderProcessHostCreated(it.GetCurrentValue());
+    if (it.GetCurrentValue()->IsReady()) {
+      ApplyCpuLimit(it.GetCurrentValue());
+    }
+  }
+}
+
+ResourceLimits::~ResourceLimits() = default;
+
+void ResourceLimits::OnRenderProcessHostCreated(
+    content::RenderProcessHost* host) {
+  if (!observed_hosts_.IsObservingSource(host)) {
+    observed_hosts_.AddObservation(host);
+  }
+}
+
+void ResourceLimits::RenderProcessReady(content::RenderProcessHost* host) {
+  ApplyCpuLimit(host);
+}
+
+void ResourceLimits::RenderProcessExited(
+    content::RenderProcessHost* host,
+    const content::ChildProcessTerminationInfo& info) {
+#if BUILDFLAG(IS_WIN)
+  jobs_.erase(host->GetDeprecatedID());
+#endif
+}
+
+void ResourceLimits::RenderProcessHostDestroyed(
+    content::RenderProcessHost* host) {
+#if BUILDFLAG(IS_WIN)
+  jobs_.erase(host->GetDeprecatedID());
+#endif
+  observed_hosts_.RemoveObservation(host);
+}
+
+void ResourceLimits::OnCpuLimitChanged() {
+  for (auto it = content::RenderProcessHost::AllHostsIterator(); !it.IsAtEnd();
+       it.Advance()) {
+    if (it.GetCurrentValue()->IsReady()) {
+      ApplyCpuLimit(it.GetCurrentValue());
+    }
+  }
+}
+
+void ResourceLimits::ApplyCpuLimit(content::RenderProcessHost* host) {
+#if BUILDFLAG(IS_WIN)
+  const int percent = CpuLimitPercent();
+  auto it = jobs_.find(host->GetDeprecatedID());
+  if (it == jobs_.end()) {
+    if (percent <= 0) {
+      return;
+    }
+    const base::Process& process = host->GetProcess();
+    if (!process.IsValid()) {
+      return;
+    }
+    // A new, empty job can take a process that is already in a job (its
+    // sandbox job): it becomes nested in it (Windows 8 and later).
+    base::win::ScopedHandle job(::CreateJobObject(nullptr, nullptr));
+    if (!job.is_valid() || !::AssignProcessToJobObject(job.get(), process.Handle())) {
+      PLOG(WARNING) << "Hivey CPU limiter: cannot cap renderer process";
+      return;
+    }
+    it = jobs_.emplace(host->GetDeprecatedID(), std::move(job)).first;
+  }
+  if (!SetJobCpuRate(it->second.get(), percent)) {
+    PLOG(WARNING) << "Hivey CPU limiter: cannot set the CPU rate";
+  }
+#endif
+}
+
+ChromeBrowserMainExtraPartsHivey::ChromeBrowserMainExtraPartsHivey() = default;
+
+ChromeBrowserMainExtraPartsHivey::~ChromeBrowserMainExtraPartsHivey() =
+    default;
+
+void ChromeBrowserMainExtraPartsHivey::PostBrowserStart() {
+  resource_limits_ = std::make_unique<ResourceLimits>();
+}
+
+void ChromeBrowserMainExtraPartsHivey::PostMainMessageLoopRun() {
+  resource_limits_.reset();
+}
+
+}  // namespace hivey
