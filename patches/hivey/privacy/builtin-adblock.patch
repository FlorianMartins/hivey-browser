+// Hivey: the built-in blocker filters every site (EasyList + EasyPrivacy).
+// Priority 900: above the ad tagging dry run (500), so pages are enforced.
+Configuration MakePresetForHiveyLiveRunOnAllSites() {
+  Configuration config(mojom::ActivationLevel::kEnabled,
+                       ActivationScope::ALL_SITES);
+  config.activation_conditions.priority = 900;
+  return config;
+}
