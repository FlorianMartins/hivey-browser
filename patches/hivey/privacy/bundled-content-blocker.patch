+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_HIVEY_BUNDLED_EXTENSION_LOADER_H_
+#define CHROME_BROWSER_EXTENSIONS_HIVEY_BUNDLED_EXTENSION_LOADER_H_
+
+#include "base/values.h"
+#include "chrome/browser/extensions/external_loader.h"
+
+namespace extensions {
+
+// Hivey: installs the extensions that ship with the browser (uBlock Origin
+// Lite, as <module dir>/extensions/hivey-shield.crx). Only the extension ID
+// compiled into the browser is offered, and Chromium checks the .crx
+// signature against that ID, so files dropped into that folder cannot
+// install anything else. A user who removes the extension keeps it removed.
+class HiveyBundledExtensionLoader : public ExternalLoader {
+ public:
+  HiveyBundledExtensionLoader();
+  HiveyBundledExtensionLoader(const HiveyBundledExtensionLoader&) = delete;
+  HiveyBundledExtensionLoader& operator=(const HiveyBundledExtensionLoader&) =
+      delete;
+
+  // ExternalLoader:
+  void StartLoading() override;
+
+ private:
+  ~HiveyBundledExtensionLoader() override;
+
+  void OnPrefsBuilt(base::DictValue prefs);
+};
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_HIVEY_BUNDLED_EXTENSION_LOADER_H_
