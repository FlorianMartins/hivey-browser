+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#include "chrome/browser/extensions/hivey_bundled_extension_loader.h"
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/path_service.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/extensions/external_provider_impl.h"
+#include "chrome/browser/hivey/bundled_extensions.h"
+#include "chrome/common/chrome_paths.h"
+
+namespace extensions {
+
+namespace {
+
+// Runs on a blocking thread: looks for the bundled .crx next to the browser.
+base::DictValue BuildBundledExtensionPrefs() {
+  base::DictValue prefs;
+  base::FilePath dir;
+  if (!base::PathService::Get(chrome::DIR_EXTERNAL_EXTENSIONS, &dir)) {
+    return prefs;
+  }
+  const base::FilePath crx = dir.Append(HIVEY_BUNDLED_SHIELD_CRX);
+  if (!base::PathExists(crx)) {
+    return prefs;
+  }
+  prefs.Set(HIVEY_BUNDLED_SHIELD_ID,
+            base::DictValue()
+                .Set(ExternalProviderImpl::kExternalCrx, crx.AsUTF8Unsafe())
+                .Set(ExternalProviderImpl::kExternalVersion,
+                     HIVEY_BUNDLED_SHIELD_VERSION));
+  return prefs;
+}
+
+}  // namespace
+
+HiveyBundledExtensionLoader::HiveyBundledExtensionLoader() = default;
+
+HiveyBundledExtensionLoader::~HiveyBundledExtensionLoader() = default;
+
+void HiveyBundledExtensionLoader::StartLoading() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&BuildBundledExtensionPrefs),
+      base::BindOnce(&HiveyBundledExtensionLoader::OnPrefsBuilt, this));
+}
+
+void HiveyBundledExtensionLoader::OnPrefsBuilt(base::DictValue prefs) {
+  LoadFinished(std::move(prefs));
+}
+
+}  // namespace extensions
