+void ApplyFingerprintingNoise(base::span<float> samples) {
+  static const uint64_t seed = base::RandUint64();
+  for (size_t i = 0; i < samples.size(); ++i) {
+    // splitmix64 of (seed, i): uniform, cheap, deterministic per position.
+    uint64_t x = seed + (i + 1) * 0x9E3779B97F4A7C15ull;
+    x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ull;
+    x = (x ^ (x >> 27)) * 0x94D049BB133111EBull;
+    x ^= x >> 31;
+    const double unit = static_cast<double>(x >> 11) / 9007199254740992.0;
+    samples[i] = static_cast<float>(samples[i] * (1.0 + (unit - 0.5) * 2e-6));
