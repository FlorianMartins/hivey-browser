+
+#include "third_party/blink/renderer/platform/fonts/hivey_font_allowlist.h"
+
+#include <algorithm>
+#include <array>
+#include <string>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "third_party/blink/renderer/platform/weborigin/kurl.h"
+
+namespace blink {
+
+namespace {
+
+// Fonts installed by default with Windows 10/11 and with the usual Linux
+// desktops (Debian/Ubuntu, Fedora). Compared without case, spaces or
+// hyphens. Keep sorted.
+constexpr auto kAllowedFamilies = std::to_array<std::string_view>({
+    "arial",
+    "arialblack",
+    "bahnschrift",
+    "batang",
+    "calibri",
+    "cambria",
+    "cambriamath",
+    "candara",
+    "cantarell",
+    "cascadiacode",
+    "cascadiamono",
+    "comicsansms",
+    "consolas",
+    "constantia",
+    "corbel",
+    "couriernew",
+    "dejavusans",
+    "dejavusansmono",
+    "dejavuserif",
+    "dotum",
+    "droidsans",
+    "droidsansmono",
+    "droidserif",
+    "ebrima",
+    "fangsong",
+    "franklingothicmedium",
+    "freemono",
+    "freesans",
+    "freeserif",
+    "gabriola",
+    "gadugi",
+    "georgia",
+    "gulim",
+    "impact",
+    "inkfree",
+    "javanesetext",
+    "kaiti",
+    "leelawadeeui",
+    "liberationmono",
+    "liberationsans",
+    "liberationserif",
+    "lucidaconsole",
+    "lucidasansunicode",
+    "malgungothic",
+    "marlett",
+    "meiryo",
+    "microsofthimalaya",
+    "microsoftjhenghei",
+    "microsoftnewtailue",
+    "microsoftphagspa",
+    "microsoftsansserif",
+    "microsofttaile",
+    "microsoftyahei",
+    "microsoftyibaiti",
+    "mingliuextb",
+    "mongolianbaiti",
+    "msgothic",
+    "msuigothic",
+    "mvboli",
+    "myanmartext",
+    "nirmalaui",
+    "notocoloremoji",
+    "notomono",
+    "notosans",
+    "notosanscjk",
+    "notosansmono",
+    "notoserif",
+    "notoserifcjk",
+    "nsimsun",
+    "palatinolinotype",
+    "segoefluenticons",
+    "segoemdl2assets",
+    "segoeprint",
+    "segoescript",
+    "segoeui",
+    "segoeuiemoji",
+    "segoeuihistoric",
+    "segoeuisymbol",
+    "segoeuivariable",
+    "simhei",
+    "simsun",
+    "sitka",
+    "sylfaen",
+    "symbol",
+    "tahoma",
+    "timesnewroman",
+    "trebuchetms",
+    "ubuntu",
+    "ubuntumono",
+    "verdana",
+    "webdings",
+    "wingdings",
+    "yugothic",
+});
+static_assert(std::ranges::is_sorted(kAllowedFamilies));
+
+// Lower case, without spaces, hyphens and underscores.
+std::string Normalize(const AtomicString& name) {
+  std::string out;
+  const std::string utf8 = name.Utf8();
+  out.reserve(utf8.size());
+  for (char c : utf8) {
+    if (c == ' ' || c == '-' || c == '_') {
+      continue;
+    }
+    out.push_back(static_cast<char>(c >= 'A' && c <= 'Z' ? c - 'A' + 'a' : c));
+  }
+  return out;
+}
+
+bool Enabled() {
+  static const bool enabled = !base::CommandLine::ForCurrentProcess()->HasSwitch(
+      "disable-fingerprinting-noise");
+  return enabled;
+}
+
+}  // namespace
+
+// static
+bool HiveyFontAllowlist::AppliesTo(const KURL& url) {
+  return Enabled() && url.ProtocolIsInHttpFamily();
+}
+
+// static
+bool HiveyFontAllowlist::IsAllowedFamily(const AtomicString& family) {
+  return std::ranges::binary_search(kAllowedFamilies, Normalize(family));
+}
+
+// static
+bool HiveyFontAllowlist::IsAllowedLocalName(const AtomicString& name) {
+  // "arialboldmt" starts with "arial": allowed. Longer entries are checked
+  // too, so "Segoe UI Emoji" matches "segoeuiemoji" as well as "segoeui".
+  const std::string normalized = Normalize(name);
+  return std::ranges::any_of(kAllowedFamilies, [&](std::string_view family) {
+    return normalized.starts_with(family);
+  });
+}
+
+}  // namespace blink
