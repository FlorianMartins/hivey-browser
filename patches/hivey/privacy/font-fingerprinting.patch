+// the LICENSE file of the Hivey Browser repository.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_HIVEY_FONT_ALLOWLIST_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_HIVEY_FONT_ALLOWLIST_H_
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+#include "third_party/blink/renderer/platform/wtf/text/atomic_string.h"
+
+namespace blink {
+
+class KURL;
+
+// Hivey: font fingerprinting protection. Web pages can measure which fonts
+// are installed (by name in font-family, or with local() in @font-face) and
+// use the list to recognise a computer. Web pages served over http(s) only
+// see the fonts that ship with Windows and common Linux distributions; any
+// other installed font behaves as if it were missing. Web fonts, the
+// browser's own pages and the fallback fonts used to draw characters a font
+// lacks are not affected. --disable-fingerprinting-noise turns it off.
+class PLATFORM_EXPORT HiveyFontAllowlist {
+ public:
+  // Whether the protection applies to a document at `url`.
+  static bool AppliesTo(const KURL& url);
+
+  // A family name, as in font-family: "Segoe UI".
+  static bool IsAllowedFamily(const AtomicString& family);
+
+  // A full or PostScript name, as in local(): "Arial Bold", "Arial-BoldMT".
+  static bool IsAllowedLocalName(const AtomicString& name);
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_HIVEY_FONT_ALLOWLIST_H_
