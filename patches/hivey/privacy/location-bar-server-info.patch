+// What the location bar tells about the server a page was loaded from.
+struct ServerInfo {
+  ServerInfo();
+  ServerInfo(const ServerInfo&);
+  ServerInfo& operator=(const ServerInfo&);
+  ~ServerInfo();
+
+  // The committed URL of the page.
+  GURL url;
+  // The remote address of the socket that fetched the page. Through a proxy,
+  // that is the proxy's address.
+  net::IPAddress address;
+  // True until the country lookup has replied.
+  bool lookup_pending = false;
+  // ISO 3166 code of the country of `address` ("US"), or empty: unknown, not
+  // publicly routable, or `via_proxy`.
+  std::string country_code;
+  // The address is not publicly routable (LAN, loopback...).
+  bool is_local = false;
+  // The page was fetched through a proxy: `address` and the country are the
+  // proxy's, not the server's.
+  bool via_proxy = false;
+  // HTTPS (or another cryptographic scheme).
+  bool is_secure = false;
+  // ALPN protocol ("h2", "http/1.1", "h3"...), or empty.
+  std::string protocol;
+  // "TLS 1.3"..., or empty.
+  std::string tls_version;
+};
+
+// Per tab: the server of the page shown, for the location bar's server chip
+// (Flagfox-like). Only uses what the navigation already knows (the socket's
+// remote address, the connection, the proxy chain) and the database shipped
+// with the browser (HiveyGeoIp): it never sends anything, never stores
+// anything. The info is kept per document, so going back to a page restored
+// from the back/forward cache shows its server again.
+class HiveyServerInfo : public content::WebContentsObserver,
+                        public content::WebContentsUserData<HiveyServerInfo> {
+ public:
+  HiveyServerInfo(const HiveyServerInfo&) = delete;
+  HiveyServerInfo& operator=(const HiveyServerInfo&) = delete;
+  ~HiveyServerInfo() override;
+
+  // The server of the page in the primary main frame, or nullptr when there
+  // is nothing to show (internal page, file, error page, unknown address).
+  const ServerInfo* GetInfo() const;
+
+  // `callback` runs whenever GetInfo() may have changed.
+  base::CallbackListSubscription RegisterInfoChangedCallback(
+      base::RepeatingClosure callback);
+
+ private:
+  friend class content::WebContentsUserData<HiveyServerInfo>;
+
+  explicit HiveyServerInfo(content::WebContents* web_contents);
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(
+      content::NavigationHandle* navigation_handle) override;
+  void ResourceLoadComplete(
+      content::RenderFrameHost* render_frame_host,
+      const content::GlobalRequestID& request_id,
+      const GURL& original_url,
+      const blink::mojom::ResourceLoadInfo& resource_load_info) override;
+  void PrimaryPageChanged(content::Page& page) override;
+
+  void OnCountryLookedUp(const content::WeakDocumentPtr& document,
+                         std::string country_code);
+  void NotifyIfPrimary(content::RenderFrameHost* render_frame_host);
+
+  base::RepeatingClosureList callbacks_;
+  base::WeakPtrFactory<HiveyServerInfo> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace hivey
