+++ b/chrome/browser/hivey/hivey_geoip.h
@@ -0,0 +1,83 @@
+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#ifndef CHROME_BROWSER_HIVEY_HIVEY_GEOIP_H_
+#define CHROME_BROWSER_HIVEY_HIVEY_GEOIP_H_
+
+#include <memory>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/no_destructor.h"
+#include "base/threading/sequence_bound.h"
+
+namespace base {
+class MemoryMappedFile;
+}
+
+namespace net {
+class IPAddress;
+}
+
+namespace hivey {
+
+// Offline IP-to-country lookup, from the database that ships next to the
+// browser (<module dir>/extensions/hivey_geoip.bin, written by
+// scripts/geoip.py from db-ip.com's "IP to Country Lite", CC BY 4.0). Nothing
+// is ever sent over the network: the file is memory-mapped once, on a
+// background sequence, and searched there.
+class HiveyGeoIp {
+ public:
+  // The 2-letter ISO 3166 code of the country, in upper case, or an empty
+  // string when the address is not in the database (unassigned or reserved
+  // range, or the database is missing or invalid).
+  using LookupCallback = base::OnceCallback<void(std::string country_code)>;
+
+  // The file name, in chrome::DIR_EXTERNAL_EXTENSIONS.
+  static constexpr char kFileName[] = "hivey_geoip.bin";
+
+  static HiveyGeoIp* GetInstance();
+
+  HiveyGeoIp(const HiveyGeoIp&) = delete;
+  HiveyGeoIp& operator=(const HiveyGeoIp&) = delete;
+
+  // Looks `address` up; replies on the calling sequence. IPv4-mapped IPv6
+  // addresses are looked up as IPv4.
+  void Lookup(const net::IPAddress& address, LookupCallback callback);
+
+  // The database, on its own sequence. Public for tests.
+  class Database {
+   public:
+    // Maps `path` lazily, on the first lookup. An empty path means the default
+    // location.
+    explicit Database(base::FilePath path);
+    Database(const Database&) = delete;
+    Database& operator=(const Database&) = delete;
+    ~Database();
+
+    std::string Lookup(const net::IPAddress& address);
+
+   private:
+    bool EnsureLoaded();
+
+    base::FilePath path_;
+    bool load_attempted_ = false;
+    std::unique_ptr<base::MemoryMappedFile> file_;
+    size_t v4_count_ = 0;
+    size_t v6_count_ = 0;
+  };
+
+ private:
+  friend class base::NoDestructor<HiveyGeoIp>;
+
+  HiveyGeoIp();
+  ~HiveyGeoIp();
+
+  base::SequenceBound<Database> database_;
+};
+
+}  // namespace hivey
+
+#endif  // CHROME_BROWSER_HIVEY_HIVEY_GEOIP_H_
