+// Lookups on these sites only happen when the user clicks their link.
+constexpr char kWhoisUrl[] = "https://www.whois.com/whois/";
+constexpr char kIpDetailsUrl[] = "https://ipinfo.io/";
+// Attribution required by the license (CC BY 4.0) of the database.
+constexpr char kDbIpUrl[] = "https://db-ip.com/";
+
+std::u16string CountryName(const hivey::ServerInfo& info) {
+  if (info.via_proxy) {
+    return l10n_util::GetStringUTF16(IDS_HIVEY_SERVER_INFO_VIA_PROXY);
+  }
+  if (info.is_local) {
+    return l10n_util::GetStringUTF16(IDS_HIVEY_SERVER_INFO_LOCAL);
+  }
+  if (info.country_code.empty()) {
+    return l10n_util::GetStringUTF16(IDS_HIVEY_SERVER_INFO_UNKNOWN);
+  }
+  std::u16string name = l10n_util::GetDisplayNameForCountry(
+      info.country_code, g_browser_process->GetApplicationLocale());
+  return name.empty() ? base::ASCIIToUTF16(info.country_code) : name;
+}
+
+std::u16string ConnectionText(const hivey::ServerInfo& info) {
+  std::vector<std::u16string> parts = {l10n_util::GetStringUTF16(
+      info.is_secure ? IDS_HIVEY_SERVER_INFO_SECURE
+                     : IDS_HIVEY_SERVER_INFO_NOT_SECURE)};
+  if (!info.protocol.empty()) {
+    parts.push_back(base::ASCIIToUTF16(info.protocol));
+  }
+  if (!info.tls_version.empty()) {
+    parts.push_back(base::ASCIIToUTF16(info.tls_version));
+  }
+  return base::JoinString(parts, u" · ");
+}
+
+std::u16string Tooltip(const hivey::ServerInfo& info) {
+  return l10n_util::GetStringFUTF16(IDS_HIVEY_SERVER_INFO_TOOLTIP,
+                                    CountryName(info),
+                                    base::ASCIIToUTF16(info.address.ToString()));
+}
