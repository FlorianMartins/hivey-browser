+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#include "chrome/browser/hivey/hivey_geoip.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/files/memory_mapped_file.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/numerics/checked_math.h"
+#include "base/path_service.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "chrome/common/chrome_paths.h"
+#include "net/base/ip_address.h"
+
+namespace hivey {
+
+namespace {
+
+// See scripts/geoip.py for the file format.
+constexpr char kMagic[] = "HIVEYGEO";
+constexpr size_t kMagicSize = 8;
+constexpr uint16_t kVersion = 1;
+constexpr size_t kHeaderSize = 24;
+constexpr size_t kV4EntrySize = 4 + 2;
+constexpr size_t kV6EntrySize = 16 + 2;
+
+// Index of the last entry whose start is <= `address`, in a table of
+// `count` entries of `entry_size` bytes starting with a big-endian address of
+// `address.size()` bytes. The first entry starts at 0, so there is always one.
+size_t FindEntry(base::span<const uint8_t> table,
+                 size_t count,
+                 size_t entry_size,
+                 base::span<const uint8_t> address) {
+  size_t lo = 0;
+  size_t hi = count;
+  while (hi - lo > 1) {
+    const size_t mid = lo + (hi - lo) / 2;
+    base::span<const uint8_t> start =
+        table.subspan(mid * entry_size, address.size());
+    if (std::ranges::lexicographical_compare(address, start)) {
+      hi = mid;  // address < start
+    } else {
+      lo = mid;
+    }
+  }
+  return lo;
+}
+
+}  // namespace
+
+HiveyGeoIp::Database::Database(base::FilePath path) : path_(std::move(path)) {}
+
+HiveyGeoIp::Database::~Database() = default;
+
+bool HiveyGeoIp::Database::EnsureLoaded() {
+  if (load_attempted_) {
+    return !!file_;
+  }
+  load_attempted_ = true;
+  if (path_.empty()) {
+    base::FilePath dir;
+    if (!base::PathService::Get(chrome::DIR_EXTERNAL_EXTENSIONS, &dir)) {
+      return false;
+    }
+    path_ = dir.AppendASCII(kFileName);
+  }
+  auto file = std::make_unique<base::MemoryMappedFile>();
+  if (!file->Initialize(path_)) {
+    VLOG(1) << "Hivey: no IP-to-country database at " << path_;
+    return false;
+  }
+  base::span<const uint8_t> bytes = file->bytes();
+  if (bytes.size() < kHeaderSize ||
+      bytes.first<kMagicSize>() != base::byte_span_from_cstring(kMagic) ||
+      base::U16FromBigEndian(bytes.subspan<8, 2>()) != kVersion) {
+    LOG(WARNING) << "Hivey: invalid IP-to-country database " << path_;
+    return false;
+  }
+  const size_t v4_count = base::U32FromBigEndian(bytes.subspan<12, 4>());
+  const size_t v6_count = base::U32FromBigEndian(bytes.subspan<16, 4>());
+  base::CheckedNumeric<size_t> expected_size = kHeaderSize;
+  expected_size += base::CheckMul(v4_count, kV4EntrySize);
+  expected_size += base::CheckMul(v6_count, kV6EntrySize);
+  if (!expected_size.IsValid() || expected_size.ValueOrDie() != bytes.size() ||
+      !v4_count || !v6_count) {
+    LOG(WARNING) << "Hivey: truncated IP-to-country database " << path_;
+    return false;
+  }
+  v4_count_ = v4_count;
+  v6_count_ = v6_count;
+  file_ = std::move(file);
+  return true;
+}
+
+std::string HiveyGeoIp::Database::Lookup(const net::IPAddress& address) {
+  const net::IPAddress ip = address.IsIPv4MappedIPv6()
+                                ? net::ConvertIPv4MappedIPv6ToIPv4(address)
+                                : address;
+  if (!ip.IsValid() || !EnsureLoaded()) {
+    return std::string();
+  }
+  base::span<const uint8_t> tables = file_->bytes().subspan(kHeaderSize);
+  const bool is_v4 = ip.IsIPv4();
+  const size_t entry_size = is_v4 ? kV4EntrySize : kV6EntrySize;
+  const size_t count = is_v4 ? v4_count_ : v6_count_;
+  base::span<const uint8_t> table =
+      is_v4 ? tables.first(v4_count_ * kV4EntrySize)
+            : tables.subspan(v4_count_ * kV4EntrySize);
+  const size_t index = FindEntry(table, count, entry_size, ip.bytes().span());
+  base::span<const uint8_t> code =
+      table.subspan(index * entry_size + ip.size(), 2u);
+  if (!base::IsAsciiAlpha(code[0]) || !base::IsAsciiAlpha(code[1])) {
+    return std::string();  // "--": unassigned or reserved.
+  }
+  return base::ToUpperASCII(std::string(code.begin(), code.end()));
+}
+
+// static
+HiveyGeoIp* HiveyGeoIp::GetInstance() {
+  static base::NoDestructor<HiveyGeoIp> instance;
+  return instance.get();
+}
+
+HiveyGeoIp::HiveyGeoIp()
+    : database_(base::ThreadPool::CreateSequencedTaskRunner(
+                    {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+                     base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN}),
+                base::FilePath()) {}
+
+HiveyGeoIp::~HiveyGeoIp() = default;
+
+void HiveyGeoIp::Lookup(const net::IPAddress& address,
+                        LookupCallback callback) {
+  database_.AsyncCall(&Database::Lookup)
+      .WithArgs(address)
+      .Then(std::move(callback));
+}
+
+}  // namespace hivey
