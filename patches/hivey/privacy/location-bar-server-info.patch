+HiveyServerInfoView::~HiveyServerInfoView() = default;
+
+// static
+std::u16string HiveyServerInfoView::FlagEmoji(const std::string& country_code) {
+  std::u16string flag;
+  if (country_code.size() != 2 || !base::IsAsciiAlpha(country_code[0]) ||
+      !base::IsAsciiAlpha(country_code[1])) {
+    return flag;
+  }
+  for (char c : country_code) {
+    // U+1F1E6 REGIONAL INDICATOR SYMBOL LETTER A, then B...
+    base::WriteUnicodeCharacter(0x1F1E6 + (base::ToUpperASCII(c) - 'A'),
+                                &flag);
+  }
+  return flag;
+}
+
+void HiveyServerInfoView::Update(content::WebContents* web_contents,
+                                 bool force_hidden) {
+  force_hidden_ = force_hidden;
+  if (web_contents != web_contents_.get()) {
+    web_contents_ = web_contents ? web_contents->GetWeakPtr() : nullptr;
+    info_subscription_ = {};
+    if (web_contents) {
+      // Created by TabHelpers for every tab; GetOrCreate covers the others.
+      info_subscription_ =
+          hivey::HiveyServerInfo::GetOrCreateForWebContents(web_contents)
+              ->RegisterInfoChangedCallback(base::BindRepeating(
+                  &HiveyServerInfoView::Refresh, base::Unretained(this)));
+    }
+  }
+  Refresh();
+}
+
+bool HiveyServerInfoView::ShowBubble(const ui::Event& event) {
+  if (IsBubbleShowing() || !web_contents_) {
+    return false;
+  }
+  const hivey::HiveyServerInfo* server_info =
+      hivey::HiveyServerInfo::FromWebContents(web_contents_.get());
+  const hivey::ServerInfo* info =
+      server_info ? server_info->GetInfo() : nullptr;
+  if (!info) {
+    return false;
+  }
+  auto bubble = std::make_unique<HiveyServerInfoBubbleView>(
+      this, web_contents_.get(), *info);
+  bubble_tracker_.SetView(bubble.get());
+  views::Widget* widget =
+      views::BubbleDialogDelegateView::CreateBubble(std::move(bubble));
+  widget->Show();
+  return true;
+}
+
+bool HiveyServerInfoView::IsBubbleShowing() const {
+  return bubble_tracker_.view() != nullptr;
+}
+
+void HiveyServerInfoView::Refresh() {
+  const hivey::HiveyServerInfo* server_info =
+      web_contents_ ? hivey::HiveyServerInfo::FromWebContents(
+                          web_contents_.get())
+                    : nullptr;
+  const hivey::ServerInfo* info =
+      server_info ? server_info->GetInfo() : nullptr;
+  // Wait for the lookup (a few milliseconds) rather than flash a globe.
+  const bool visible = !force_hidden_ && info && !info->lookup_pending;
+  if (visible) {
+    std::u16string text;
+    if (info->via_proxy) {
+      text = l10n_util::GetStringUTF16(IDS_HIVEY_SERVER_INFO_VIA_PROXY);
+    } else if (!info->country_code.empty()) {
+#if BUILDFLAG(IS_WIN)
+      // Windows' emoji font has no flags: the letters would show in boxes.
+      text = base::ASCIIToUTF16(info->country_code);
+#else
+      text = FlagEmoji(info->country_code) + u" " +
+             base::ASCIIToUTF16(info->country_code);
+#endif
+    }
+    const std::u16string tooltip = Tooltip(*info);
+    if (text != label()->GetText() || tooltip != tooltip_) {
+      tooltip_ = tooltip;
+      SetLabel(text, tooltip);
+      SetTooltipText(tooltip);
+      PreferredSizeChanged();
+    }
+  }
+  if (visible != GetVisible()) {
+    SetVisible(visible);
+    PreferredSizeChanged();
+  }
+}
