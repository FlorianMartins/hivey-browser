@@ -0,0 +1,202 @@
+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#include "chrome/browser/hivey/hivey_server_info.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/hivey/hivey_geoip.h"
+#include "content/public/browser/document_user_data.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/ip_endpoint.h"
+#include "net/base/proxy_chain.h"
+#include "net/http/http_connection_info.h"
+#include "net/ssl/ssl_cipher_suite_names.h"
+#include "net/ssl/ssl_connection_status_flags.h"
+#include "net/ssl/ssl_info.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "third_party/blink/public/mojom/loader/resource_load_info.mojom.h"
+
+namespace hivey {
+
+namespace {
+
+// The server info of one document (the main frame of a page), so it follows
+// the page into and out of the back/forward cache and through prerendering.
+class DocumentServerInfo
+    : public content::DocumentUserData<DocumentServerInfo> {
+ public:
+  ~DocumentServerInfo() override = default;
+
+  ServerInfo& info() { return info_; }
+
+ private:
+  friend class content::DocumentUserData<DocumentServerInfo>;
+
+  DocumentServerInfo(content::RenderFrameHost* render_frame_host,
+                     ServerInfo info)
+      : DocumentUserData(render_frame_host), info_(std::move(info)) {}
+
+  ServerInfo info_;
+
+  DOCUMENT_USER_DATA_KEY_DECL();
+};
+
+DOCUMENT_USER_DATA_KEY_IMPL(DocumentServerInfo);
+
+std::string TlsVersion(const net::SSLInfo& ssl_info) {
+  const int version =
+      net::SSLConnectionStatusToVersion(ssl_info.connection_status);
+  if (version == net::SSL_CONNECTION_VERSION_UNKNOWN) {
+    return std::string();
+  }
+  const char* name = nullptr;
+  net::SSLVersionToString(&name, version);
+  return name ? name : std::string();
+}
+
+}  // namespace
+
+ServerInfo::ServerInfo() = default;
+ServerInfo::ServerInfo(const ServerInfo&) = default;
+ServerInfo& ServerInfo::operator=(const ServerInfo&) = default;
+ServerInfo::~ServerInfo() = default;
+
+HiveyServerInfo::HiveyServerInfo(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<HiveyServerInfo>(*web_contents) {}
+
+HiveyServerInfo::~HiveyServerInfo() = default;
+
+const ServerInfo* HiveyServerInfo::GetInfo() const {
+  auto* document = DocumentServerInfo::GetForCurrentDocument(
+      web_contents()->GetPrimaryMainFrame());
+  return document ? &document->info() : nullptr;
+}
+
+base::CallbackListSubscription HiveyServerInfo::RegisterInfoChangedCallback(
+    base::RepeatingClosure callback) {
+  return callbacks_.Add(std::move(callback));
+}
+
+void HiveyServerInfo::DidFinishNavigation(
+    content::NavigationHandle* navigation_handle) {
+  // The outermost main frame: the primary page, or a page being prerendered
+  // (whose info is then ready when it is activated). Back/forward cache
+  // restores and prerender activations keep the info of their document.
+  if (!navigation_handle->IsInOutermostMainFrame() ||
+      !navigation_handle->HasCommitted() ||
+      navigation_handle->IsSameDocument() ||
+      navigation_handle->IsServedFromBackForwardCache() ||
+      navigation_handle->IsPrerenderedPageActivation()) {
+    return;
+  }
+  content::RenderFrameHost* render_frame_host =
+      navigation_handle->GetRenderFrameHost();
+  const GURL& url = navigation_handle->GetURL();
+  const net::IPAddress address =
+      navigation_handle->GetSocketAddress().address();
+  if (!render_frame_host || navigation_handle->IsErrorPage() ||
+      !url.SchemeIsHTTPOrHTTPS() || !address.IsValid()) {
+    NotifyIfPrimary(render_frame_host);
+    return;
+  }
+
+  ServerInfo info;
+  info.url = url;
+  info.address = address;
+  info.is_secure = url.SchemeIsCryptographic();
+  if (navigation_handle->GetConnectionInfo() !=
+      net::HttpConnectionInfo::kUNKNOWN) {
+    info.protocol = std::string(
+        net::HttpConnectionInfoToString(navigation_handle->GetConnectionInfo()));
+  }
+  if (const std::optional<net::SSLInfo>& ssl_info =
+          navigation_handle->GetSSLInfo();
+      ssl_info && ssl_info->is_valid()) {
+    info.tls_version = TlsVersion(*ssl_info);
+  }
+  const net::IPAddress public_address =
+      address.IsIPv4MappedIPv6() ? net::ConvertIPv4MappedIPv6ToIPv4(address)
+                                 : address;
+  const bool is_local = !public_address.IsPubliclyRoutable();
+  info.is_local = is_local;
+  info.lookup_pending = !is_local;
+  DocumentServerInfo::CreateForCurrentDocument(render_frame_host,
+                                               std::move(info));
+  if (!is_local) {
+    HiveyGeoIp::GetInstance()->Lookup(
+        public_address,
+        base::BindOnce(&HiveyServerInfo::OnCountryLookedUp,
+                       weak_factory_.GetWeakPtr(),
+                       render_frame_host->GetWeakDocumentPtr()));
+  }
+  NotifyIfPrimary(render_frame_host);
+}
+
+void HiveyServerInfo::ResourceLoadComplete(
+    content::RenderFrameHost* render_frame_host,
+    const content::GlobalRequestID& request_id,
+    const GURL& original_url,
+    const blink::mojom::ResourceLoadInfo& resource_load_info) {
+  // The navigation does not expose its proxy chain; the load info of the main
+  // resource of the document does, once its body has loaded.
+  if (!render_frame_host || render_frame_host->GetParentOrOuterDocument() ||
+      resource_load_info.request_destination !=
+          network::mojom::RequestDestination::kDocument ||
+      !resource_load_info.proxy_chain.IsValid() ||
+      resource_load_info.proxy_chain.is_direct()) {
+    return;
+  }
+  auto* document =
+      DocumentServerInfo::GetForCurrentDocument(render_frame_host);
+  if (!document || document->info().via_proxy ||
+      document->info().url != resource_load_info.final_url) {
+    return;
+  }
+  document->info().via_proxy = true;
+  document->info().country_code.clear();
+  NotifyIfPrimary(render_frame_host);
+}
+
+void HiveyServerInfo::PrimaryPageChanged(content::Page& page) {
+  callbacks_.Notify();
+}
+
+void HiveyServerInfo::OnCountryLookedUp(
+    const content::WeakDocumentPtr& document_ptr,
+    std::string country_code) {
+  content::RenderFrameHost* render_frame_host =
+      document_ptr.AsRenderFrameHostIfValid();
+  if (!render_frame_host) {
+    return;
+  }
+  auto* document =
+      DocumentServerInfo::GetForCurrentDocument(render_frame_host);
+  if (!document) {
+    return;
+  }
+  document->info().lookup_pending = false;
+  if (!document->info().via_proxy) {
+    document->info().country_code = std::move(country_code);
+  }
+  NotifyIfPrimary(render_frame_host);
+}
+
+void HiveyServerInfo::NotifyIfPrimary(
+    content::RenderFrameHost* render_frame_host) {
+  if (!render_frame_host ||
+      render_frame_host == web_contents()->GetPrimaryMainFrame()) {
+    callbacks_.Notify();
+  }
+}
