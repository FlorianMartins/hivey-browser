+HiveyServerInfoView::HiveyServerInfoView(
+    IconLabelBubbleView::Delegate* parent_delegate,
+    const gfx::FontList& font_list)
+    : IconLabelBubbleView(font_list, parent_delegate) {
+  SetVisible(false);
+  SetImageModel(ui::ImageModel::FromVectorIcon(
+      features::IsRoundedIconsEnabled() ? kGlobeIcon : kGlobeOldIcon,
+      kColorOmniboxResultsIcon,
+      GetLayoutConstant(LayoutConstant::kLocationBarTrailingIconSize)));
+  label()->SetElideBehavior(gfx::NO_ELIDE);
+}
