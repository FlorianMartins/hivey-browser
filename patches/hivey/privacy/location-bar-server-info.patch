+// The bubble shown when the chip is clicked.
+class HiveyServerInfoBubbleView : public LocationBarBubbleDelegateView {
+  METADATA_HEADER(HiveyServerInfoBubbleView, LocationBarBubbleDelegateView)
+
+ public:
+  HiveyServerInfoBubbleView(views::View* anchor,
+                            content::WebContents* web_contents,
+                            const hivey::ServerInfo& info)
+      : LocationBarBubbleDelegateView(anchor, web_contents) {
+    SetArrow(views::BubbleBorder::TOP_RIGHT);
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    SetTitle(IDS_HIVEY_SERVER_INFO_TITLE);
+    SetShowCloseButton(true);
+    SetCloseOnMainFrameOriginNavigation(true);
+
+    const views::LayoutProvider* provider = views::LayoutProvider::Get();
+    set_fixed_width(
+        provider->GetDistanceMetric(views::DISTANCE_BUBBLE_PREFERRED_WIDTH));
+    const int vertical_spacing = provider->GetDistanceMetric(
+        views::DISTANCE_UNRELATED_CONTROL_VERTICAL);
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+        vertical_spacing));
+
+    // IP address, country, connection.
+    auto* table = AddChildView(std::make_unique<views::View>());
+    auto& layout = table->SetLayoutManager(std::make_unique<views::TableLayout>())
+                       ->AddColumn(views::LayoutAlignment::kStart,
+                                   views::LayoutAlignment::kStart,
+                                   views::TableLayout::kFixedSize,
+                                   views::TableLayout::ColumnSize::kUsePreferred,
+                                   0, 0)
+                       .AddPaddingColumn(
+                           views::TableLayout::kFixedSize,
+                           provider->GetDistanceMetric(
+                               views::DISTANCE_RELATED_CONTROL_HORIZONTAL))
+                       .AddColumn(views::LayoutAlignment::kStretch,
+                                  views::LayoutAlignment::kStart, 1.0f,
+                                  views::TableLayout::ColumnSize::kUsePreferred,
+                                  0, 0);
+    const int row_spacing =
+        provider->GetDistanceMetric(views::DISTANCE_RELATED_CONTROL_VERTICAL);
+    auto add_row = [&](int name_id, const std::u16string& value,
+                       bool selectable) {
+      if (table->children().size()) {
+        layout.AddPaddingRow(views::TableLayout::kFixedSize, row_spacing);
+      }
+      layout.AddRows(1, views::TableLayout::kFixedSize);
+      table->AddChildView(std::make_unique<views::Label>(
+          l10n_util::GetStringUTF16(name_id),
+          views::style::CONTEXT_DIALOG_BODY_TEXT,
+          views::style::STYLE_SECONDARY));
+      auto* label = table->AddChildView(std::make_unique<views::Label>(
+          value, views::style::CONTEXT_DIALOG_BODY_TEXT));
+      label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      label->SetSelectable(selectable);
+    };
+    add_row(IDS_HIVEY_SERVER_INFO_ADDRESS,
+            base::ASCIIToUTF16(info.address.ToString()), /*selectable=*/true);
+    std::u16string country = CountryName(info);
+    if (!info.via_proxy && !info.country_code.empty()) {
+      country = HiveyServerInfoView::FlagEmoji(info.country_code) + u" " +
+                country + u" (" + base::ASCIIToUTF16(info.country_code) + u")";
+    }
+    add_row(IDS_HIVEY_SERVER_INFO_COUNTRY, country, /*selectable=*/false);
+    add_row(IDS_HIVEY_SERVER_INFO_CONNECTION, ConnectionText(info),
+            /*selectable=*/false);
+
+    if (info.via_proxy) {
+      AddNote(IDS_HIVEY_SERVER_INFO_PROXY_NOTE);
+    }
+
+    // Links to lookup sites: nothing is sent unless the user clicks one.
+    auto* links = AddChildView(std::make_unique<views::View>());
+    links->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+        provider->GetDistanceMetric(
+            views::DISTANCE_RELATED_CONTROL_HORIZONTAL)));
+    std::string domain = net::registry_controlled_domains::GetDomainAndRegistry(
+        info.url,
+        net::registry_controlled_domains::EXCLUDE_PRIVATE_REGISTRIES);
+    if (domain.empty()) {
+      domain = info.url.HostNoBrackets();  // IP address or single-label host.
+    }
+    AddLink(links, l10n_util::GetStringUTF16(IDS_HIVEY_SERVER_INFO_WHOIS),
+            GURL(kWhoisUrl + domain));
+    AddLink(links, l10n_util::GetStringUTF16(IDS_HIVEY_SERVER_INFO_IP_DETAILS),
+            GURL(kIpDetailsUrl + info.address.ToString()));
+    AddNote(IDS_HIVEY_SERVER_INFO_LINKS_NOTE);
+    AddLink(this, l10n_util::GetStringUTF16(IDS_HIVEY_SERVER_INFO_ATTRIBUTION),
+            GURL(kDbIpUrl))
+        ->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  }
+  HiveyServerInfoBubbleView(const HiveyServerInfoBubbleView&) = delete;
+  HiveyServerInfoBubbleView& operator=(const HiveyServerInfoBubbleView&) =
+      delete;
+  ~HiveyServerInfoBubbleView() override = default;
+
+ private:
+  void AddNote(int message_id) {
+    auto* note = AddChildView(std::make_unique<views::Label>(
+        l10n_util::GetStringUTF16(message_id),
+        views::style::CONTEXT_DIALOG_BODY_TEXT, views::style::STYLE_HINT));
+    note->SetMultiLine(true);
+    note->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  }
+
+  views::Link* AddLink(views::View* parent,
+                       const std::u16string& text,
+                       const GURL& url) {
+    auto* link = parent->AddChildView(std::make_unique<views::Link>(
+        text, views::style::CONTEXT_DIALOG_BODY_TEXT));
+    link->SetCallback(base::BindRepeating(
+        &HiveyServerInfoBubbleView::OpenInNewTab, base::Unretained(this), url));
+    return link;
+  }
+
+  void OpenInNewTab(const GURL& url) {
+    if (!url.is_valid() || !web_contents()) {
+      return;
+    }
+    // No referrer: the site only gets what is in its URL.
+    web_contents()->OpenURL(
+        content::OpenURLParams(url, content::Referrer(),
+                               WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                               ui::PAGE_TRANSITION_LINK,
+                               /*is_renderer_initiated=*/false),
+        /*navigation_handle_callback=*/{});
+    GetWidget()->Close();
+  }
+};
