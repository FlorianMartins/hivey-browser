+// 80, 72 and 50 units wide, 14 high, 7 apart (tops at y = 9, 30, 51, 72).
+constexpr float kLogoUnits = 96;
+constexpr float kBarHeight = 14;
+constexpr float kBarGap = 7;
+constexpr float kBarWidths[] = {62, 80, 72, 50};
+
+// Draws the mark in the accent color with every bar edge on a whole pixel
+// (whole height, gap and top, and a width of the image's parity so each bar
+// stays centered), so it is crisp down to 16 px. Same rules as
+// scripts/branding.py, which renders the static icons.
 class ThemedLogoSource : public gfx::CanvasImageSource {
  public:
   ThemedLogoSource(SkColor accent, int size)
       : gfx::CanvasImageSource(gfx::Size(size, size)), accent_(accent) {}
 
