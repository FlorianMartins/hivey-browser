-    const float scale = size().width() / 256.f;
-    canvas->sk_canvas()->scale(scale, scale);
+    const int size = this->size().width();
+    const float scale = size / kLogoUnits;
+    const int height = std::max(3, base::ClampRound(kBarHeight * scale));
+    const int gap = std::max(1, base::ClampRound(kBarGap * scale));
+    const int bars = static_cast<int>(std::size(kBarWidths));
+    const int top = (size - (bars * height + (bars - 1) * gap) + 1) / 2;
+
+    SkPathBuilder builder;
+    for (int i = 0; i < bars; ++i) {
+      const float width = kBarWidths[i] * scale;
+      // Rounded half down, so bars of different widths stay different.
+      const int snapped = size % 2 == 0
+                              ? 2 * base::ClampCeil(width / 2 - 0.5f)
+                              : 2 * base::ClampCeil((width - 1) / 2 - 0.5f) + 1;
+      const int bar_width = std::min(snapped, size);
+      const SkRect bar =
+          SkRect::MakeXYWH((size - bar_width) / 2.f, top + i * (height + gap),
+                           bar_width, height);
+      builder.addRRect(SkRRect::MakeRectXY(bar, height / 2.f, height / 2.f));
+    }
 
