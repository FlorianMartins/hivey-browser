+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#include "chrome/browser/hivey/hivey_colors.h"
+
+#include <initializer_list>
+#include <string>
+
+#include "base/containers/span.h"
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_provider_manager.h"
+#include "ui/color/color_recipe.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/native_theme/native_theme.h"
+
+namespace hivey {
+
+namespace {
+
+struct ColorEntry {
+  const char* element;
+  const char* hex;
+};
+
+// Aura is the Hivey AI sidebar's look: deep ink, indigo accent.
+constexpr ColorEntry kAura[] = {
+    {"frame", "#0b0c14"},
+    {"toolbar", "#151726"},
+    {"tab_inactive", "#0b0c14"},
+    {"tab_text", "#f4f2fc"},
+    {"omnibox", "#1f2236"},
+    {"omnibox_text", "#ece9fb"},
+    {"icons", "#c4c6df"},
+    {"accent", "#7c6cf6"},
+    {"menu", "#181a2b"},
+    {"menu_text", "#f4f2fc"},
+    {"panel", "#151726"},
+    {"panel_text", "#f4f2fc"},
+    {"page", "#0f111a"},
+    {"page_text", "#f4f2fc"},
+};
+
+constexpr ColorEntry kAmberNight[] = {
+    {"frame", "#0e0c09"},
+    {"toolbar", "#1a1610"},
+    {"tab_inactive", "#0e0c09"},
+    {"tab_text", "#fbf3e4"},
+    {"omnibox", "#262015"},
+    {"omnibox_text", "#fbf3e4"},
+    {"icons", "#e2cfa9"},
+    {"accent", "#f7a21b"},
+    {"menu", "#1d1912"},
+    {"menu_text", "#fbf3e4"},
+    {"panel", "#1a1610"},
+    {"panel_text", "#fbf3e4"},
+    {"page", "#12100c"},
+    {"page_text", "#fbf3e4"},
+};
+
+constexpr ColorEntry kDaylight[] = {
+    {"frame", "#e6e7f2"},
+    {"toolbar", "#f8f8fd"},
+    {"tab_inactive", "#e6e7f2"},
+    {"tab_text", "#16172a"},
+    {"omnibox", "#eceef8"},
+    {"omnibox_text", "#16172a"},
+    {"icons", "#4a4d6b"},
+    {"accent", "#6366f1"},
+    {"menu", "#ffffff"},
+    {"menu_text", "#16172a"},
+    {"panel", "#ffffff"},
+    {"panel_text", "#16172a"},
+    {"page", "#f6f6fb"},
+    {"page_text", "#16172a"},
+};
+
+struct Preset {
+  const char* name;
+  base::span<const ColorEntry> colors;
+};
+
+// "material": no override, Chromium's palette from the user color alone.
+const Preset kPresets[] = {
+    {"aura", kAura},
+    {"amber_night", kAmberNight},
+    {"daylight", kDaylight},
+    {"material", {}},
+};
+
+SkColor Mix(SkColor foreground, SkColor background, float amount) {
+  return color_utils::AlphaBlend(foreground, background, amount);
+}
+
+}  // namespace
+
+std::optional<SkColor> ParseHexColor(std::string_view hex) {
+  uint32_t rgb = 0;
+  if (hex.size() != 7 || hex[0] != '#' ||
+      !base::HexStringToUInt(hex.substr(1), &rgb)) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB((rgb >> 16) & 0xff, (rgb >> 8) & 0xff, rgb & 0xff);
+}
+
+base::DictValue GetHiveyColorPreset(std::string_view name) {
+  base::DictValue colors;
+  for (const Preset& preset : kPresets) {
+    if (name == preset.name) {
+      for (const ColorEntry& entry : preset.colors) {
+        colors.Set(entry.element, entry.hex);
+      }
+    }
+  }
+  return colors;
+}
+
+base::ListValue GetHiveyColorPresetNames() {
+  base::ListValue names;
+  for (const Preset& preset : kPresets) {
+    names.Append(preset.name);
+  }
+  return names;
+}
+
+void RegisterHiveyColorsPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kHiveyColors, GetHiveyColorPreset("aura"));
+}
+
+void AddHiveyColorMixer(ui::ColorProvider* provider,
+                        const ui::ColorProviderKey& key) {
+  PrefService* local_state =
+      g_browser_process ? g_browser_process->local_state() : nullptr;
+  if (!local_state) {
+    return;
+  }
+  const base::DictValue& colors = local_state->GetDict(kHiveyColors);
+  if (colors.empty()) {
+    return;
+  }
+  auto get = [&](const char* element) -> std::optional<SkColor> {
+    const std::string* hex = colors.FindString(element);
+    return hex ? ParseHexColor(*hex) : std::nullopt;
+  };
+  ui::ColorMixer& mixer = provider->AddPostprocessingMixer();
+  auto set = [&](std::initializer_list<ui::ColorId> ids, SkColor color) {
+    for (ui::ColorId id : ids) {
+      mixer[id] = {color};
+    }
+  };
+
+  if (auto frame = get("frame")) {
+    set({ui::kColorFrameActive, ui::kColorFrameInactive, ui::kColorSysHeader,
+         ui::kColorSysHeaderInactive},
+        *frame);
+  }
+  if (auto toolbar = get("toolbar")) {
+    // The active tab, the bookmarks bar and the vertical tab strip blend
+    // into the toolbar.
+    set({kColorToolbar, kColorTabBackgroundActiveFrameActive,
+         kColorTabBackgroundActiveFrameInactive, kColorBookmarkBarBackground,
+         kColorToolbarTopSeparatorFrameActive,
+         kColorToolbarTopSeparatorFrameInactive},
+        *toolbar);
+  }
+  if (auto inactive = get("tab_inactive")) {
+    set({kColorTabBackgroundInactiveFrameActive,
+         kColorTabBackgroundInactiveFrameInactive},
+        *inactive);
+  }
+  if (auto text = get("tab_text")) {
+    set({kColorTabForegroundActiveFrameActive,
+         kColorTabForegroundActiveFrameInactive},
+        *text);
+    const SkColor base = get("tab_inactive").value_or(*text);
+    set({kColorTabForegroundInactiveFrameActive,
+         kColorTabForegroundInactiveFrameInactive},
+        Mix(*text, base, 0.7f));
+  }
+  if (auto omnibox = get("omnibox")) {
+    const SkColor text = get("omnibox_text").value_or(SK_ColorWHITE);
+    set({kColorLocationBarBackground, kColorOmniboxResultsBackground},
+        *omnibox);
+    set({kColorLocationBarBackgroundHovered,
+         kColorOmniboxResultsBackgroundHovered},
+        Mix(text, *omnibox, 0.07f));
+  }
+  if (auto text = get("omnibox_text")) {
+    set({kColorOmniboxText}, *text);
+    if (auto omnibox = get("omnibox")) {
+      set({kColorOmniboxTextDimmed}, Mix(*text, *omnibox, 0.6f));
+    }
+  }
+  if (auto icons = get("icons")) {
+    set({kColorToolbarButtonIcon, kColorToolbarText,
+         kColorBookmarkBarForeground, kColorNewTabButtonForegroundFrameActive,
+         kColorNewTabButtonForegroundFrameInactive},
+        *icons);
+    const SkColor bright = get("tab_text").value_or(*icons);
+    set({kColorToolbarButtonIconHovered, kColorToolbarButtonIconPressed},
+        bright);
+  }
+  if (auto accent = get("accent")) {
+    set({ui::kColorSysPrimary, ui::kColorAccent, ui::kColorFocusableBorderFocused,
+         ui::kColorSysStateFocusRing},
+        *accent);
+  }
+  if (auto menu = get("menu")) {
+    const SkColor text = get("menu_text").value_or(SK_ColorWHITE);
+    const SkColor accent = get("accent").value_or(text);
+    set({ui::kColorMenuBackground}, *menu);
+    set({ui::kColorMenuBorder, ui::kColorMenuSeparator}, Mix(text, *menu, 0.12f));
+    set({ui::kColorMenuItemBackgroundSelected,
+         ui::kColorMenuItemBackgroundHighlighted},
+        Mix(accent, *menu, 0.28f));
+  }
+  if (auto text = get("menu_text")) {
+    set({ui::kColorMenuItemForeground, ui::kColorMenuItemForegroundSelected,
+         ui::kColorMenuIcon},
+        *text);
+    const SkColor base = get("menu").value_or(*text);
+    set({ui::kColorMenuItemForegroundSecondary}, Mix(*text, base, 0.65f));
+  }
+  if (auto panel = get("panel")) {
+    set({ui::kColorBubbleBackground, ui::kColorDialogBackground,
+         ui::kColorTooltipBackground, ui::kColorPrimaryBackground,
+         kColorSidePanelBackground, kColorSidePanelContentBackground},
+        *panel);
+  }
+  if (auto text = get("panel_text")) {
+    set({ui::kColorDialogForeground, ui::kColorTooltipForeground,
+         ui::kColorPrimaryForeground},
+        *text);
+  }
+  if (auto page = get("page")) {
+    // The browser's own pages (Settings, History, Hivey Studio...) draw with
+    // these system tokens.
+    const SkColor text = get("page_text").value_or(SK_ColorWHITE);
+    set({ui::kColorSysBase, ui::kColorSysSurface}, *page);
+    set({ui::kColorSysSurface1}, Mix(text, *page, 0.03f));
+    set({ui::kColorSysSurface2}, Mix(text, *page, 0.05f));
+    set({ui::kColorSysSurface3}, Mix(text, *page, 0.07f));
+    set({ui::kColorSysSurface4}, Mix(text, *page, 0.09f));
+    set({ui::kColorSysSurface5}, Mix(text, *page, 0.11f));
+    set({ui::kColorSysBaseContainer}, Mix(text, *page, 0.06f));
+  }
+  if (auto text = get("page_text")) {
+    set({ui::kColorSysOnSurface}, *text);
+    const SkColor base = get("page").value_or(*text);
+    set({ui::kColorSysOnSurfaceSubtle}, Mix(*text, base, 0.7f));
+  }
+}
+
+HiveyColorsObserver::HiveyColorsObserver() {
+  if (PrefService* local_state = g_browser_process->local_state()) {
+    registrar_.Init(local_state);
+    registrar_.Add(kHiveyColors,
+                   base::BindRepeating(&HiveyColorsObserver::OnColorsChanged,
+                                       base::Unretained(this)));
+  }
+}
+
+HiveyColorsObserver::~HiveyColorsObserver() = default;
+
+void HiveyColorsObserver::OnColorsChanged() {
+  // Drop the cached color providers, then repaint every window and page.
+  ui::ColorProviderManager::Get().ResetColorProviderCache();
+  ui::NativeTheme::GetInstanceForNativeUi()->NotifyOnNativeThemeUpdated();
+  ui::NativeTheme::GetInstanceForWeb()->NotifyOnNativeThemeUpdated();
+}
+
+}  // namespace hivey
