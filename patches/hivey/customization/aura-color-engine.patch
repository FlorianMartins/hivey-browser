+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#ifndef CHROME_BROWSER_HIVEY_HIVEY_COLORS_H_
+#define CHROME_BROWSER_HIVEY_HIVEY_COLORS_H_
+
+#include <optional>
+
+#include "base/values.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+class PrefRegistrySimple;
+
+namespace ui {
+class ColorProvider;
+class ColorProviderKey;
+}  // namespace ui
+
+namespace hivey {
+
+// Hivey's color engine. Every part of the browser can take a color of the
+// user's choosing (Hivey Studio > Colors): the frame and tab strip, the
+// toolbar and active tab, inactive tabs, tab text, the address bar and its
+// text, toolbar icons, the accent, menus, bubbles and panels, and the
+// browser's own pages (Settings, Hivey Studio...). The colors live in Local
+// State ("hivey.colors": element -> "#rrggbb"); a postprocessing color mixer
+// applies them after every other mixer (Material palette, themes), with the
+// hover, selected and secondary shades derived from them. The default is the
+// Aura preset, the look of the Hivey AI sidebar.
+inline constexpr char kHiveyColors[] = "hivey.colors";
+
+// Element keys, in Hivey Studio's order.
+inline constexpr const char* kHiveyColorElements[] = {
+    "frame",   "toolbar",   "tab_inactive", "tab_text", "omnibox",
+    "omnibox_text", "icons", "accent",     "menu",     "menu_text",
+    "panel",   "panel_text", "page",       "page_text",
+};
+
+void RegisterHiveyColorsPrefs(PrefRegistrySimple* registry);
+
+// Presets ("aura", "amber_night", "daylight", "material"), as element -> hex.
+// "material" is empty: Chromium's palette from the user color alone.
+base::DictValue GetHiveyColorPreset(std::string_view name);
+base::ListValue GetHiveyColorPresetNames();
+
+// The color mixer, appended after Chrome's (chrome_browser_main.cc).
+void AddHiveyColorMixer(ui::ColorProvider* provider,
+                        const ui::ColorProviderKey& key);
+
+std::optional<SkColor> ParseHexColor(std::string_view hex);
+
+// Repaints every window and page when the colors change.
+class HiveyColorsObserver {
+ public:
+  HiveyColorsObserver();
+  HiveyColorsObserver(const HiveyColorsObserver&) = delete;
+  HiveyColorsObserver& operator=(const HiveyColorsObserver&) = delete;
+  ~HiveyColorsObserver();
+
+ private:
+  void OnColorsChanged();
+
+  PrefChangeRegistrar registrar_;
+};
+
+}  // namespace hivey
+
+#endif  // CHROME_BROWSER_HIVEY_HIVEY_COLORS_H_
