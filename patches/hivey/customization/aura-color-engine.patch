+
+#include "chrome/browser/hivey/hivey_app_icon.h"
+
+#include "cc/paint/paint_flags.h"
+#include "third_party/skia/include/core/SkMatrix.h"
+#include "third_party/skia/include/core/SkPath.h"
+#include "third_party/skia/include/core/SkPathBuilder.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/image/canvas_image_source.h"
+
+namespace hivey {
+
+namespace {
+
+// Draws brand/logo.svg (256 x 256 units) scaled to the image size.
+class ThemedLogoSource : public gfx::CanvasImageSource {
+ public:
+  ThemedLogoSource(SkColor accent, int size)
+      : gfx::CanvasImageSource(gfx::Size(size, size)), accent_(accent) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    const float scale = size().width() / 256.f;
+    canvas->sk_canvas()->scale(scale, scale);
+
+    const SkColor dark = color_utils::AlphaBlend(SK_ColorBLACK, accent_, 0.8f);
+    const SkColor light = color_utils::AlphaBlend(SK_ColorWHITE, accent_, 0.7f);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+
+    // Rounded hexagon, pointy top.
+    const SkPath cell = SkPathBuilder()
+                            .moveTo(116, 14.9f)
+                            .quadTo(128, 8, 140, 14.9f)
+                            .lineTo(218.9f, 60.5f)
+                            .quadTo(230.9f, 67.4f, 230.9f, 81.3f)
+                            .lineTo(230.9f, 174.7f)
+                            .quadTo(230.9f, 188.6f, 218.9f, 195.5f)
+                            .lineTo(140, 241.1f)
+                            .quadTo(128, 248, 116, 241.1f)
+                            .lineTo(37.1f, 195.5f)
+                            .quadTo(25.1f, 188.6f, 25.1f, 174.7f)
+                            .lineTo(25.1f, 81.3f)
+                            .quadTo(25.1f, 67.4f, 37.1f, 60.5f)
+                            .close()
+                            .detach();
+    flags.setColor(accent_);
+    canvas->DrawPath(cell, flags);
+
+    // Orbit, tilted: the back half behind the globe, the front half over it.
+    const SkMatrix tilt = SkMatrix::RotateDeg(-28, {128, 128});
+    const SkRect orbit = SkRect::MakeLTRB(40, 98, 216, 158);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    flags.setStrokeWidth(16);
+    flags.setColor(SkColorSetA(dark, 0x59));
+    canvas->DrawPath(SkPathBuilder().addArc(orbit, 180, 180).detach(&tilt),
+                     flags);
+
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(dark);
+    canvas->DrawCircle(gfx::PointF(128, 128), 62, flags);
+
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(12);
+    flags.setColor(light);
+    canvas->DrawPath(SkPathBuilder().addArc(orbit, 0, 180).detach(&tilt),
+                     flags);
+
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(SkColorSetA(light, 0xe6));
+    canvas->DrawCircle(gfx::PointF(106, 104), 12, flags);
+  }
+
+ private:
+  const SkColor accent_;
+};
+
+}  // namespace
+
+gfx::ImageSkia HiveyThemedAppIcon(SkColor accent, int size) {
+  return gfx::CanvasImageSource::MakeImageSkia<ThemedLogoSource>(accent, size);
+}
+
+}  // namespace hivey
