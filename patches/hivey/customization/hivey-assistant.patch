+
+void ShowAssistantPanel(BrowserWindowInterface* browser) {
+  SidePanelUI* side_panel = SidePanelUI::From(browser);
+  SidePanelRegistry* registry = SidePanelRegistry::From(browser);
+  if (!side_panel || !registry) {
+    return;
+  }
+  if (!registry->GetEntryForKey(PanelKey())) {
+    Profile* profile = browser->GetProfile();
+    auto entry = std::make_unique<SidePanelEntry>(
+        PanelKey(),
+        base::BindRepeating(
+            [](Profile* profile, SidePanelEntryScope&) -> SidePanelNativeView {
+              auto view = std::make_unique<views::WebView>(profile);
+              view->LoadInitialURL(GURL(kChromeUIHiveyAssistantURL));
+              return view;
+            },
+            profile),
+        /*default_content_width_callback=*/base::NullCallback());
+    entry->set_should_show_header(false);
+    registry->Register(std::move(entry));
+  }
+  side_panel->Show(PanelKey(), SidePanelOpenTrigger::kExtension);
+}
+
+void ToggleAssistantPanel(BrowserWindowInterface* browser) {
+  SidePanelUI* side_panel = SidePanelUI::From(browser);
+  if (side_panel && side_panel->IsSidePanelEntryShowing(PanelKey())) {
+    side_panel->Close();
+    return;
+  }
+  ShowAssistantPanel(browser);
+}
+
+ui::ImageModel AssistantIcon() {
+  // The four bars of the mark, twice the size for sharp screens.
+  constexpr int kSize = 40;
+  gfx::Canvas canvas(gfx::Size(kSize, kSize), 1.0f, /*is_opaque=*/false);
+  const cc::PaintFlags flags = GradientFlags(gfx::RectF(0, 0, kSize, kSize));
+  const struct {
+    float x, y, width;
+  } kBars[] = {{7, 4, 26}, {3, 12.5f, 34}, {5, 21, 30}, {9.5f, 29.5f, 21}};
+  for (const auto& bar : kBars) {
+    canvas.DrawRoundRect(gfx::RectF(bar.x, bar.y, bar.width, 6), 3, flags);
+  }
+  return ui::ImageModel::FromImageSkia(
+      gfx::ImageSkia::CreateFromBitmap(canvas.GetBitmap(), 2.0f));
+}
+
+void AddAssistantLight(BrowserView* browser_view) {
+  browser_view->AddChildView(std::make_unique<AssistantLightView>(browser_view));
+}
