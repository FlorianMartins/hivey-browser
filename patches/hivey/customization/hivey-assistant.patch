+// the LICENSE file of the Hivey Browser repository.
+
+// The local AI's panel: the model answers on this PC, from pages read without
+// the user's cookies or from the page the user is on. The model has no tools:
+// it writes text, shown as text, so a page's instructions can do nothing but
+// spoil an answer.
+
+import {addWebUiListener, sendWithPromise} from 'chrome://resources/js/cr.js';
+
+const STRINGS = {
+  en: {
+    title: 'Assistant',
