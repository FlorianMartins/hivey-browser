+}
+
+namespace hivey {
+
+// The local AI: llama.cpp (next to the browser, in "HiveyAI") and one small
+// model, downloaded once when the user asks for it. Nothing runs until a
+// question is asked; the process is killed after a few idle minutes, which
+// gives all its memory back. It stops computing while a game has the screen.
+class HiveyAiEngine {
+ public:
+  enum class State {
+    kChecking,     // Looking for the model on disk.
+    kNoModel,      // The user has not downloaded it.
+    kDownloading,  // Downloading, then verifying.
+    kOff,          // Ready to start, no process.
+    kStarting,     // Process started, loading the model.
+    kRunning,      // Answers on 127.0.0.1, with a key.
+    kFailed,       // See error().
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnHiveyAiChanged() = 0;
+    // A question from the new tab is waiting (TakePending()).
+    virtual void OnHiveyAiPending() = 0;
+  };
+
+  static HiveyAiEngine& Get();
+
+  HiveyAiEngine(const HiveyAiEngine&) = delete;
+  HiveyAiEngine& operator=(const HiveyAiEngine&) = delete;
+
+  // state, progress (0-1), error, game, busy. Not the key: only the browser
+  // process talks to the engine.
+  base::DictValue Describe() const;
+  void DownloadModel();
+  void Start();
+  // The page saw the engine answer, or gave up on it.
+  void OnStarted(bool ok);
+  // A question is being answered: no idle stop, the lights are on.
+  void SetBusy(bool busy);
+  void SetPending(const std::string& text);
+  std::string TakePending();
+  // For tests: a game is on the screen.
+  void SetGameForTesting(bool game);
+
+  int port() const { return port_; }
+  const std::string& key() const { return key_; }
+  bool busy() const { return busy_; }
+  bool game() const { return game_; }
+
+  void AddObserver(Observer* observer) { observers_.AddObserver(observer); }
+  void RemoveObserver(Observer* observer) {
+    observers_.RemoveObserver(observer);
+  }
+
+ private:
+  friend class base::NoDestructor<HiveyAiEngine>;
+
+  HiveyAiEngine();
+  ~HiveyAiEngine();
+
+  base::FilePath ModelPath() const;
+  void Notify();
+  void OnModelChecked(bool present);
+  void OnDownloaded(base::FilePath path);
+  void OnVerified(bool ok);
+  void Fail(const std::string& error);
+  void Kill();
+  void RestartIdleTimer();
+  void CheckGame();
+  void ApplyGame(bool game);
+
+  State state_ = State::kChecking;
+  double progress_ = 0;
+  std::string error_;
+  int port_ = 0;
+  std::string key_;
+  bool busy_ = false;
+  bool game_ = false;
+  bool game_for_testing_ = false;
+  std::string pending_;
+  base::Process process_;
+#if BUILDFLAG(IS_WIN)
+  // Closing it kills the engine, also if the browser crashes.
+  base::win::ScopedHandle job_;
+#endif
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::OneShotTimer idle_timer_;
+  base::RepeatingTimer game_timer_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<HiveyAiEngine> weak_factory_{this};
+};
+
+}  // namespace hivey
