+constexpr size_t kMaxPageBytes = 2 * 1024 * 1024;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("hivey_assistant_search", R"(
+      semantics {
+        sender: "Hivey assistant"
+        description: "Searches the web and reads the pages found, for the "
+          "answer the user asked for."
+        trigger: "A question to the assistant with web search on."
+        data: "The search terms."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "The assistant's Web switch."
+        policy_exception_justification: "Not implemented."
+      })");
+
+std::unique_ptr<network::ResourceRequest> EngineRequest(const char* path) {
+  hivey::HiveyAiEngine& engine = hivey::HiveyAiEngine::Get();
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL("http://127.0.0.1:" + base::NumberToString(engine.port()) +
+                      path);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader("Authorization", "Bearer " + engine.key());
+  return request;
+}
+
+class HiveyAssistantHandler : public content::WebUIMessageHandler,
+                              public network::SimpleURLLoaderStreamConsumer,
+                              public hivey::HiveyAiEngine::Observer {
+ public:
+  HiveyAssistantHandler() = default;
+  ~HiveyAssistantHandler() override {
+    if (observing_) {
+      hivey::HiveyAiEngine::Get().RemoveObserver(this);
+    }
+  }
+
+  void RegisterMessages() override {
+    auto add = [&](const char* name, auto method) {
+      web_ui()->RegisterMessageCallback(
+          name, base::BindRepeating(method, base::Unretained(this)));
+    };
+    add("getEngine", &HiveyAssistantHandler::HandleGetEngine);
+    add("downloadModel", &HiveyAssistantHandler::HandleDownloadModel);
+    add("startEngine", &HiveyAssistantHandler::HandleStartEngine);
+    add("engineStarted", &HiveyAssistantHandler::HandleEngineStarted);
+    add("setBusy", &HiveyAssistantHandler::HandleSetBusy);
+    add("takePending", &HiveyAssistantHandler::HandleTakePending);
+    add("checkHealth", &HiveyAssistantHandler::HandleCheckHealth);
+    add("engineChat", &HiveyAssistantHandler::HandleEngineChat);
+    add("engineAbort", &HiveyAssistantHandler::HandleEngineAbort);
+    add("fetchPage", &HiveyAssistantHandler::HandleFetchPage);
+    add("readActivePage", &HiveyAssistantHandler::HandleReadActivePage);
+    add("openUrl", &HiveyAssistantHandler::HandleOpenUrl);
+    add("closePanel", &HiveyAssistantHandler::HandleClosePanel);
+    if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+            "hivey-ai-test-game")) {
+      add("setGameForTesting", &HiveyAssistantHandler::HandleSetGame);
+    }
+  }
+
+  void OnJavascriptAllowed() override {
+    if (!observing_) {
+      hivey::HiveyAiEngine::Get().AddObserver(this);
+      observing_ = true;
+    }
+  }
+  void OnJavascriptDisallowed() override {
+    if (observing_) {
+      hivey::HiveyAiEngine::Get().RemoveObserver(this);
+      observing_ = false;
+    }
+  }
+
+  // hivey::HiveyAiEngine::Observer:
+  void OnHiveyAiChanged() override {
+    FireWebUIListener("engine", hivey::HiveyAiEngine::Get().Describe());
+  }
+  void OnHiveyAiPending() override { FireWebUIListener("pending"); }
+
+  // network::SimpleURLLoaderStreamConsumer: the answer, as it is written.
+  void OnDataReceived(std::string_view data,
+                      base::OnceClosure resume) override {
+    partial_.append(data);
+    // A chunk can end in the middle of a character: the rest waits.
+    std::string complete;
+    base::TruncateUTF8ToByteSize(partial_, partial_.size(), &complete);
+    partial_.erase(0, complete.size());
+    if (!complete.empty()) {
+      FireWebUIListener("engine-chunk", base::Value(complete));
+    }
+    std::move(resume).Run();
+  }
+  void OnComplete(bool success) override {
+    const int status =
+        chat_loader_ && chat_loader_->ResponseInfo() &&
+                chat_loader_->ResponseInfo()->headers
+            ? chat_loader_->ResponseInfo()->headers->response_code()
+            : 0;
+    chat_loader_.reset();
+    partial_.clear();
+    FireWebUIListener("engine-done", base::Value(success), base::Value(status));
+  }
+  void OnRetry(base::OnceClosure start_retry) override {}
+
+ private:
+  // [callback id]: the engine has loaded its model.
+  void HandleCheckHealth(const base::ListValue& args) {
+    AllowJavascript();
+    auto loader = network::SimpleURLLoader::Create(EngineRequest("/health"),
+                                                   kTrafficAnnotation);
+    loader->SetTimeoutDuration(base::Seconds(3));
+    auto* raw = loader.get();
+    loaders_.push_back(std::move(loader));
+    raw->DownloadToString(
+        g_browser_process->shared_url_loader_factory().get(),
+        base::BindOnce(&HiveyAssistantHandler::OnHealth,
+                       weak_factory_.GetWeakPtr(), args[0].Clone(),
+                       std::prev(loaders_.end())),
+        1024);
+  }
+  void OnHealth(base::Value callback_id,
+                std::list<std::unique_ptr<network::SimpleURLLoader>>::iterator
+                    loader,
+                std::optional<std::string> body) {
+    loaders_.erase(loader);
+    ResolveJavascriptCallback(callback_id, base::Value(body.has_value()));
+  }
+
+  // [JSON body]: streams the answer to "engine-chunk", then "engine-done".
+  void HandleEngineChat(const base::ListValue& args) {
+    AllowJavascript();
+    auto request = EngineRequest("/v1/chat/completions");
+    request->method = "POST";
+    chat_loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                                    kTrafficAnnotation);
+    chat_loader_->AttachStringForUpload(args[0].GetString(),
+                                        "application/json");
+    partial_.clear();
+    chat_loader_->DownloadAsStream(
+        g_browser_process->shared_url_loader_factory().get(), this);
+  }
+  // Dropping the connection makes the engine stop computing.
+  void HandleEngineAbort(const base::ListValue& args) {
+    chat_loader_.reset();
+    partial_.clear();
+  }
+
+  void HandleGetEngine(const base::ListValue& args) {
+    AllowJavascript();
+    ResolveJavascriptCallback(args[0], hivey::HiveyAiEngine::Get().Describe());
+  }
+  void HandleDownloadModel(const base::ListValue& args) {
+    hivey::HiveyAiEngine::Get().DownloadModel();
+  }
+  void HandleStartEngine(const base::ListValue& args) {
+    hivey::HiveyAiEngine::Get().Start();
+  }
+  void HandleEngineStarted(const base::ListValue& args) {
+    hivey::HiveyAiEngine::Get().OnStarted(args[0].GetBool());
+  }
+  void HandleSetBusy(const base::ListValue& args) {
+    hivey::HiveyAiEngine::Get().SetBusy(args[0].GetBool());
+  }
+  void HandleSetGame(const base::ListValue& args) {
+    hivey::HiveyAiEngine::Get().SetGameForTesting(args[0].GetBool());
+  }
+  void HandleTakePending(const base::ListValue& args) {
+    AllowJavascript();
+    ResolveJavascriptCallback(
+        args[0], base::Value(hivey::HiveyAiEngine::Get().TakePending()));
+  }
+
+  // [callback id, url]: its text, without the user's cookies or session.
+  void HandleFetchPage(const base::ListValue& args) {
+    AllowJavascript();
+    const GURL url(args[1].GetString());
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+      ResolveJavascriptCallback(args[0], base::Value());
+      return;
+    }
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = url;
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                   kTrafficAnnotation);
+    loader->SetTimeoutDuration(base::Seconds(15));
+    auto* raw = loader.get();
+    loaders_.push_back(std::move(loader));
+    raw->DownloadToString(
+        g_browser_process->shared_url_loader_factory().get(),
+        base::BindOnce(&HiveyAssistantHandler::OnFetched,
+                       weak_factory_.GetWeakPtr(), args[0].Clone(),
+                       std::prev(loaders_.end())),
+        kMaxPageBytes);
+  }
+  void OnFetched(base::Value callback_id,
+                 std::list<std::unique_ptr<network::SimpleURLLoader>>::iterator
+                     loader,
+                 std::optional<std::string> body) {
+    loaders_.erase(loader);
+    // Pages are not all valid UTF-8; base::Value must be.
+    ResolveJavascriptCallback(
+        callback_id,
+        body ? base::Value(base::UTF16ToUTF8(base::UTF8ToUTF16(*body)))
+             : base::Value());
+  }
+
+  // [callback id]: {url, title, text} of the active tab, what the user sees:
+  // innerText leaves out hidden text. Null on a browser page.
+  void HandleReadActivePage(const base::ListValue& args) {
+    AllowJavascript();
+    content::WebContents* contents = ActiveContents();
+    if (!contents || !contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+      ResolveJavascriptCallback(args[0], base::Value());
+      return;
+    }
+    contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+        u"({url: location.href, title: document.title, "
+        u"text: document.body ? document.body.innerText : ''})",
+        base::BindOnce(&HiveyAssistantHandler::OnPageRead,
+                       weak_factory_.GetWeakPtr(), args[0].Clone()),
+        ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  }
+  void OnPageRead(base::Value callback_id, base::Value result) {
+    ResolveJavascriptCallback(callback_id, result);
+  }
+
+  void HandleOpenUrl(const base::ListValue& args) {
+    const GURL url(args[0].GetString());
+    BrowserWindowInterface* browser = Browser();
+    if (browser && url.SchemeIsHTTPOrHTTPS()) {
+      browser->OpenGURL(url, WindowOpenDisposition::NEW_FOREGROUND_TAB);
+    }
+  }
+  void HandleClosePanel(const base::ListValue& args) {
+    BrowserWindowInterface* browser = Browser();
+    SidePanelUI* side_panel = browser ? SidePanelUI::From(browser) : nullptr;
+    if (side_panel) {
+      side_panel->Close();
+    }
+  }
+
+  // The panel the user is looking at belongs to the active window.
+  BrowserWindowInterface* Browser() {
+    return GetLastActiveBrowserWindowInterfaceWithAnyProfile();
+  }
+  content::WebContents* ActiveContents() {
+    BrowserWindowInterface* browser = Browser();
+    tabs::TabInterface* tab =
+        browser ? browser->GetActiveTabInterface() : nullptr;
+    return tab ? tab->GetContents() : nullptr;
+  }
+
+  bool observing_ = false;
+  std::list<std::unique_ptr<network::SimpleURLLoader>> loaders_;
+  std::unique_ptr<network::SimpleURLLoader> chat_loader_;
+  std::string partial_;
+  base::WeakPtrFactory<HiveyAssistantHandler> weak_factory_{this};
+};
+
+}  // namespace
+
+HiveyAssistantUI::HiveyAssistantUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), kChromeUIHiveyAssistantHost);
+  source->AddResourcePath("assistant.css", IDR_HIVEY_ASSISTANT_CSS);
+  source->AddResourcePath("assistant.js", IDR_HIVEY_ASSISTANT_JS);
+  source->SetDefaultResource(IDR_HIVEY_ASSISTANT_HTML);
+  // The page builds its DOM with createElement/textContent only, and parses
+  // fetched pages into inert documents.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::RequireTrustedTypesFor,
+      "require-trusted-types-for 'script';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::TrustedTypes,
+      "trusted-types hivey-parser;");
+  web_ui->AddMessageHandler(std::make_unique<HiveyAssistantHandler>());
+}
