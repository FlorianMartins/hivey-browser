+/* Copyright 2026 The Hivey Browser contributors
+ * Use of this source code is governed by the MIT license that can be found in
+ * the LICENSE file of the Hivey Browser repository. */
+
+/* The local AI's side panel: hairlines at rest, the Hivey mark's colors for
+ * what moves. Nothing runs while no answer is being written. */
+
+:root {
+  --bg: var(--color-side-panel-content-background, var(--color-sys-base, #151518));
+  --text: var(--color-sys-on-surface, #f4f4f6);
+  --muted: color-mix(in srgb, var(--text) 62%, var(--bg));
+  --line: color-mix(in srgb, var(--text) 13%, transparent);
+  --raise: color-mix(in srgb, var(--text) 7%, var(--bg));
+  --blue: #3b82f6;
+  --violet: #8b5cf6;
+  --fuchsia: #d946ef;
+  --grad: linear-gradient(90deg, var(--blue), var(--violet), var(--fuchsia));
+  --ok: #4ade80;
+  --warn: #fbbf24;
+  --danger: #fb7185;
+  --mono: ui-monospace, 'Cascadia Mono', Consolas, 'DejaVu Sans Mono', monospace;
+  --ease: cubic-bezier(.16, 1, .3, 1);
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body {
+  display: flex;
+  flex-direction: column;
+  background: var(--bg);
+  color: var(--text);
+  font: 14px/1.5 system-ui, 'Segoe UI Variable Text', 'Segoe UI', Ubuntu, Cantarell, sans-serif;
+  -webkit-font-smoothing: antialiased;
+}
+button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
+:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; border-radius: 6px; }
+.mono { font-family: var(--mono); }
+
+header {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 10px 12px;
+  border-bottom: 1px solid var(--line);
+}
+#mark { width: 22px; height: 22px; flex: none; }
+#mark rect { transform-box: fill-box; transform-origin: center; }
+body.busy #mark rect { animation: breathe 1.15s ease-in-out infinite; }
+body.busy #mark rect:nth-child(2) { animation-delay: .12s; }
+body.busy #mark rect:nth-child(3) { animation-delay: .24s; }
+body.busy #mark rect:nth-child(4) { animation-delay: .36s; }
+body.game #mark { opacity: .4; filter: grayscale(1); }
+#title { font-weight: 500; line-height: 1.2; }
+#subtitle { font-size: 11px; color: var(--muted); }
+#close {
+  margin-left: auto;
+  width: 32px;
+  height: 32px;
+  display: grid;
+  place-items: center;
+  border-radius: 7px;
+  color: var(--muted);
+}
+#close:hover { color: var(--text); background: var(--raise); }
+
+#feed {
+  flex: 1;
+  min-height: 0;
+  overflow: auto;
+  padding: 14px 12px;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+}
+.in { animation: rise .5s var(--ease) backwards; }
+.empty { margin: auto 0; color: var(--muted); }
+.ask { font-size: 16px; line-height: 1.35; font-weight: 500; overflow-wrap: anywhere; }
+.label { font: 11px var(--mono); color: var(--muted); margin-bottom: 8px; }
+
+.plan { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; position: relative; }
+.plan::before {
+  content: "";
+  position: absolute;
+  left: 3px;
+  top: 9px;
+  bottom: 9px;
+  width: 1px;
+  opacity: .7;
+  background: linear-gradient(var(--blue), var(--violet), var(--fuchsia));
+}
+.plan li { display: flex; gap: 12px; align-items: baseline; color: var(--muted); transition: color .25s; }
+.plan li::before {
+  content: "";
+  flex: none;
+  position: relative;
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--bg);
+  box-shadow: 0 0 0 1px var(--line);
+  transform: translateY(-1px);
+}
+.plan li.now { color: var(--text); }
+.plan li.now::before {
+  background: var(--fuchsia);
+  box-shadow: 0 0 0 3px color-mix(in srgb, var(--fuchsia) 30%, transparent), 0 0 12px var(--fuchsia);
+  animation: pulse 1.1s ease-in-out infinite;
+}
+.plan li.done { color: var(--text); }
+.plan li.done::before { background: var(--violet); box-shadow: none; }
+body.game .plan li.now { color: var(--warn); }
+body.game .plan li.now::before { background: var(--warn); box-shadow: none; animation: none; }
+.plan li.failed { color: var(--danger); }
+.plan li.failed::before { background: var(--danger); box-shadow: none; }
+
+.src {
+  display: flex;
+  gap: 12px;
+  align-items: baseline;
+  width: 100%;
+  padding: 8px 0;
+  text-align: left;
+  border-top: 1px solid var(--line);
+  font-size: 13px;
+  color: var(--muted);
+}
+.src:last-child { border-bottom: 1px solid var(--line); }
+.src:hover { color: var(--text); }
+.src .n { font: 11px var(--mono); }
+.src span span { display: block; }
+.src small { display: block; font: 11px var(--mono); overflow-wrap: anywhere; color: var(--muted); }
+
+.answer { line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }
+.answer span { animation: word .35s linear backwards; }
+.cite {
+  min-width: 22px;
+  min-height: 20px;
+  margin: 0 2px;
+  padding: 0 5px;
+  border-radius: 5px;
+  font: 500 11px var(--mono);
+  box-shadow: inset 0 0 0 1px var(--line);
+}
+.cite:hover, .cite:focus-visible { color: #fff; background: var(--violet); }
+.ledger {
+  display: grid;
+  gap: 4px;
+  padding-top: 10px;
+  border-top: 1px dashed var(--line);
+  font-size: 12px;
+  color: var(--muted);
+}
+.ledger b { color: var(--text); font-weight: 500; }
+.note { padding: 10px 12px; border-radius: 9px; background: var(--raise); }
+.note strong { display: block; font-weight: 500; }
+.note small { font-size: 12px; color: var(--muted); }
+.note.bad { box-shadow: inset 2px 0 0 var(--danger); }
+.note.held { box-shadow: inset 2px 0 0 var(--warn); }
+.note .act { margin-top: 10px; }
+.act {
+  min-height: 40px;
+  padding: 4px 16px;
+  border-radius: 20px;
+  color: #fff;
+  font-weight: 500;
+  background: var(--grad);
+}
+.bar { height: 4px; margin-top: 10px; border-radius: 2px; background: var(--line); overflow: hidden; }
+.bar i { display: block; height: 100%; width: 100%; background: var(--grad); transform-origin: left; transition: transform .4s var(--ease); }
+
+#composer { padding: 8px 12px 10px; display: grid; gap: 8px; }
+#sources { display: flex; flex-wrap: wrap; gap: 4px; }
+.chip {
+  min-height: 28px;
+  padding: 2px 10px;
+  border-radius: 14px;
+  font-size: 12px;
+  color: var(--muted);
+  box-shadow: inset 0 0 0 1px var(--line);
+}
+.chip:hover { color: var(--text); }
+.chip[aria-pressed="true"] { color: #fff; background: var(--grad); box-shadow: none; }
+#field {
+  display: flex;
+  align-items: flex-end;
+  gap: 8px;
+  padding: 6px 6px 6px 14px;
+  border-radius: 22px;
+  background: var(--raise);
+  box-shadow: inset 0 0 0 1px var(--line);
+  transition: box-shadow .2s;
+}
+#field:focus-within { box-shadow: inset 0 0 0 1px var(--violet); }
+#q {
+  flex: 1;
+  min-width: 0;
+  max-height: 140px;
+  padding: 6px 0;
+  border: 0;
+  outline: none;
+  resize: none;
+  color: var(--text);
+  background: none;
+  font: inherit;
+}
+#q::placeholder { color: var(--muted); }
+#send {
+  flex: none;
+  width: 32px;
+  height: 32px;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  color: #fff;
+  background: linear-gradient(135deg, var(--blue), var(--violet), var(--fuchsia));
+}
+body.busy #send { background: var(--raise); color: var(--text); box-shadow: inset 0 0 0 1px var(--line); }
+body.busy #send svg { display: none; }
+body.busy #send::before { content: ""; width: 10px; height: 10px; border-radius: 2px; background: var(--fuchsia); }
+
+#status {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 2px 14px;
+  padding: 6px 12px;
+  border-top: 1px solid var(--line);
+  font-size: 10.5px;
+  color: var(--muted);
+}
+#status span { display: inline-flex; align-items: center; gap: 6px; }
+#status b { font-weight: 400; }
+#status i { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); }
+#st-machine[data-s="free"] i { background: var(--ok); }
+#st-machine[data-s="game"] i { background: var(--danger); }
+
+@keyframes breathe { 50% { transform: scaleX(.55); opacity: .6; } }
+@keyframes pulse { 50% { opacity: .4; } }
+@keyframes rise { from { transform: translateY(8px); opacity: 0; } }
+@keyframes word { from { opacity: 0; color: var(--fuchsia); } }
+@media (prefers-reduced-motion: reduce) {
+  *, *::before { animation: none !important; transition: none !important; }
+}
