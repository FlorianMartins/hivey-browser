+constexpr char kModelSha256[] =
+    "b139949c5bd74937ad8ed8c8cf3d9ffb1e99c866c823204dc42c0d91fa181897";
+constexpr int64_t kModelBytes = 1107409472;
+
+constexpr base::TimeDelta kIdleStop = base::Minutes(5);
+constexpr base::TimeDelta kGameCheck = base::Seconds(2);
+
+#if BUILDFLAG(IS_WIN)
+constexpr char kEngineDir[] = "HiveyAI";
+constexpr char kEngineExe[] = "llama-server.exe";
+#else
+constexpr char kEngineDir[] = "hiveyai";
+constexpr char kEngineExe[] = "llama-server";
+#endif
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("hivey_ai_model", R"(
+      semantics {
+        sender: "Hivey local AI"
+        description: "Downloads the local AI's model, once."
+        trigger: "The user asks for it in the assistant's panel."
+        data: "None."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Not downloaded unless the user asks."
+        policy_exception_justification: "Not implemented."
+      })");
+
+bool HasModel(const base::FilePath& path) {
+  return base::GetFileSize(path).value_or(0) == kModelBytes;
+}
+
+// Blocking: size and sha256; a good file takes its final name.
+bool VerifyModel(const base::FilePath& part, const base::FilePath& path) {
+  bool ok = false;
+  {
+    base::File file(part, base::File::FLAG_OPEN | base::File::FLAG_READ);
+    std::array<uint8_t, crypto::hash::kSha256Size> digest;
+    ok = file.IsValid() && file.GetLength() == kModelBytes &&
+         crypto::hash::HashFile(crypto::hash::kSha256, &file, digest) &&
+         base::EqualsCaseInsensitiveASCII(base::HexEncode(digest), kModelSha256);
+  }
+  if (!ok) {
+    base::DeleteFile(part);
+    return false;
+  }
+  return base::ReplaceFile(part, path, nullptr);
+}
+
+#if BUILDFLAG(IS_WIN)
+// Exclusive full screen, or another program's window covering its monitor (a
+// borderless game). The browser's own full screen does not count.
+bool IsGameOnScreen() {
+  HWND foreground = ::GetForegroundWindow();
+  if (!foreground) {
+    return false;
+  }
+  DWORD process_id = 0;
+  ::GetWindowThreadProcessId(foreground, &process_id);
+  if (process_id == ::GetCurrentProcessId()) {
+    return false;
+  }
+  QUERY_USER_NOTIFICATION_STATE state;
+  if (SUCCEEDED(::SHQueryUserNotificationState(&state)) &&
+      state == QUNS_RUNNING_D3D_FULL_SCREEN) {
+    return true;
+  }
+  wchar_t class_name[64] = {};
+  ::GetClassNameW(foreground, class_name, 64);
+  const std::wstring_view name(class_name);
+  if (name == L"Progman" || name == L"WorkerW") {  // The desktop.
+    return false;
+  }
+  RECT window;
+  MONITORINFO monitor = {sizeof(monitor)};
+  return ::GetWindowRect(foreground, &window) &&
+         ::GetMonitorInfoW(
+             ::MonitorFromWindow(foreground, MONITOR_DEFAULTTONEAREST),
+             &monitor) &&
+         window.left <= monitor.rcMonitor.left &&
+         window.top <= monitor.rcMonitor.top &&
+         window.right >= monitor.rcMonitor.right &&
+         window.bottom >= monitor.rcMonitor.bottom;
+}
+
+void SuspendProcess(const base::Process& process, bool suspend) {
+  using Call = LONG(WINAPI*)(HANDLE);
+  HMODULE ntdll = ::GetModuleHandleW(L"ntdll.dll");
+  auto call = reinterpret_cast<Call>(::GetProcAddress(
+      ntdll, suspend ? "NtSuspendProcess" : "NtResumeProcess"));
+  if (call) {
+    call(process.Handle());
+  }
+}
+
+// EcoQoS: efficient cores first, on the CPUs that have them.
+void SetEfficiencyMode(const base::Process& process) {
+  PROCESS_POWER_THROTTLING_STATE state = {};
+  state.Version = PROCESS_POWER_THROTTLING_CURRENT_VERSION;
+  state.ControlMask = PROCESS_POWER_THROTTLING_EXECUTION_SPEED;
+  state.StateMask = PROCESS_POWER_THROTTLING_EXECUTION_SPEED;
+  ::SetProcessInformation(process.Handle(), ProcessPowerThrottling, &state,
+                          sizeof(state));
+}
+#else
+bool IsGameOnScreen() {
+  return false;
+}
+
+void SuspendProcess(const base::Process& process, bool suspend) {
+  kill(process.Pid(), suspend ? SIGSTOP : SIGCONT);
+}
+#endif
+
+}  // namespace
+
+// static
+HiveyAiEngine& HiveyAiEngine::Get() {
+  static base::NoDestructor<HiveyAiEngine> engine;
+  return *engine;
+}
+
+HiveyAiEngine::HiveyAiEngine() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&HasModel, ModelPath()),
+      base::BindOnce(&HiveyAiEngine::OnModelChecked,
+                     weak_factory_.GetWeakPtr()));
+}
+
+HiveyAiEngine::~HiveyAiEngine() = default;
+
+base::FilePath HiveyAiEngine::ModelPath() const {
+  base::FilePath user_data;
+  base::PathService::Get(chrome::DIR_USER_DATA, &user_data);
+  return user_data.AppendASCII("HiveyAI").AppendASCII("model.gguf");
+}
+
+base::DictValue HiveyAiEngine::Describe() const {
+  const char* state = "checking";
+  switch (state_) {
+    case State::kChecking:
+      break;
+    case State::kNoModel:
+      state = "no-model";
+      break;
+    case State::kDownloading:
+      state = "downloading";
+      break;
+    case State::kOff:
+      state = "off";
+      break;
+    case State::kStarting:
+      state = "starting";
+      break;
+    case State::kRunning:
+      state = "running";
+      break;
+    case State::kFailed:
+      state = "failed";
+      break;
+  }
+  base::DictValue dict;
+  dict.Set("state", state);
+  dict.Set("progress", progress_);
+  dict.Set("error", error_);
+  dict.Set("busy", busy_);
+  dict.Set("game", game_);
+  return dict;
+}
+
+void HiveyAiEngine::Notify() {
+  for (Observer& observer : observers_) {
+    observer.OnHiveyAiChanged();
+  }
+}
+
+void HiveyAiEngine::OnModelChecked(bool present) {
+  if (state_ == State::kChecking) {
+    state_ = present ? State::kOff : State::kNoModel;
+    Notify();
+  }
+}
+
+void HiveyAiEngine::Fail(const std::string& error) {
+  Kill();
+  state_ = State::kFailed;
+  error_ = error;
+  Notify();
+}
+
+void HiveyAiEngine::DownloadModel() {
+  if (state_ != State::kNoModel &&
+      !(state_ == State::kFailed && !loader_)) {
+    return;
+  }
+  state_ = State::kDownloading;
+  progress_ = 0;
+  error_.clear();
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(kModelUrl);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kTrafficAnnotation);
+  loader_->SetRetryOptions(
+      2, network::SimpleURLLoader::RETRY_ON_NETWORK_CHANGE |
+             network::SimpleURLLoader::RETRY_ON_5XX);
+  loader_->SetOnDownloadProgressCallback(base::BindRepeating(
+      [](HiveyAiEngine* engine, uint64_t current) {
+        // At most one update per percent.
+        const double progress =
+            std::min(0.99, static_cast<double>(current) / kModelBytes);
+        if (progress - engine->progress_ >= 0.01) {
+          engine->progress_ = progress;
+          engine->Notify();
+        }
+      },
+      base::Unretained(this)));
+  const base::FilePath part = ModelPath().AddExtensionASCII("part");
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(
+          [](base::FilePath dir) { base::CreateDirectory(dir); },
+          part.DirName()));
+  loader_->DownloadToFile(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&HiveyAiEngine::OnDownloaded, base::Unretained(this)),
+      part);
+  Notify();
+}
+
+void HiveyAiEngine::OnDownloaded(base::FilePath path) {
+  loader_.reset();
+  if (path.empty()) {
+    Fail("download");
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&VerifyModel, path, ModelPath()),
+      base::BindOnce(&HiveyAiEngine::OnVerified, weak_factory_.GetWeakPtr()));
+}
+
+void HiveyAiEngine::OnVerified(bool ok) {
+  if (!ok) {
+    Fail("verification");
+    return;
+  }
+  state_ = State::kOff;
+  progress_ = 1;
+  Notify();
+}
+
+void HiveyAiEngine::Start() {
+  // A failed start can be tried again; a failed download goes through
+  // DownloadModel().
+  if (state_ == State::kFailed && (error_ == "start" || error_ == "launch")) {
+    state_ = State::kOff;
+  }
+  if (state_ != State::kOff) {
+    Notify();
+    return;
+  }
+  error_.clear();
+  base::FilePath module_dir;
+  base::PathService::Get(base::DIR_MODULE, &module_dir);
+  const base::FilePath engine_dir = module_dir.AppendASCII(kEngineDir);
+  port_ = base::RandIntInclusive(20000, 60000);
+  key_ = base::HexEncode(base::RandBytesAsVector(16));
+  // As many threads as the bench found useful: more only cost the rest of the
+  // machine (memory bandwidth), for almost no speed.
+  const int threads =
+      std::clamp(base::SysInfo::NumberOfProcessors() / 2, 2, 4);
+
+  base::CommandLine command(engine_dir.AppendASCII(kEngineExe));
+  auto arg = [&](const char* name, const std::string& value) {
+    command.AppendArg(name);
+    command.AppendArg(value);
+  };
+  arg("-m", ModelPath().AsUTF8Unsafe());
+  arg("--host", "127.0.0.1");
+  arg("--port", base::NumberToString(port_));
+  arg("--api-key", key_);
+  arg("-np", "1");
+  arg("-c", "8192");
+  arg("-t", base::NumberToString(threads));
+  arg("--poll", "0");
+  arg("--threads-http", "2");
+  command.AppendArg("--no-repack");
+  command.AppendArg("--no-webui");
+  command.AppendArg("--log-disable");
+
+  base::LaunchOptions options;
+  options.current_directory = engine_dir;
+#if BUILDFLAG(IS_WIN)
+  options.start_hidden = true;
+  job_.Set(::CreateJobObject(nullptr, nullptr));
+  if (job_.is_valid() &&
+      base::SetJobObjectLimitFlags(job_.get(),
+                                   JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE)) {
+    options.job_handle = job_.get();
+  }
+#else
+  options.kill_on_parent_death = true;
+  options.environment["LD_LIBRARY_PATH"] = engine_dir.value();
+#endif
+  process_ = base::LaunchProcess(command, options);
+  if (!process_.IsValid()) {
+    Fail("launch");
+    return;
+  }
+  // Below everything the user is doing.
+#if BUILDFLAG(IS_WIN)
+  process_.SetPriority(base::Process::Priority::kBestEffort);
+  SetEfficiencyMode(process_);
+#else
+  setpriority(PRIO_PROCESS, process_.Pid(), 19);
+#endif
+  state_ = State::kStarting;
+  game_timer_.Start(FROM_HERE, kGameCheck, this, &HiveyAiEngine::CheckGame);
+  CheckGame();
+  RestartIdleTimer();
+  Notify();
+}
+
+void HiveyAiEngine::OnStarted(bool ok) {
+  if (state_ != State::kStarting) {
+    return;
+  }
+  if (!ok) {
+    Fail("start");
+    return;
+  }
+  state_ = State::kRunning;
+  Notify();
+}
+
+void HiveyAiEngine::Kill() {
+  idle_timer_.Stop();
+  game_timer_.Stop();
+  game_ = false;
+  if (process_.IsValid()) {
+    // At once, even in the middle of an answer or suspended: it keeps nothing
+    // worth saving.
+#if BUILDFLAG(IS_WIN)
+    process_.Terminate(0, /*wait=*/false);
+    process_.Close();
+#else
+    kill(process_.Pid(), SIGKILL);
+    base::EnsureProcessTerminated(std::move(process_));
+#endif
+  }
+#if BUILDFLAG(IS_WIN)
+  job_.Close();
+#endif
+  port_ = 0;
+  key_.clear();
+  if (state_ == State::kStarting || state_ == State::kRunning) {
+    state_ = State::kOff;
+  }
+}
+
+void HiveyAiEngine::RestartIdleTimer() {
+  idle_timer_.Start(FROM_HERE, kIdleStop,
+                    base::BindOnce(
+                        [](HiveyAiEngine* engine) {
+                          if (!engine->busy_) {
+                            engine->Kill();
+                            engine->Notify();
+                          }
+                        },
+                        base::Unretained(this)));
+}
+
+void HiveyAiEngine::SetBusy(bool busy) {
+  if (busy_ == busy) {
+    return;
+  }
+  busy_ = busy;
+  if (process_.IsValid()) {
+    RestartIdleTimer();
+  }
+  Notify();
+}
+
+void HiveyAiEngine::SetPending(const std::string& text) {
+  pending_ = text;
+  for (Observer& observer : observers_) {
+    observer.OnHiveyAiPending();
+  }
+}
+
+std::string HiveyAiEngine::TakePending() {
+  return std::exchange(pending_, std::string());
+}
+
+void HiveyAiEngine::CheckGame() {
+  ApplyGame(game_for_testing_ || IsGameOnScreen());
+}
+
+void HiveyAiEngine::SetGameForTesting(bool game) {
+  game_for_testing_ = game;
+  CheckGame();
+}
+
+void HiveyAiEngine::ApplyGame(bool game) {
+  if (game_ == game) {
+    return;
+  }
+  game_ = game;
+  if (process_.IsValid()) {
+    SuspendProcess(process_, game);
+    RestartIdleTimer();
+  }
+  Notify();
+}
+
+}  // namespace hivey
