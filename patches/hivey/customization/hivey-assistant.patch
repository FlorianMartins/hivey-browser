+
+// The Hivey mark's colors.
+constexpr SkColor4f kBlue = {0x3b / 255.f, 0x82 / 255.f, 0xf6 / 255.f, 1};
+constexpr SkColor4f kViolet = {0x8b / 255.f, 0x5c / 255.f, 0xf6 / 255.f, 1};
+constexpr SkColor4f kFuchsia = {0xd9 / 255.f, 0x46 / 255.f, 0xef / 255.f, 1};
+
+cc::PaintFlags GradientFlags(const gfx::RectF& rect) {
+  const SkPoint points[] = {{rect.x(), rect.y()}, {rect.right(), rect.bottom()}};
+  const SkColor4f colors[] = {kBlue, kViolet, kFuchsia};
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setShader(cc::PaintShader::MakeLinearGradient(
+      points, colors, nullptr, 3, SkTileMode::kClamp));
+  return flags;
+}
+
+// A light traveling along the outline of the address bar and of the page, at a
+// constant speed (dashes along the path, not a rotation), its tail fading. It
+// runs only while the AI computes, and not during a game.
+class AssistantLightView : public views::View,
+                           public views::ViewObserver,
+                           public ui::CompositorAnimationObserver,
+                           public HiveyAiEngine::Observer {
+  METADATA_HEADER(AssistantLightView, views::View)
+
+ public:
+  explicit AssistantLightView(BrowserView* browser_view)
+      : browser_view_(browser_view) {
+    SetCanProcessEventsWithinSubtree(false);
+    SetProperty(views::kViewIgnoredByLayoutKey, true);
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    SetVisible(false);
+    parent_observation_.Observe(browser_view);
+    HiveyAiEngine::Get().AddObserver(this);
+  }
+  ~AssistantLightView() override {
+    Stop();
+    HiveyAiEngine::Get().RemoveObserver(this);
+  }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    const double t = (base::TimeTicks::Now() - start_).InSecondsF();
+    if (LocationBarView* location = browser_view_->GetLocationBarView()) {
+      gfx::RectF rect(location->GetLocalBounds());
+      views::View::ConvertRectToTarget(location, this, &rect);
+      DrawLight(canvas, rect, rect.height() / 2, 1.5f, t / 4.2);
+    }
+    if (views::View* page = browser_view_->multi_contents_view()) {
+      gfx::RectF rect(page->GetLocalBounds());
+      views::View::ConvertRectToTarget(page, this, &rect);
+      rect.Outset(1.5f);
+      const float radius =
+          views::LayoutProvider::Get()->GetCornerRadiusMetric(
+              views::ShapeContextTokens::kContentSeparatorRadius) +
+          1.5f;
+      DrawLight(canvas, rect, radius, 2.5f, t / 6.0);
+    }
+  }
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed) override {
+    SetBoundsRect(observed->GetLocalBounds());
+  }
+
+  // ui::CompositorAnimationObserver:
+  void OnAnimationStep(base::TimeTicks timestamp) override { SchedulePaint(); }
+  void OnCompositingShuttingDown(ui::Compositor* compositor) override {
+    Stop();
+  }
+
+  // HiveyAiEngine::Observer:
+  void OnHiveyAiChanged() override {
+    HiveyAiEngine& engine = HiveyAiEngine::Get();
+    if (engine.busy() && !engine.game()) {
+      Start();
+    } else {
+      Stop();
+    }
+  }
+  void OnHiveyAiPending() override {}
+
+ private:
+  void Start() {
+    if (compositor_ || !GetWidget() || !GetWidget()->GetCompositor()) {
+      return;
+    }
+    compositor_ = GetWidget()->GetCompositor();
+    compositor_->AddAnimationObserver(this);
+    start_ = base::TimeTicks::Now();
+    // Above whatever was added since.
+    parent()->ReorderChildView(this, parent()->children().size());
+    SetVisible(true);
+  }
+  void Stop() {
+    if (compositor_) {
+      compositor_->RemoveAnimationObserver(this);
+      compositor_ = nullptr;
+    }
+    SetVisible(false);
+  }
+
+  void DrawLight(gfx::Canvas* canvas,
+                 gfx::RectF rect,
+                 float radius,
+                 float width,
+                 double turns) {
+    rect.Inset(width / 2);
+    if (rect.IsEmpty()) {
+      return;
+    }
+    radius = std::min({radius, rect.width() / 2, rect.height() / 2});
+    const float perimeter =
+        2 * (rect.width() + rect.height()) - 8 * radius +
+        2 * std::numbers::pi_v<float> * radius;
+    const SkPath path = SkPath::RRect(gfx::RectFToSkRect(rect), radius, radius);
+    const float head = static_cast<float>(turns - std::floor(turns)) * perimeter;
+    // The same head for three lengths: the tail fades behind it.
+    const struct {
+      float length;
+      float alpha;
+      float extra;
+    } kLayers[] = {{0.34f, 0.22f, 1.0f}, {0.20f, 0.5f, 0.5f}, {0.08f, 1.0f, 0}};
+    for (const auto& layer : kLayers) {
+      const float on = layer.length * perimeter;
+      const float intervals[] = {on, perimeter - on};
+      cc::PaintFlags flags = GradientFlags(rect);
+      flags.setStyle(cc::PaintFlags::kStroke_Style);
+      flags.setStrokeWidth(width + layer.extra);
+      flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+      flags.setAlphaf(layer.alpha);
+      flags.setPathEffect(cc::PathEffect::MakeDash(
+          intervals, 2, std::fmod(on - head + perimeter, perimeter)));
+      canvas->DrawPath(path, flags);
+    }
+  }
+
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<ui::Compositor> compositor_ = nullptr;
+  base::TimeTicks start_;
+  base::ScopedObservation<views::View, views::ViewObserver> parent_observation_{
+      this};
+};
+
+BEGIN_METADATA(AssistantLightView)
+END_METADATA
+
