+// The ways to reach the Tor network, in the order to try them: "direct",
+// then bridges ("snowflake", "obfs4", "meek"), from the user's choice
+// (Hivey Studio > Privacy; "auto": direct, then Snowflake, then meek).
+std::vector<std::string> ConnectionModes() {
+  std::string choice = "auto";
+  if (PrefService* local_state = g_browser_process->local_state()) {
+    choice = local_state->GetString(kTorBridges);
+  }
+  if (choice == "direct" || choice == "snowflake" || choice == "obfs4" ||
+      choice == "meek") {
+    return {choice};
+  }
+  return {"direct", "snowflake", "meek"};
+}
+
+// tor's options for a bridge `mode`: its built-in bridges and the pluggable
+// transport that reaches them, from pt_config.json (shipped with tor, as in
+// Tor Browser).
+void AppendBridgeOptions(const base::FilePath& tor_dir,
+                         const std::string& mode,
+                         base::CommandLine* command) {
+  std::string json;
+  if (!base::ReadFileToString(tor_dir.AppendASCII("pt_config.json"), &json)) {
+    return;
+  }
+  std::optional<base::Value> config = base::JSONReader::Read(json, 0);
+  if (!config || !config->is_dict()) {
+    return;
+  }
+  const std::string* plugin = config->GetDict().FindStringByDottedPath(
+      mode == "snowflake" ? "pluggableTransports.snowflake"
+                          : "pluggableTransports.lyrebird");
+  const base::ListValue* bridges =
+      config->GetDict().FindListByDottedPath("bridges." + mode);
+  if (!plugin || !bridges) {
+    return;
+  }
+  std::string line = *plugin;
+  base::ReplaceSubstringsAfterOffset(&line, 0, "${pt_path}lyrebird",
+                                     kLyrebird);
+  command->AppendArg("--UseBridges");
+  command->AppendArg("1");
+  command->AppendArg("--ClientTransportPlugin");
+  command->AppendArg(line.substr(line.find(' ') + 1));
+  for (const base::Value& bridge : *bridges) {
+    if (bridge.is_string()) {
+      command->AppendArg("--Bridge");
+      command->AppendArg(bridge.GetString());
+    }
+  }
 }
 
