+// The highest "Bootstrapped N%" in tor's log.
+int BootstrapProgress(const std::string& log) {
+  int progress = 0;
+  for (size_t at = log.find("Bootstrapped "); at != std::string::npos;
+       at = log.find("Bootstrapped ", at + 1)) {
+    const size_t start = at + 13;
+    const size_t end = log.find('%', start);
+    int value = 0;
+    if (end != std::string::npos &&
+        base::StringToInt(log.substr(start, end - start), &value)) {
+      progress = std::max(progress, value);
+    }
+  }
+  return progress;
+}
+
+// Runs on a blocking thread: follows tor's log until it is connected
