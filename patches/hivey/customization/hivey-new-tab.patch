+void HiveyHomeHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getHomeInfo", base::BindRepeating(&HiveyHomeHandler::HandleGetHomeInfo,
+                                         base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "askAssistant", base::BindRepeating(&HiveyHomeHandler::HandleAskAssistant,
+                                          base::Unretained(this)));
+}
+
+void HiveyHomeHandler::HandleGetHomeInfo(const base::ListValue& args) {
+  AllowJavascript();
+  std::string url;
+  TemplateURLService* service = TemplateURLServiceFactory::GetForProfile(
+      Profile::FromWebUI(web_ui()));
+  const TemplateURL* engine =
+      service ? service->GetDefaultSearchProvider() : nullptr;
+  if (engine &&
+      engine->url_ref().SupportsReplacement(service->search_terms_data())) {
+    // The page puts what is typed in place of this word.
+    url = engine->url_ref().ReplaceSearchTerms(
+        TemplateURLRef::SearchTermsArgs(u"HIVEYQUERY"),
+        service->search_terms_data());
+  }
+  ResolveJavascriptCallback(args[0], base::Value(url));
+}
+
+void HiveyHomeHandler::HandleAskAssistant(const base::ListValue& args) {
+  if (args.size() != 2 || !args[0].is_string() || !args[1].is_string()) {
+    return;
+  }
+  const std::string& mode = args[0].GetString();
+  if (mode != "ask" && mode != "agent") {
+    return;
+  }
+  Profile* profile = Profile::FromWebUI(web_ui());
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)->enabled_extensions().GetByID(
+          HIVEY_BUNDLED_AI_ID);
+  if (!extension) {
+    return;
+  }
+  // The sidebar takes it from there, whether its panel is open or not yet.
+  base::DictValue action;
+  action.Set("action", mode);
+  action.Set("text", args[1].GetString());
+  action.Set("ts", base::Time::Now().InMillisecondsFSinceUnixEpoch());
+  base::DictValue values;
+  values.Set("pendingAction", std::move(action));
+  extensions::StorageFrontend::Get(profile)->Set(
+      base::WrapRefCounted(extension), extensions::StorageAreaNamespace::kLocal,
+      std::move(values),
+      base::BindOnce(&HiveyHomeHandler::ShowPanel, weak_factory_.GetWeakPtr(),
+                     mode));
+}
+
+void HiveyHomeHandler::ShowPanel(
+    const std::string& mode,
+    extensions::StorageFrontend::ResultStatus status) {
+  if (!status.success) {
+    return;
+  }
+  BrowserWindowInterface* browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents());
+  if (!browser) {
+    return;
+  }
+  SidePanelUI* side_panel = SidePanelUI::From(browser);
+  extensions::ExtensionSidePanelManager* manager =
+      extensions::ExtensionSidePanelManager::From(browser);
+  extensions::ExtensionSidePanelCoordinator* coordinator =
+      manager ? manager->GetCoordinator(HIVEY_BUNDLED_AI_ID) : nullptr;
+  if (!side_panel || !coordinator) {
+    return;
+  }
+  coordinator->ShowHiveyMode(mode == "agent" ? "agent" : "chat");
+  side_panel->Show(
+      SidePanelEntryKey(SidePanelEntryId::kExtension, HIVEY_BUNDLED_AI_ID),
+      SidePanelOpenTrigger::kExtension);
+}
