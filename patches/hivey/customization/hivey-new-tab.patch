+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+// Hivey's new tab: what is typed goes to the web, to the assistant's chat or
+// to its agent. The assistant's panel opens only for those two.
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+const STRINGS = {
+  en: {
+    title: 'New Tab',
+    web: 'Search',
+    ask: 'Ask the AI',
+    agent: 'Give to the agent',
+    go: 'Go',
+    modes: 'What to do with what you type',
+    placeholder_web: 'Search the web or type an address',
+    placeholder_ask: 'Ask the AI a question',
+    placeholder_agent: 'Describe a task for the agent',
+  },
+  fr: {
+    title: 'Nouvel onglet',
+    web: 'Rechercher',
+    ask: 'Demander à l\'IA',
+    agent: 'Confier à l\'agent',
+    go: 'Lancer',
+    modes: 'Que faire de ta saisie',
+    placeholder_web: 'Rechercher sur le web ou saisir une adresse',
+    placeholder_ask: 'Poser une question à l\'IA',
+    placeholder_agent: 'Décrire une tâche à confier à l\'agent',
+  },
+};
+const lang = navigator.language.toLowerCase().startsWith('fr') ? 'fr' : 'en';
+const t = STRINGS[lang];
+const QUERY = 'HIVEYQUERY';
+// Only if the browser has no search engine to give.
+const FALLBACK_SEARCH = `https://duckduckgo.com/?q=${QUERY}`;
+
+const input = document.getElementById('q');
+const chips = [...document.querySelectorAll('.chip')];
+let mode = 'web';
+let searchUrl = FALLBACK_SEARCH;
+
+// An address goes straight to its site; anything else is a search. Only http
+// and https: "javascript:..." and the like are searched for.
+function addressOf(text) {
+  if (/\s/.test(text)) {
+    return null;
+  }
+  let candidate = null;
+  if (/^https?:\/\//i.test(text)) {
+    candidate = text;
+  } else if (/^(localhost|\d{1,3}(\.\d{1,3}){3})(:\d+)?([/?#].*)?$/i.test(text)) {
+    candidate = `http://${text}`;
+  } else if (/^([a-z0-9-]+\.)+[a-z]{2,}(:\d+)?([/?#].*)?$/i.test(text)) {
+    candidate = `https://${text}`;
+  }
+  if (!candidate) {
+    return null;
+  }
+  try {
+    return new URL(candidate).href;
+  } catch {
+    return null;
+  }
+}
+
+function setMode(next) {
+  mode = next;
+  for (const chip of chips) {
+    chip.setAttribute('aria-pressed', String(chip.dataset.mode === next));
+  }
+  input.placeholder = t[`placeholder_${next}`];
+  input.setAttribute('aria-label', t[`placeholder_${next}`]);
+}
+
+document.documentElement.lang = lang;
+document.title = t.title;
+document.getElementById('go').setAttribute('aria-label', t.go);
+document.getElementById('modes').setAttribute('aria-label', t.modes);
+for (const chip of chips) {
+  chip.textContent = t[chip.dataset.mode];
+  chip.addEventListener('click', () => {
+    setMode(chip.dataset.mode);
+    input.focus();
+  });
+}
+setMode('web');
+
+document.getElementById('form').addEventListener('submit', event => {
+  event.preventDefault();
+  const text = input.value.trim();
+  if (!text) {
+    input.focus();
+    return;
+  }
+  if (mode !== 'web') {
+    chrome.send('askAssistant', [mode, text]);
+    input.value = '';
+    return;
+  }
+  location.assign(addressOf(text) ||
+                  searchUrl.replace(QUERY, encodeURIComponent(text)));
+});
+
+sendWithPromise('getHomeInfo').then(url => {
+  if (url && url.includes(QUERY)) {
+    searchUrl = url;
+  }
+});
