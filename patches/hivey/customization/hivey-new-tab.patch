--- a/chrome/browser/resources/hivey_studio/home.css
+++ b/chrome/browser/resources/hivey_studio/home.css
@@ -0,0 +1,184 @@
+/* Copyright 2026 The Hivey Browser contributors
+ * Use of this source code is governed by the MIT license that can be found in
+ * the LICENSE file of the Hivey Browser repository. */
+
+/* Hivey's new tab: one search field on Hivey Settings' gradient, in the
+ * browser's colors. Things move when the page opens and when the user acts;
+ * at rest nothing runs. */
+
+:root {
+  --bg: var(--color-new-tab-page-background, #0f111a);
+  --text: var(--color-new-tab-page-text, #f4f2fc);
+  --accent: var(--color-sys-primary, #7c6cf6);
+  --accent-2: color-mix(in oklch, var(--accent) 60%, #a855f7);
+  --accent-3: color-mix(in oklch, var(--accent) 60%, #3b82f6);
+  --muted: color-mix(in srgb, var(--text) 62%, var(--bg));
+  --line: color-mix(in srgb, var(--text) 18%, transparent);
+  --ease: cubic-bezier(.16, 1, .3, 1);
+}
+
+html,
+body {
+  height: 100%;
+  margin: 0;
+  background: var(--bg);
+  color: var(--text);
+  font: 15px/1.5 system-ui, 'Segoe UI Variable Text', 'Segoe UI', Ubuntu, Cantarell, sans-serif;
+  -webkit-font-smoothing: antialiased;
+}
+
+/* The same gradient as Hivey Settings. */
+.aura {
+  position: fixed;
+  inset: 0;
+  pointer-events: none;
+  background:
+    radial-gradient(620px circle at 0% 0%, color-mix(in srgb, var(--accent-2) 22%, transparent), transparent 60%),
+    radial-gradient(520px circle at 100% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%);
+}
+
+main {
+  position: relative;
+  min-height: 100%;
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 22px;
+  padding: 24px 16px 12vh;
+}
+
+.mark {
+  width: 64px;
+  height: 64px;
+  filter: drop-shadow(0 0 22px color-mix(in srgb, var(--accent-2) 70%, transparent));
+}
+.mark rect {
+  transform-box: fill-box;
+  transform-origin: center;
+  animation: bar-in .9s var(--ease) backwards;
+}
+.mark rect:nth-child(2) { animation-delay: .07s; }
+.mark rect:nth-child(3) { animation-delay: .14s; }
+.mark rect:nth-child(4) { animation-delay: .21s; }
+
+form {
+  width: min(640px, 100%);
+  display: grid;
+  gap: 12px;
+}
+
+/* A colored ring lights up around the field, and turns once when focused. */
+.field {
+  position: relative;
+  overflow: hidden;
+  isolation: isolate;
+  padding: 1.5px;
+  border-radius: 30px;
+  background: var(--line);
+  box-shadow: 0 8px 40px -14px color-mix(in srgb, var(--accent-2) 70%, transparent);
+  animation: rise .7s var(--ease) .1s backwards;
+}
+.field::before {
+  content: "";
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  width: 110%;
+  aspect-ratio: 1;
+  z-index: -1;
+  opacity: 0;
+  transform: translate(-50%, -50%);
+  background: conic-gradient(var(--accent-3), var(--accent), var(--accent-2), var(--accent-3));
+  transition: opacity .3s;
+}
+.field:hover::before { opacity: .55; }
+.field:focus-within::before {
+  opacity: 1;
+  animation: spin 1.6s var(--ease);
+}
+.field-in {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: 56px;
+  padding: 6px 8px 6px 20px;
+  border-radius: 29px;
+  background: color-mix(in srgb, var(--bg) 90%, #000);
+}
+.glass {
+  flex: none;
+  color: var(--muted);
+}
+#q {
+  flex: 1;
+  min-width: 0;
+  min-height: 40px;
+  border: 0;
+  outline: none;
+  background: none;
+  color: var(--text);
+  font: inherit;
+  font-size: 18px;
+}
+#q::placeholder { color: var(--muted); }
+.go {
+  flex: none;
+  width: 44px;
+  height: 44px;
+  display: grid;
+  place-items: center;
+  border: 0;
+  border-radius: 50%;
+  color: #fff;
+  background: linear-gradient(135deg, var(--accent-3), var(--accent), var(--accent-2));
+  cursor: pointer;
+  transition: transform .2s var(--ease);
+}
+.go:hover { transform: scale(1.06); }
+
+.modes {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 6px;
+  animation: rise .7s var(--ease) .18s backwards;
+}
+.chip {
+  min-height: 36px;
+  padding: 4px 14px;
+  border: 0;
+  border-radius: 18px;
+  color: var(--muted);
+  background: none;
+  box-shadow: inset 0 0 0 1px var(--line);
+  font: inherit;
+  font-size: 13px;
+  cursor: pointer;
+  transition: color .15s;
+}
+.chip:hover { color: var(--text); }
+.chip[aria-pressed="true"] {
+  color: #fff;
+  background: linear-gradient(90deg, var(--accent-3), var(--accent), var(--accent-2));
+  box-shadow: none;
+}
+:focus-visible {
+  outline: 2px solid var(--text);
+  outline-offset: 2px;
+}
+#q:focus-visible { outline: none; }
+
+@keyframes bar-in { from { transform: scaleX(.2); opacity: 0; } }
+@keyframes rise { from { transform: translateY(8px); opacity: 0; } }
+@keyframes spin {
+  from { transform: translate(-50%, -50%) rotate(0); }
+  to { transform: translate(-50%, -50%) rotate(360deg); }
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *::before {
+    animation: none !important;
+    transition: none !important;
+  }
+}
