+// The toolbar, like Firefox's: the buttons in any order (the address bar
+// too), Back, Reload and the extensions hidden or shown.
+const TOOLBAR_ITEMS = ['back', 'forward', 'reload', 'home', 'location', 'extensions', 'pinned', 'avatar', 'menu'];
+const TOOLBAR_LABELS = {back: 'tbBack', forward: 'tbForward', reload: 'tbReload', home: 'tbHome',
+                        location: 'tbLocation', extensions: 'tbExtensions', pinned: 'tbPinned',
+                        avatar: 'tbAvatar', menu: 'tbMenu'};
+// Forward and Home have Chromium's own settings.
+const TOOLBAR_PREFS = {forward: 'browser.show_forward_button', home: 'browser.show_home_button'};
+
+function toolbarCard() {
+  if (!hasPref('hivey.toolbar.order')) {
+    return null;
+  }
+  const saved = pref('hivey.toolbar.order') || [];
+  const order = [...saved.filter(id => TOOLBAR_ITEMS.includes(id)),
+                 ...TOOLBAR_ITEMS.filter(id => !saved.includes(id))];
+  const hidden = pref('hivey.toolbar.hidden') || [];
+  const send = (newOrder, newHidden) => chrome.send('setToolbarLayout', [newOrder, newHidden]);
+  const move = (from, to) => {
+    if (to < 0 || to >= order.length || from === to) {
+      return;
+    }
+    const next = [...order];
+    next.splice(to, 0, next.splice(from, 1)[0]);
+    send(next, hidden);
+  };
+  const isShown = id => TOOLBAR_PREFS[id] ? pref(TOOLBAR_PREFS[id]) !== false : !hidden.includes(id);
+  const toggle = id => {
+    if (TOOLBAR_PREFS[id]) {
+      setPref(TOOLBAR_PREFS[id], !isShown(id));
+    } else {
+      send(order, hidden.includes(id) ? hidden.filter(h => h !== id) : [...hidden, id]);
+    }
+  };
+  const rows = order.map((id, index) => {
+    const title = t(TOOLBAR_LABELS[id]);
+    const hideable = !['location', 'menu', 'avatar'].includes(id);
+    const shown = isShown(id);
+    const row = el('div', {class: `bar-item${shown ? '' : ' off'}`, draggable: 'true', 'data-key': `toolbar-${id}`},
+                   el('span', {class: 'grip', 'aria-hidden': 'true'}, icon('grip')),
+                   el('span', {class: 'row-text'}, el('span', {class: 'row-label', text: title})),
+                   el('button', {class: 'icon-button', title: t('moveUp'), 'aria-label': `${t('moveUp')} ${title}`,
+                                 disabled: index === 0, onclick: () => move(index, index - 1)}, icon('up')),
+                   el('button', {class: 'icon-button', title: t('moveDown'), 'aria-label': `${t('moveDown')} ${title}`,
+                                 disabled: index === order.length - 1, onclick: () => move(index, index + 1)},
+                      icon('down')),
+                   hideable ? el('button', {class: 'icon-button', title: t(shown ? 'barHide' : 'barShow'),
+                                            'aria-label': `${t(shown ? 'barHide' : 'barShow')} ${title}`,
+                                            'aria-pressed': shown ? 'true' : 'false', onclick: () => toggle(id)},
+                                 icon(shown ? 'eye' : 'eyeOff'))
+                            : el('span', {class: 'icon-button', 'aria-hidden': 'true'}));
+    row.addEventListener('dragstart', e => {
+      e.dataTransfer.setData('text/plain', String(index));
+      row.classList.add('dragging');
+    });
+    row.addEventListener('dragend', () => row.classList.remove('dragging'));
+    row.addEventListener('dragover', e => e.preventDefault());
+    row.addEventListener('drop', e => {
+      e.preventDefault();
+      move(Number(e.dataTransfer.getData('text/plain')), index);
+    });
+    return row;
+  });
+  return card(t('toolbarTitle'),
+              el('p', {class: 'muted small', text: t('toolbarHint')}),
+              el('div', {class: 'bar-list'}, ...rows),
+              linkRow({label: t('customizeToolbar'), hint: t('customizeToolbarHint'),
+                       onClick: () => chrome.send('openCustomizeToolbar')}),
+              el('div', {class: 'actions'},
+                 el('button', {class: 'button ghost', text: t('toolbarReset'), onclick: () => send([], [])})));
+}
