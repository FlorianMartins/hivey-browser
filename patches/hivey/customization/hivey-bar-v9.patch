+  // Google Translate, on demand only (the location bar's Translate button,
+  // the context menu): Chromium's own translation, which ungoogled-chromium
+  // enables with these switches. Pages are never offered a translation
+  // (translate.enabled is off), so nothing is sent until the user asks.
+  base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(translate::switches::kTranslateScriptURL)) {
+    command_line->AppendSwitchASCII(
+        translate::switches::kTranslateScriptURL,
+        "https://translate.googleapis.com/translate_a/element.js");
+    command_line->AppendSwitchASCII(
+        translate::switches::kTranslateSecurityOrigin,
+        "https://translate.googleapis.com/");
+  }
+}
