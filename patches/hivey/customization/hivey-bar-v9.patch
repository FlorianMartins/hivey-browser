+// The modern (solid) glyph of a built-in item, if it has one.
+template <typename T>
+gfx::ImageSkia ModernIcon(const T& item) {
+  return item.modern_png ? DecodeIcon(item.modern_png, item.modern_size)
+                         : gfx::ImageSkia();
+}
+
+// `color` turned on the color wheel by `hue` (0-1), more saturated by
+// `saturation`, lighter by `lightness`.
+SkColor ShiftColor(SkColor color, double hue, double saturation,
+                   double lightness) {
+  color_utils::HSL hsl;
+  color_utils::SkColorToHSL(color, &hsl);
+  hsl.h = std::fmod(hsl.h + hue + 1.0, 1.0);
+  hsl.s = std::clamp(hsl.s + saturation, 0.0, 1.0);
+  hsl.l = std::clamp(hsl.l + lightness, 0.0, 1.0);
+  return color_utils::HSLToSkColor(hsl, SK_AlphaOPAQUE);
+}
+
