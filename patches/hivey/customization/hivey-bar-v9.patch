+void ToolbarView::ApplyHiveyToolbarLayout() {
+  if (display_mode_ != DisplayMode::kNormal) {
+    return;
+  }
+  const PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  // The buttons the user places, in Chromium's order.
+  const std::pair<std::string_view, views::View*> items[] = {
+      {"back", back_},
+      {"forward", forward_},
+      {"reload", reload_},
+      {"home", home_},
+      {"location", location_bar_view_},
+      {"extensions", extensions_container_},
+      {"pinned", pinned_toolbar_actions_container_},
+      {"avatar", avatar_},
+      {"menu", app_menu_button_},
+  };
+  std::vector<views::View*> ordered;
+  for (const base::Value& id : prefs->GetList(hivey::kHiveyToolbarOrder)) {
+    for (const auto& [name, view] : items) {
+      if (view && view->parent() == this && id.is_string() &&
+          id.GetString() == name && !std::ranges::contains(ordered, view)) {
+        ordered.push_back(view);
+      }
+    }
+  }
+  for (const auto& [name, view] : items) {
+    if (view && view->parent() == this &&
+        !std::ranges::contains(ordered, view)) {
+      ordered.push_back(view);
+    }
+  }
+  // Each of them takes the place of one of them: the rest of the toolbar
+  // (dividers, media, overflow) stays where it is.
+  std::vector<views::View*> order(children().begin(), children().end());
+  size_t next = 0;
+  for (views::View*& child : order) {
+    if (std::ranges::contains(ordered, child)) {
+      child = ordered[next++];
+    }
+  }
+  for (size_t i = 0; i < order.size(); ++i) {
+    ReorderChildView(order[i], i);
+  }
+  // Hidden buttons (Forward and Home follow their own settings).
+  const base::ListValue& hidden = prefs->GetList(hivey::kHiveyToolbarHidden);
+  for (const auto& [name, view] : items) {
+    if (!view ||
+        !(name == "back" || name == "reload" || name == "extensions" ||
+          name == "pinned")) {
+      continue;
+    }
+    const std::string id(name);
+    if (hidden.contains(id)) {
+      hivey_hidden_.insert(id);
+      view->SetVisible(false);
+    } else if (hivey_hidden_.erase(id)) {
+      view->SetVisible(true);
+    }
+  }
+  InvalidateLayout();
+}
