+void HiveyStudioHandler::HandleSetToolbarLayout(const base::ListValue& args) {
+  // [order, hidden]: lists of toolbar button ids ([], []: Chromium's toolbar).
+  if (args.size() != 2 || !args[0].is_list() || !args[1].is_list()) {
+    return;
+  }
+  constexpr std::string_view kIds[] = {"back",       "forward", "reload",
+                                       "home",       "location", "extensions",
+                                       "pinned",     "avatar",  "menu"};
+  auto ids = [&](const base::ListValue& list) {
+    base::ListValue clean;
+    for (const base::Value& id : list) {
+      if (id.is_string() && std::ranges::contains(kIds, id.GetString()) &&
+          !clean.contains(id.GetString())) {
+        clean.Append(id.GetString());
+      }
+    }
+    return clean;
+  };
+  PrefService* prefs = GetProfile()->GetPrefs();
+  prefs->SetList(hivey::kHiveyToolbarOrder, ids(args[0].GetList()));
+  prefs->SetList(hivey::kHiveyToolbarHidden, ids(args[1].GetList()));
+}
