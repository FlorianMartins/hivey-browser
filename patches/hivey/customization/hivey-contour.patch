+
+namespace hivey {
+
+namespace {
+enum Choice { kPrivateWindow = 1, kTorWindow };
+}  // namespace
+
+PrivateButton::PrivateButton(Profile* profile, const ui::ImageModel& tor_icon)
+    : ToolbarButton(base::BindRepeating(&PrivateButton::ShowChoices,
+                                        base::Unretained(this))),
+      profile_(profile),
+      choices_(std::make_unique<ui::SimpleMenuModel>(this)) {
+  const std::u16string name =
+      l10n_util::GetStringUTF16(IDS_NEW_INCOGNITO_WINDOW);
+  choices_->AddItemWithIcon(
+      kPrivateWindow, name,
+      ui::ImageModel::FromVectorIcon(kIncognitoIcon, ui::kColorMenuIcon, 16));
+  choices_->AddItemWithIcon(kTorWindow,
+                            l10n_util::GetStringUTF16(IDS_HIVEY_TOR_WINDOW),
+                            tor_icon);
+  SetVectorIcons(kIncognitoIcon, kIncognitoIcon);
+  SetTooltipText(name);
+  GetViewAccessibility().SetName(name);
+}
+
+PrivateButton::~PrivateButton() = default;
+
+void PrivateButton::ShowChoices() {
+  runner_ = std::make_unique<views::MenuRunner>(
+      choices_.get(), views::MenuRunner::HAS_MNEMONICS);
+  runner_->RunMenuAt(GetWidget(), nullptr, GetAnchorBoundsInScreen(),
+                     views::MenuAnchorPosition::kTopRight,
+                     ui::mojom::MenuSourceType::kNone);
+}
+
+void PrivateButton::ExecuteCommand(int command_id, int event_flags) {
+  if (command_id == kPrivateWindow) {
+    chrome::NewIncognitoWindow(profile_);
+  } else {
+    OpenTorWindow(GURL());
+  }
+}
+
+BEGIN_METADATA(PrivateButton)
+END_METADATA
