+  // Over the page, drawn by the browser: a page cannot imitate it. The badge
+  // says what the AI does with this page; while it reads, a line goes over it.
+  void DrawActivity(gfx::Canvas* canvas,
+                    gfx::RectF rect,
+                    float radius,
+                    double t) {
+    const HiveyAiEngine& engine = HiveyAiEngine::Get();
+    content::WebContents* contents = browser_view_->GetActiveWebContents();
+    if (engine.activity().empty() || !contents ||
+        (engine.activity_tab() != -1 &&
+         sessions::SessionTabHelper::IdForTab(contents).id() !=
+             engine.activity_tab())) {
+      return;
+    }
+    // The halo, along the edges.
+    for (const auto& [width, alpha] :
+         {std::pair<float, float>{28, .05f}, {16, .06f}, {8, .08f}}) {
+      cc::PaintFlags halo = GradientFlags(rect);
+      halo.setStyle(cc::PaintFlags::kStroke_Style);
+      halo.setStrokeWidth(width);
+      halo.setAlphaf(alpha);
+      canvas->DrawPath(SkPath::RRect(gfx::RectFToSkRect(rect), radius, radius),
+                       halo);
+    }
+    if (engine.activity() == "reading") {
+      // Down and up again, slowing at both ends.
+      const double phase = std::fmod(t / 3.2, 2.0);
+      const double there = phase < 1 ? phase : 2 - phase;
+      const double eased = (1 - std::cos(there * std::numbers::pi)) / 2;
+      constexpr float kBand = 120;
+      const float bottom =
+          rect.y() + static_cast<float>(eased) * rect.height();
+      const float top = std::max(rect.y(), bottom - kBand);
+      const SkPoint band[] = {{rect.x(), bottom - kBand}, {rect.x(), bottom}};
+      const SkColor4f band_colors[] = {{kViolet.fR, kViolet.fG, kViolet.fB, 0},
+                                       {kViolet.fR, kViolet.fG, kViolet.fB, .2f}};
+      cc::PaintFlags fill;
+      fill.setShader(cc::PaintShader::MakeLinearGradient(
+          band, band_colors, nullptr, 2, SkTileMode::kClamp));
+      canvas->DrawRect(gfx::RectF(rect.x(), top, rect.width(), bottom - top),
+                       fill);
+      canvas->DrawRect(gfx::RectF(rect.x(), bottom - 2, rect.width(), 2),
+                       GradientFlags(rect));
+    }
+    const gfx::FontList font;
+    const int text_width = gfx::GetStringWidth(engine.activity_label(), font);
+    gfx::RectF badge(rect.right() - 12 - text_width - 18, rect.y() + 12,
+                     text_width + 18, font.GetHeight() + 8);
+    canvas->DrawRoundRect(badge, 6, GradientFlags(badge));
+    canvas->DrawStringRectWithFlags(
+        engine.activity_label(), font, SK_ColorWHITE,
+        gfx::ToEnclosedRect(badge), gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
