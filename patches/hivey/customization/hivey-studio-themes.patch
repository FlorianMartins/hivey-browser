+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+// The Hivey Browser logo (brand/logo.svg: a honeycomb cell holding a globe and
+// its orbit) in the theme's accent color, the same drawing as the window icon
+// (chrome/browser/hivey/hivey_app_icon.cc).
+
+const NS = 'http://www.w3.org/2000/svg';
+const CELL = 'M116 14.9 Q128 8 140 14.9 L218.9 60.5 Q230.9 67.4 230.9 81.3 L230.9 174.7 ' +
+    'Q230.9 188.6 218.9 195.5 L140 241.1 Q128 248 116 241.1 L37.1 195.5 Q25.1 188.6 25.1 174.7 ' +
+    'L25.1 81.3 Q25.1 67.4 37.1 60.5 Z';
+
+function node(tag, attributes) {
+  const element = document.createElementNS(NS, tag);
+  for (const [key, value] of Object.entries(attributes)) {
+    element.setAttribute(key, value);
+  }
+  return element;
+}
+
+export function hiveyLogo() {
+  const svg = node('svg', {viewBox: '0 0 256 256', 'aria-hidden': 'true', class: 'hivey-logo'});
+  svg.append(node('path', {d: CELL, fill: 'var(--accent)'}));
+  const orbit = node('g', {transform: 'rotate(-28 128 128)', fill: 'none', 'stroke-linecap': 'round'});
+  orbit.append(node('path', {
+    d: 'M40 128 A88 30 0 0 1 216 128',
+    stroke: 'color-mix(in srgb, black 80%, var(--accent))', 'stroke-width': '16', opacity: '0.35',
+  }));
+  svg.append(orbit);
+  svg.append(node('circle', {cx: '128', cy: '128', r: '62', fill: 'color-mix(in srgb, black 80%, var(--accent))'}));
+  const front = node('g', {transform: 'rotate(-28 128 128)', fill: 'none', 'stroke-linecap': 'round'});
+  front.append(node('path', {
+    d: 'M40 128 A88 30 0 0 0 216 128',
+    stroke: 'color-mix(in srgb, white 70%, var(--accent))', 'stroke-width': '12',
+  }));
+  svg.append(front);
+  svg.append(node('circle', {
+    cx: '106', cy: '104', r: '12', fill: 'color-mix(in srgb, white 70%, var(--accent))', opacity: '0.9',
+  }));
+  return svg;
+}
