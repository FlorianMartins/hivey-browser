+
+void HiveyStudioHandler::ScheduleStateChanged() {
+  if (state_change_pending_) {
+    return;
+  }
+  state_change_pending_ = true;
+  // After the current task, so the new colors are resolved and several
+  // changes at once send one update.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<HiveyStudioHandler> handler) {
+                       if (handler) {
+                         handler->state_change_pending_ = false;
+                         handler->FireStateChanged();
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
 }
 
