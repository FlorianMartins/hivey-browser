+function palette() {
+  return state.colors.palette;
+}
+
+function luminance(hex) {
+  const n = parseInt(hex.slice(1), 16);
+  const [r, g, b] = [n >> 16, (n >> 8) & 255, n & 255].map(v => v / 255);
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+}
+
+// Hivey Studio takes the theme the browser draws with, like Settings does.
+function applyTheme() {
+  const colors = palette();
+  const root = document.documentElement.style;
+  root.setProperty('--bg', colors.page);
+  root.setProperty('--text', colors.page_text);
+  root.setProperty('--accent', colors.accent);
+  root.setProperty('--user', colors.accent);
+  root.setProperty('color-scheme', luminance(colors.page) < 0.5 ? 'dark' : 'light');
+}
+
+async function pickColor(element) {
+  if (!('EyeDropper' in window)) {
+    return;
+  }
+  try {
+    // The eye dropper picks any pixel on the screen, also outside the browser.
+    const {sRGBHex} = await new EyeDropper().open();
+    chrome.send('setColor', [element, sRGBHex.toLowerCase()]);
+  } catch {
+    // Cancelled with Escape.
+  }
 }
 
