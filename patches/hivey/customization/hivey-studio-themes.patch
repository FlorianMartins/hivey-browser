+void HiveyStudioHandler::HandleSetColor(const base::ListValue& args) {
+  // [element, "#rrggbb"] sets one element's color; "" goes back to the
+  // theme's.
+  const std::string* element = args[0].GetIfString();
+  const std::string* hex = args[1].GetIfString();
+  if (!element || !hex ||
+      std::ranges::find(hivey::kHiveyColorElements, *element) ==
+          std::end(hivey::kHiveyColorElements)) {
+    return;
+  }
+  base::DictValue colors =
+      g_browser_process->local_state()->GetDict(hivey::kHiveyColors).Clone();
+  if (hex->empty()) {
+    colors.Remove(*element);
+  } else if (hivey::ParseHexColor(*hex)) {
+    colors.Set(*element, *hex);
+  } else {
+    return;
+  }
+  g_browser_process->local_state()->SetDict(hivey::kHiveyColors,
+                                            std::move(colors));
+}
+
+void HiveyStudioHandler::HandleSetAccent(const base::ListValue& args) {
+  // The accent drives both the Material palette (user color) and the
+  // accent override, so every surface agrees.
+  const std::string* hex = args[0].GetIfString();
+  const std::optional<SkColor> color = hex ? HexToColor(*hex) : std::nullopt;
+  if (!color) {
+    return;
+  }
+  ThemeService* theme = ThemeServiceFactory::GetForProfile(GetProfile());
+  theme->SetUserColorAndBrowserColorVariant(
+      *color, theme->GetBrowserColorVariant() ==
+                      ui::mojom::BrowserColorVariant::kSystem
+                  ? ui::mojom::BrowserColorVariant::kTonalSpot
+                  : theme->GetBrowserColorVariant());
+  base::DictValue colors =
+      g_browser_process->local_state()->GetDict(hivey::kHiveyColors).Clone();
+  if (!colors.empty()) {
+    colors.Set("accent", *hex);
+    g_browser_process->local_state()->SetDict(hivey::kHiveyColors,
+                                              std::move(colors));
+  }
+}
+
+void HiveyStudioHandler::HandleApplyPreset(const base::ListValue& args) {
+  const std::string* name = args[0].GetIfString();
+  if (!name) {
+    return;
+  }
+  base::DictValue colors = hivey::GetHiveyColorPreset(*name);
+  ThemeService* theme = ThemeServiceFactory::GetForProfile(GetProfile());
+  if (*name == "material") {
+    theme->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kSystem);
+  } else if (colors.empty()) {
+    return;  // Unknown preset.
+  } else {
+    theme->SetBrowserColorScheme(*name == "daylight"
+                                     ? ThemeService::BrowserColorScheme::kLight
+                                     : ThemeService::BrowserColorScheme::kDark);
+    if (const std::string* accent = colors.FindString("accent")) {
+      if (std::optional<SkColor> color = HexToColor(*accent)) {
+        theme->SetUserColorAndBrowserColorVariant(
+            *color, ui::mojom::BrowserColorVariant::kTonalSpot);
+      }
+    }
+  }
+  g_browser_process->local_state()->SetDict(hivey::kHiveyColors,
+                                            std::move(colors));
+}
+
+void HiveyStudioHandler::HandleSetSecurity(const base::ListValue& args) {
+  // ["hardened", bool]: no V8 optimizing compilers (JIT), where most V8
+  // exploits live; ["devices", bool]: block web access to USB, HID, serial
+  // and Bluetooth devices (or ask).
+  const std::string* name = args[0].GetIfString();
+  if (!name || !args[1].is_bool()) {
+    return;
+  }
+  const bool on = args[1].GetBool();
+  HostContentSettingsMap* map =
+      HostContentSettingsMapFactory::GetForProfile(GetProfile());
+  if (*name == "hardened") {
+    map->SetDefaultContentSetting(ContentSettingsType::JAVASCRIPT_OPTIMIZER,
+                                  on ? CONTENT_SETTING_BLOCK
+                                     : CONTENT_SETTING_ALLOW);
+  } else if (*name == "devices") {
+    for (ContentSettingsType type :
+         {ContentSettingsType::USB_GUARD, ContentSettingsType::HID_GUARD,
+          ContentSettingsType::SERIAL_GUARD,
+          ContentSettingsType::BLUETOOTH_GUARD,
+          ContentSettingsType::BLUETOOTH_SCANNING}) {
+      map->SetDefaultContentSetting(
+          type, on ? CONTENT_SETTING_BLOCK : CONTENT_SETTING_ASK);
+    }
+  }
+}
