+void HiveyStudioHandler::OnJavascriptAllowed() {
+  Profile* profile = GetProfile();
+  auto refresh = base::BindRepeating(&HiveyStudioHandler::ScheduleStateChanged,
+                                     base::Unretained(this));
+  profile_prefs_.Init(profile->GetPrefs());
+  local_state_prefs_.Init(g_browser_process->local_state());
+  for (const AllowedPref& pref : kAllowedPrefs) {
+    PrefChangeRegistrar& registrar =
+        pref.local_state ? local_state_prefs_ : profile_prefs_;
+    if (registrar.prefs()->FindPreference(pref.name)) {
+      registrar.Add(pref.name, refresh);
+    }
+  }
+  local_state_prefs_.Add(hivey::kHiveyColors, refresh);
+  // chrome://flags and Hivey Studio both store flags here.
+  local_state_prefs_.Add("browser.enabled_labs_experiments", refresh);
+  theme_observation_.Observe(ThemeServiceFactory::GetForProfile(profile));
+  content_settings_observation_.Observe(
+      HostContentSettingsMapFactory::GetForProfile(profile));
 }
 
 void HiveyStudioHandler::OnJavascriptDisallowed() {
   usage_observer_.reset();
+  profile_prefs_.RemoveAll();
+  local_state_prefs_.RemoveAll();
+  theme_observation_.Reset();
+  content_settings_observation_.Reset();
+  weak_factory_.InvalidateWeakPtrs();
+  state_change_pending_ = false;
+}
