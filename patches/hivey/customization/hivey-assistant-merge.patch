+constexpr size_t kMaxPageBytes = 2 * 1024 * 1024;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("hivey_assistant_pages", R"(
+      semantics {
+        sender: "Hivey assistant"
+        description: "Searches the web and reads the pages found, for the "
+          "answer the user asked for."
+        trigger: "A question to the assistant that needs the web."
+        data: "The search terms."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "The assistant's web settings."
+        policy_exception_justification: "Not implemented."
+      })");
+
+class Bridge : public HiveyAiEngine::Observer,
+               public extensions::ExtensionRegistryObserver {
+ public:
+  explicit Bridge(Profile* profile) : profile_(profile) {
+    registry_observation_.Observe(extensions::ExtensionRegistry::Get(profile));
+    HiveyAiEngine::Get().AddObserver(this);
+    Write();
+  }
+
+  void OnStorageChanged(const base::Value& changes) {
+    const base::DictValue* dict = changes.GetIfDict();
+    if (!dict) {
+      return;
+    }
+    if (const base::DictValue* request = dict->FindDict("hiveyAiRequest")) {
+      const std::string* action =
+          request->FindStringByDottedPath("newValue.action");
+      if (action && *action == "download") {
+        HiveyAiEngine::Get().DownloadModel();
+      } else if (action && *action == "start") {
+        HiveyAiEngine::Get().Start();
+      }
+    }
+    if (const base::DictValue* agent = dict->FindDict("hiveyAiAgent")) {
+      SetAgentSites(agent->FindBool("newValue").value_or(false));
+    }
+    if (const base::DictValue* fetch = dict->FindDict("hiveyAiFetch")) {
+      const std::string* id = fetch->FindStringByDottedPath("newValue.id");
+      const std::string* url = fetch->FindStringByDottedPath("newValue.url");
+      if (id && url) {
+        Fetch(*id, GURL(*url));
+      }
+    }
+    if (const base::DictValue* busy = dict->FindDict("hiveyAiBusy")) {
+      const std::optional<bool> value = busy->FindBool("newValue");
+      HiveyAiEngine::Get().SetBusy(value.value_or(false));
+    }
+  }
+
+  // HiveyAiEngine::Observer:
+  void OnHiveyAiChanged() override { Write(); }
+  void OnHiveyAiPending() override {}
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionReady(content::BrowserContext* browser_context,
+                        const extensions::Extension* extension) override {
+    if (extension->id() == HIVEY_BUNDLED_AI_ID) {
+      // A browser stopped while the agent worked.
+      if (profile_->GetPrefs()->GetBoolean(kHiveyAgentSitesOpen)) {
+        SetAgentSites(false);
+      }
+      Write();
+    }
+  }
+
+ private:
+  const extensions::Extension* Assistant() {
+    return extensions::ExtensionRegistry::Get(profile_)
+        ->enabled_extensions()
+        .GetByID(HIVEY_BUNDLED_AI_ID);
+  }
+
+  void SetAgentSites(bool open) {
+    const extensions::Extension* extension = Assistant();
+    extensions::PermissionsManager* permissions =
+        extensions::PermissionsManager::Get(profile_);
+    if (!extension || !permissions->CanAffectExtension(*extension)) {
+      return;
+    }
+    // Only what was opened here is taken back: the user may have given it
+    // every site.
+    PrefService* prefs = profile_->GetPrefs();
+    if (open == prefs->GetBoolean(kHiveyAgentSitesOpen) ||
+        (open && !permissions->HasWithheldHostPermissions(*extension))) {
+      return;
+    }
+    prefs->SetBoolean(kHiveyAgentSitesOpen, open);
+    extensions::ScriptingPermissionsModifier(profile_, extension)
+        .SetWithholdHostPermissions(!open);
+    if (!open) {
+      GrantHiveyAssistantHosts(profile_, extension);
+    }
+  }
+
+  void Fetch(const std::string& id, const GURL& url) {
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+      Answer(id, url, nullptr, std::nullopt);
+      return;
+    }
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = url;
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                   kTrafficAnnotation);
+    loader->SetTimeoutDuration(base::Seconds(15));
+    loader->SetAllowHttpErrorResults(true);
+    auto* raw = loader.get();
+    loaders_.push_back(std::move(loader));
+    raw->DownloadToString(
+        g_browser_process->shared_url_loader_factory().get(),
+        base::BindOnce(
+            [](base::WeakPtr<Bridge> bridge, std::string id, GURL url,
+               std::list<std::unique_ptr<network::SimpleURLLoader>>::iterator
+                   loader,
+               std::optional<std::string> body) {
+              if (bridge) {
+                bridge->Answer(id, url, loader->get(), std::move(body));
+                bridge->loaders_.erase(loader);
+              }
+            },
+            weak_factory_.GetWeakPtr(), id, url, std::prev(loaders_.end())),
+        kMaxPageBytes);
+  }
+
+  void Answer(const std::string& id,
+              const GURL& url,
+              network::SimpleURLLoader* loader,
+              std::optional<std::string> body) {
+    const extensions::Extension* extension = Assistant();
+    if (!extension) {
+      return;
+    }
+    base::DictValue answer;
+    answer.Set("url", url.spec());
+    if (body) {
+      const network::mojom::URLResponseHead* head =
+          loader ? loader->ResponseInfo() : nullptr;
+      answer.Set("status", head && head->headers
+                               ? head->headers->response_code()
+                               : 200);
+      answer.Set("contentType", head ? head->mime_type : std::string());
+      if (loader && loader->GetFinalURL().is_valid()) {
+        answer.Set("url", loader->GetFinalURL().spec());
+      }
+      // Pages are not all valid UTF-8; base::Value must be.
+      answer.Set("body", base::UTF16ToUTF8(base::UTF8ToUTF16(*body)));
+    } else {
+      answer.Set("error", "fetch");
+    }
+    base::DictValue values;
+    values.Set("hiveyAiFetch_" + id, std::move(answer));
+    extensions::StorageFrontend::Get(profile_)->Set(
+        base::WrapRefCounted(extension),
+        extensions::StorageAreaNamespace::kSession, std::move(values),
+        base::DoNothing());
+  }
+
+  void Write() {
+    if (!g_browser_process->profile_manager()->IsValidProfile(profile_)) {
+      return;
+    }
+    const extensions::Extension* extension =
+        extensions::ExtensionRegistry::Get(profile_)
+            ->enabled_extensions()
+            .GetByID(HIVEY_BUNDLED_AI_ID);
+    if (!extension) {
+      return;
+    }
+    HiveyAiEngine& engine = HiveyAiEngine::Get();
+    base::DictValue state = engine.Describe();
+    if (engine.port()) {
+      state.Set("baseUrl", "http://127.0.0.1:" +
+                               base::NumberToString(engine.port()) + "/v1");
+      state.Set("key", engine.key());
+    }
+    base::DictValue values;
+    values.Set("hiveyAi", std::move(state));
+    extensions::StorageFrontend::Get(profile_)->Set(
+        base::WrapRefCounted(extension),
+        extensions::StorageAreaNamespace::kLocal, std::move(values),
+        base::DoNothing());
+  }
+
+  raw_ptr<Profile> profile_;
+  std::list<std::unique_ptr<network::SimpleURLLoader>> loaders_;
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver>
+      registry_observation_{this};
+  base::WeakPtrFactory<Bridge> weak_factory_{this};
+};
+
+std::map<void*, std::unique_ptr<Bridge>>& Bridges() {
+  static base::NoDestructor<std::map<void*, std::unique_ptr<Bridge>>> bridges;
+  return *bridges;
+}
+
+}  // namespace
+
+void AttachHiveyAiBridge(Profile* profile) {
+  if (profile->IsOffTheRecord() || Bridges().contains(profile)) {
+    return;
+  }
+  Bridges()[profile] = std::make_unique<Bridge>(profile);
+  extensions::StorageFrontend::SetHiveyToolsChangedCallback(base::BindRepeating(
+      [](content::BrowserContext* context, const base::Value& changes) {
+        auto it = Bridges().find(context);
+        if (it != Bridges().end()) {
+          it->second->OnStorageChanged(changes);
+        }
+      }));
+}
+
+}  // namespace hivey
