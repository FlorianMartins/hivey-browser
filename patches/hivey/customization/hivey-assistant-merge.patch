+class TabStripTools : public views::View {
+  METADATA_HEADER(TabStripTools, views::View)
+
+ public:
+  TabStripTools(BrowserWindowInterface* browser,
+                tabs::VerticalTabStripStateController* state_controller)
+      : browser_(browser) {
+    layout_ = SetLayoutManager(std::make_unique<views::BoxLayout>());
+    layout_->set_main_axis_alignment(
+        views::BoxLayout::MainAxisAlignment::kCenter);
+    layout_->set_between_child_spacing(2);
+
+    AddTool(vector_icons::kSettingsIcon, u"Settings",
+            base::BindRepeating(&TabStripTools::OpenSettings,
+                                base::Unretained(this)));
+    resources_ = AddTool(kSpeedIcon,
+                         l10n_util::GetStringUTF16(IDS_HIVEY_BAR_PERFORMANCE),
+                         base::BindRepeating(&TabStripTools::OpenResources,
+                                             base::Unretained(this)));
+    AddTool(kStarIcon, u"Bookmarks",
+            base::BindRepeating(&TabStripTools::OpenBookmarks,
+                                base::Unretained(this)));
+    AddTool(vector_icons::kHistoryIcon, u"History",
+            base::BindRepeating(&TabStripTools::OpenHistory,
+                                base::Unretained(this)));
+
+    OnCollapseChanged(state_controller->GetCollapseState());
+    collapse_subscription_ =
+        state_controller->RegisterOnCollapseChanged(base::BindRepeating(
+            &TabStripTools::OnCollapseChanged, base::Unretained(this)));
+  }
+
+ private:
+  ToolbarButton* AddTool(const gfx::VectorIcon& icon,
+                         const std::u16string& name,
+                         base::RepeatingClosure callback) {
+    auto button = std::make_unique<ToolbarButton>(std::move(callback));
+    button->SetVectorIcons(icon, icon);
+    button->SetTooltipText(name);
+    button->GetViewAccessibility().SetName(name);
+    return AddChildView(std::move(button));
+  }
+
+  void OnCollapseChanged(tabs::VerticalTabStripCollapseState state) {
+    const bool wide = state == tabs::VerticalTabStripCollapseState::kExpanded;
+    layout_->SetOrientation(wide ? views::BoxLayout::Orientation::kHorizontal
+                                 : views::BoxLayout::Orientation::kVertical);
+    InvalidateLayout();
+  }
+
+  void OpenSettings() { chrome::ExecuteCommand(browser_, IDC_OPTIONS); }
+
+  void OpenResources() {
+    if (auto* coordinator = HiveyResourcesCoordinator::From(browser_)) {
+      coordinator->ShowAnchoredTo(resources_, views::BubbleBorder::LEFT_BOTTOM);
+    }
+  }
+
+  void OpenBookmarks() {
+    SidePanelUI* side_panel = SidePanelUI::From(browser_);
+    SidePanelRegistry* registry = SidePanelRegistry::From(browser_);
+    const SidePanelEntryKey key(SidePanelEntryId::kBookmarks);
+    if (!side_panel || !registry || !registry->GetEntryForKey(key)) {
+      chrome::ExecuteCommand(browser_, IDC_SHOW_BOOKMARK_MANAGER);
+    } else if (side_panel->IsSidePanelEntryShowing(key)) {
+      side_panel->Close();
+    } else {
+      side_panel->Show(key, SidePanelOpenTrigger::kToolbarButton);
+    }
+  }
+
+  void OpenHistory() {
+    ShowSingletonTab(browser_, GURL("chrome://history/"));
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::BoxLayout> layout_;
+  raw_ptr<ToolbarButton> resources_;
+  base::CallbackListSubscription collapse_subscription_;
+};
