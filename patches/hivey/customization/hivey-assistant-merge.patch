+#ifndef CHROME_BROWSER_UI_HIVEY_HIVEY_AI_BRIDGE_H_
+#define CHROME_BROWSER_UI_HIVEY_HIVEY_AI_BRIDGE_H_
+
+class Profile;
+
+namespace extensions {
+class Extension;
+}
+
+namespace hivey {
+
+// Connects the local AI engine and the Hivey assistant (the bundled extension),
+// through the extension's own storage:
+//   hiveyAi, written here: the engine's state, and its address and key while it
+//     runs.
+//   hiveyAiRequest {action: "download"|"start"} and hiveyAiBusy, written by the
+//     assistant: what it needs, and whether a model is computing (the light).
+//   hiveyAiAgent, written by the assistant: the agent works. The extension has no
+//     access to sites otherwise, so that a page cannot reach it by itself.
+//   hiveyAiFetch {id, url}, written by the assistant: a page to read, fetched here
+//     without cookies; the answer is in session storage, hiveyAiFetch_<id>.
+// Once per profile; does nothing until the assistant asks.
+void AttachHiveyAiBridge(Profile* profile);
+
+// The sites the assistant always has (toolbar_actions_model.cc).
+void GrantHiveyAssistantHosts(Profile* profile,
+                              const extensions::Extension* extension);
+
+}  // namespace hivey
+
+#endif  // CHROME_BROWSER_UI_HIVEY_HIVEY_AI_BRIDGE_H_
