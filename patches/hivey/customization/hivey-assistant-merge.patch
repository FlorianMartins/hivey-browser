+// Until it has loaded its model. A game suspends it: that time does not count.
+void HiveyAiEngine::CheckHealth() {
+  if (state_ != State::kStarting) {
+    return;
+  }
+  if (game_) {
+    started_ = base::TimeTicks::Now();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&HiveyAiEngine::CheckHealth,
+                       weak_factory_.GetWeakPtr()),
+        base::Seconds(1));
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL("http://127.0.0.1:" + base::NumberToString(port_) +
+                      "/health");
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  health_loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                                    kTrafficAnnotation);
+  health_loader_->SetTimeoutDuration(base::Seconds(3));
+  health_loader_->DownloadToString(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&HiveyAiEngine::OnHealth, weak_factory_.GetWeakPtr()),
+      1024);
+}
+
+void HiveyAiEngine::OnHealth(std::optional<std::string> body) {
+  health_loader_.reset();
+  if (state_ != State::kStarting) {
+    return;
+  }
+  if (body) {
+    OnStarted(true);
+    return;
+  }
+  if (base::TimeTicks::Now() - started_ > base::Minutes(3)) {
+    OnStarted(false);
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&HiveyAiEngine::CheckHealth, weak_factory_.GetWeakPtr()),
+      base::Milliseconds(400));
 }
 
