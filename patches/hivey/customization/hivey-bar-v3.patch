+std::vector<std::string> GetHiveyBarOrder(const PrefService& prefs) {
+  std::vector<std::string> known;
+  for (const HiveyBarWorkspace& workspace : kHiveyBarWorkspaces) {
+    known.emplace_back(workspace.mode);
+  }
+  for (const base::Value& app : prefs.GetList(kHiveyBarApps)) {
+    const std::string* id = app.is_dict() ? app.GetDict().FindString("id") : nullptr;
+    if (id) {
+      known.push_back(base::StrCat({kHiveyBarAppPrefix, *id}));
+    }
+  }
+  std::vector<std::string> order;
+  auto add = [&](const std::string& id) {
+    if (std::ranges::contains(known, id) && !std::ranges::contains(order, id)) {
+      order.push_back(id);
+    }
+  };
+  for (const base::Value& id : prefs.GetList(kHiveyBarOrder)) {
+    if (id.is_string()) {
+      add(id.GetString());
+    }
+  }
+  std::ranges::for_each(known, add);
+  return order;
+}
+
+bool IsHiveyBarItemHidden(const PrefService& prefs, std::string_view id) {
+  return std::ranges::any_of(
+      prefs.GetList(kHiveyBarHidden), [&](const base::Value& hidden) {
+        return hidden.is_string() && hidden.GetString() == id;
+      });
+}
+
+const base::DictValue* FindHiveyBarApp(const PrefService& prefs,
+                                       std::string_view id) {
+  if (!id.starts_with(kHiveyBarAppPrefix)) {
+    return nullptr;
+  }
+  id.remove_prefix(std::char_traits<char>::length(kHiveyBarAppPrefix));
+  for (const base::Value& app : prefs.GetList(kHiveyBarApps)) {
+    const std::string* app_id =
+        app.is_dict() ? app.GetDict().FindString("id") : nullptr;
+    if (app_id && *app_id == id) {
+      return &app.GetDict();
+    }
+  }
+  return nullptr;
+}
+
 }  // namespace hivey
