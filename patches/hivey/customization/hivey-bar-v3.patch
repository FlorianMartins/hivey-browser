+void HiveyBarView::OnAppPressed(std::string id) {
+  BrowserWindowInterface* browser = browser_view_->browser();
+  SidePanelUI* side_panel = SidePanelUI::From(browser);
+  SidePanelRegistry* registry = SidePanelRegistry::From(browser);
+  const base::DictValue* app = hivey::FindHiveyBarApp(*prefs_.prefs(), id);
+  const std::string* url = app ? app->FindString("url") : nullptr;
+  if (!side_panel || !registry || !url) {
+    return;
+  }
+  if (side_panel->IsSidePanelEntryShowing(AppPanelKey()) &&
+      id == active_app_) {
+    side_panel->Close();
+    UpdateActive();
+    return;
+  }
+  pending_app_url_ = GURL(*url);
+  if (!registry->GetEntryForKey(AppPanelKey())) {
+    auto entry = std::make_unique<SidePanelEntry>(
+        AppPanelKey(),
+        base::BindRepeating(
+            [](base::WeakPtr<HiveyBarView> bar,
+               SidePanelEntryScope&) -> SidePanelNativeView {
+              return bar ? bar->CreateAppPanel()
+                         : std::make_unique<views::View>();
+            },
+            weak_factory_.GetWeakPtr()),
+        /*default_content_width_callback=*/base::NullCallback());
+    // Its button in the bar shows it is open; a second click closes it.
+    entry->set_should_show_header(false);
+    registry->Register(std::move(entry));
+  }
+  // The panel kept from the last time (same site: as the user left it).
+  if (app_panel_ && id != active_app_) {
+    app_panel_->Open(pending_app_url_);
+  }
+  active_app_ = std::move(id);
+  side_panel->Show(AppPanelKey(), SidePanelOpenTrigger::kExtension);
+  UpdateActive();
+}
+
+std::unique_ptr<views::View> HiveyBarView::CreateAppPanel() {
+  auto panel =
+      std::make_unique<HiveyAppPanelView>(browser_view_, pending_app_url_);
+  app_panel_ = panel->AsWeakPtr();
+  return panel;
+}
