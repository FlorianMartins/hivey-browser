+// A user's site: the first letter of its name in a rounded square, white at
+// 40 px for 20 DIP like the built-in icons.
+gfx::ImageSkia MonogramIcon(const std::u16string& title) {
+  constexpr int kSize = 40;
+  gfx::Canvas canvas(gfx::Size(kSize, kSize), 1.0f, /*is_opaque=*/false);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(SK_ColorWHITE);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(3);
+  canvas.DrawRoundRect(gfx::RectF(4.5f, 4.5f, 31, 31), 9, flags);
+  const std::u16string letter = base::i18n::ToUpper(
+      title.empty() ? std::u16string(u"?") : title.substr(0, 1));
+  const gfx::FontList base_font;
+  canvas.DrawStringRectWithFlags(
+      letter,
+      base_font.DeriveWithSizeDelta(18 - base_font.GetFontSize())
+          .DeriveWithWeight(gfx::Font::Weight::BOLD),
+      SK_ColorWHITE, gfx::Rect(0, 0, kSize, kSize),
+      gfx::Canvas::TEXT_ALIGN_CENTER);
+  return gfx::ImageSkia::CreateFromBitmap(canvas.GetBitmap(), 2.0f);
+}
