+// The Hivey bar's buttons: order (arrows or drag and drop), visibility, the
+// user's sites (opened in the side panel).
+function barCard() {
+  if (!state.bar || !hasPref('hivey.bar.hidden')) {
+    return null;
+  }
+  const order = state.bar.items.map(item => item.id);
+  const hidden = pref('hivey.bar.hidden');
+  const send = (newOrder, newHidden) => chrome.send('setBarLayout', [newOrder, newHidden]);
+  const toggle = id => send(order, hidden.includes(id) ? hidden.filter(h => h !== id) : [...hidden, id]);
+  const move = (from, to) => {
+    if (to < 0 || to >= order.length || from === to) {
+      return;
+    }
+    const next = [...order];
+    next.splice(to, 0, next.splice(from, 1)[0]);
+    send(next, hidden);
+  };
+  const eye = (id, title) => {
+    const shown = !hidden.includes(id);
+    return el('button', {class: 'icon-button', title: t(shown ? 'barHide' : 'barShow'),
+                         'aria-label': `${t(shown ? 'barHide' : 'barShow')} ${title}`, 'aria-pressed': shown ? 'true' : 'false',
+                         onclick: () => toggle(id)}, icon(shown ? 'eye' : 'eyeOff'));
+  };
+
+  const items = state.bar.items.map((item, index) => {
+    const title = item.title || item.url || item.id;
+    const row = el('div', {class: `bar-item${hidden.includes(item.id) ? ' off' : ''}`, draggable: 'true',
+                           'data-key': `bar-${item.id}`},
+                   el('span', {class: 'grip', 'aria-hidden': 'true'}, icon('grip')),
+                   el('span', {class: 'row-text'},
+                      el('span', {class: 'row-label'}, title,
+                         item.kind === 'app' ? el('span', {class: 'pill', text: t('siteTag')}) : null),
+                      item.kind === 'app' ? el('span', {class: 'row-hint mono', text: item.url}) : null),
+                   el('button', {class: 'icon-button', title: t('moveUp'), 'aria-label': `${t('moveUp')} ${title}`,
+                                 disabled: index === 0, onclick: () => move(index, index - 1)}, icon('up')),
+                   el('button', {class: 'icon-button', title: t('moveDown'), 'aria-label': `${t('moveDown')} ${title}`,
+                                 disabled: index === order.length - 1, onclick: () => move(index, index + 1)},
+                      icon('down')),
+                   eye(item.id, title),
+                   item.kind === 'app'
+                       ? el('button', {class: 'icon-button', title: t('removeSite'),
+                                       'aria-label': `${t('removeSite')} ${title}`,
+                                       onclick: () => chrome.send('removeBarApp', [item.id.slice(4)])}, icon('trash'))
+                       : null);
+    row.addEventListener('dragstart', e => {
+      e.dataTransfer.setData('text/plain', String(index));
+      row.classList.add('dragging');
+    });
+    row.addEventListener('dragend', () => row.classList.remove('dragging'));
+    row.addEventListener('dragover', e => e.preventDefault());
+    row.addEventListener('drop', e => {
+      e.preventDefault();
+      move(Number(e.dataTransfer.getData('text/plain')), index);
+    });
+    return row;
+  });
+
+  const tools = state.bar.tools.map(tool =>
+      el('div', {class: `bar-item${hidden.includes(tool.id) ? ' off' : ''}`},
+         el('span', {class: 'row-text'}, el('span', {class: 'row-label', text: tool.title})),
+         eye(tool.id, tool.title)));
+
+  const name = el('input', {type: 'text', class: 'text-input', placeholder: t('siteName'), 'aria-label': t('siteName'),
+                            maxlength: '40', 'data-key': 'bar-site-name'});
+  const url = el('input', {type: 'url', class: 'text-input', placeholder: t('siteUrl'), 'aria-label': t('siteUrl'),
+                           spellcheck: 'false', 'data-key': 'bar-site-url'});
+  const add = () => {
+    let address = url.value.trim();
+    if (address && !/^https?:\/\//i.test(address)) {
+      address = `https://${address}`;
+    }
+    try {
+      new URL(address);
+    } catch {
+      url.focus();
+      return;
+    }
+    chrome.send('addBarApp', [name.value.trim(), address]);
+    name.value = url.value = '';
+  };
+  url.addEventListener('keydown', e => e.key === 'Enter' && add());
+
+  return card(t('barTitle'),
+              el('p', {class: 'muted small', text: t('barHint')}),
+              el('div', {class: 'row'},
+                 el('div', {class: 'row-text'}, el('span', {class: 'row-label', text: t('barIcons')})),
+                 segmented({
+                   label: t('barIcons'), value: pref('hivey.bar.icon_style'),
+                   options: [{value: 0, label: t('barIconsTheme')}, {value: 1, label: t('barIconsMulti')}],
+                   onChange: v => setPref('hivey.bar.icon_style', Number(v)),
+                 })),
+              el('div', {class: 'bar-list'}, ...items),
+              el('div', {class: 'bar-add'},
+                 el('div', {class: 'row-text'},
+                    el('span', {class: 'row-label', text: t('addSite')}),
+                    el('span', {class: 'row-hint', text: t('barSitesHint')})),
+                 el('span', {class: 'text-field'}, name, url,
+                    el('button', {class: 'button', text: t('add'), onclick: add}))),
+              el('h4', {class: 'bar-subtitle', text: t('barTools')}),
+              el('div', {class: 'bar-list'}, ...tools));
+}
