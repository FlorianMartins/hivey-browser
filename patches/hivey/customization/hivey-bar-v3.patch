+base::DictValue HiveyStudioHandler::BuildBarState() {
+  // The Hivey bar's buttons for its settings: the upper group in the bar's
+  // order (Hivey Tools' workspaces and the user's sites), then the tools.
+  const PrefService& prefs = *GetProfile()->GetPrefs();
+  const bool french =
+      base::StartsWith(g_browser_process->GetApplicationLocale(), "fr");
+  base::ListValue items;
+  for (const std::string& id : hivey::GetHiveyBarOrder(prefs)) {
+    base::DictValue item;
+    item.Set("id", id);
+    if (const base::DictValue* app = hivey::FindHiveyBarApp(prefs, id)) {
+      item.Set("kind", "app").Merge(app->Clone()).Set("id", id);
+    } else {
+      for (const HiveyBarWorkspace& workspace : kHiveyBarWorkspaces) {
+        if (id == workspace.mode) {
+          item.Set("kind", "workspace")
+              .Set("title", french ? workspace.title_fr : workspace.title_en);
+        }
+      }
+    }
+    items.Append(std::move(item));
+  }
+  base::ListValue tools;
+  const std::pair<const char*, std::u16string> kTools[] = {
+      {"cyber", u"Hivey Cyber"},
+      {"performance", l10n_util::GetStringUTF16(IDS_HIVEY_BAR_PERFORMANCE)},
+      {"history", l10n_util::GetStringUTF16(IDS_HIVEY_BAR_HISTORY)},
+      {"bookmarks", l10n_util::GetStringUTF16(IDS_HIVEY_BAR_BOOKMARKS)},
+  };
+  for (const auto& [id, title] : kTools) {
+    tools.Append(base::DictValue().Set("id", id).Set("title", title));
+  }
+  return base::DictValue()
+      .Set("items", std::move(items))
+      .Set("tools", std::move(tools));
+}
+
+void HiveyStudioHandler::HandleSetBarLayout(const base::ListValue& args) {
+  // [order, hidden]: lists of button ids.
+  if (args.size() != 2 || !args[0].is_list() || !args[1].is_list()) {
+    return;
+  }
+  auto ids = [](const base::ListValue& list) {
+    base::ListValue clean;
+    for (const base::Value& id : list) {
+      if (id.is_string() && id.GetString().size() <= 64 &&
+          base::IsStringASCII(id.GetString()) && clean.size() < 100 &&
+          !clean.contains(id.GetString())) {
+        clean.Append(id.GetString());
+      }
+    }
+    return clean;
+  };
+  PrefService* prefs = GetProfile()->GetPrefs();
+  prefs->SetList(hivey::kHiveyBarOrder, ids(args[0].GetList()));
+  prefs->SetList(hivey::kHiveyBarHidden, ids(args[1].GetList()));
+}
+
+void HiveyStudioHandler::HandleAddBarApp(const base::ListValue& args) {
+  // [title, url]: a web site, opened in the side panel from the bar.
+  const std::string* title = args.size() == 2 ? args[0].GetIfString() : nullptr;
+  const std::string* url = args.size() == 2 ? args[1].GetIfString() : nullptr;
+  const GURL gurl(url ? *url : std::string());
+  PrefService* prefs = GetProfile()->GetPrefs();
+  const base::ListValue& apps = prefs->GetList(hivey::kHiveyBarApps);
+  if (!title || !gurl.is_valid() || !gurl.SchemeIsHTTPOrHTTPS() ||
+      apps.size() >= hivey::kHiveyBarMaxApps) {
+    return;
+  }
+  std::u16string name =
+      base::CollapseWhitespace(base::UTF8ToUTF16(*title), true);
+  if (name.empty()) {
+    name = base::UTF8ToUTF16(gurl.host());
+  }
+  name = name.substr(0, 40);
+  int next_id = 1;
+  for (const base::Value& app : apps) {
+    const std::string* id =
+        app.is_dict() ? app.GetDict().FindString("id") : nullptr;
+    int number = 0;
+    if (id && base::StringToInt(*id, &number)) {
+      next_id = std::max(next_id, number + 1);
+    }
+  }
+  ScopedListPrefUpdate(prefs, hivey::kHiveyBarApps)
+      ->Append(base::DictValue()
+                   .Set("id", base::NumberToString(next_id))
+                   .Set("title", name)
+                   .Set("url", gurl.spec()));
+}
+
+void HiveyStudioHandler::HandleRemoveBarApp(const base::ListValue& args) {
+  const std::string* id = args.size() == 1 ? args[0].GetIfString() : nullptr;
+  if (!id) {
+    return;
+  }
+  PrefService* prefs = GetProfile()->GetPrefs();
+  ScopedListPrefUpdate(prefs, hivey::kHiveyBarApps)
+      ->EraseIf([&](const base::Value& app) {
+        const std::string* app_id =
+            app.is_dict() ? app.GetDict().FindString("id") : nullptr;
+        return app_id && *app_id == *id;
+      });
+  const std::string button = hivey::kHiveyBarAppPrefix + *id;
+  for (const char* list : {hivey::kHiveyBarOrder, hivey::kHiveyBarHidden}) {
+    ScopedListPrefUpdate(prefs, list)->EraseIf([&](const base::Value& value) {
+      return value.is_string() && value.GetString() == button;
+    });
+  }
+}
