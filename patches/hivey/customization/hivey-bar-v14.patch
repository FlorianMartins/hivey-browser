+// The page a Tor window opens once connected: it says so, with a search box
+// and what such a window is (and is not: Tor Browser).
+GURL HomePage() {
+  auto text = [](int id) {
+    return base::EscapeForHTML(base::UTF16ToUTF8(l10n_util::GetStringUTF16(id)));
+  };
+  const std::string html = base::StringPrintf(
+      "<!doctype html><meta charset=utf-8><title>Tor</title>"
+      "<body style=\"margin:0;min-height:100vh;display:grid;place-items:center;"
+      "background:radial-gradient(circle at 50%% 0%%,#2a1d4f,#13141f 60%%);"
+      "color:#e6e7ff;font:16px system-ui,sans-serif\">"
+      "<main style=\"max-width:560px;text-align:center;padding:24px\">"
+      "<div style=\"font-size:64px\">&#129477;</div>"
+      "<h1 style=\"font-size:22px;font-weight:600;margin:12px 0 24px\">%s</h1>"
+      "<form action=\"%s\" method=get style=\"display:flex;gap:8px\">"
+      "<input name=q autofocus placeholder=\"%s\" aria-label=\"%s\" "
+      "style=\"flex:1;padding:12px 16px;border-radius:24px;border:1px solid "
+      "#3b3d5c;background:#1b1c2b;color:#e6e7ff;font:inherit;outline:none\">"
+      "</form>"
+      "<p style=\"color:#a3a6c9;font-size:13px;margin-top:24px\">%s</p>"
+      "</main>",
+      text(IDS_HIVEY_TOR_READY).c_str(), kTorSearchUrl,
+      text(IDS_HIVEY_TOR_SEARCH).c_str(), text(IDS_HIVEY_TOR_SEARCH).c_str(),
+      text(IDS_HIVEY_TOR_READY_NOTE).c_str());
+  return GURL("data:text/html;base64," + base::Base64Encode(html));
+}
