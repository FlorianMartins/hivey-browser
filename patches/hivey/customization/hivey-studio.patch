+// Settings Hivey Studio may read and write. Anything else is refused.
+struct AllowedPref {
+  const char* name;
+  bool local_state;
+};
+constexpr AllowedPref kAllowedPrefs[] = {
+    {"vertical_tabs.enabled", false},
+    {"vertical_tabs.expand_on_hover", false},
+    {"side_panel.is_right_aligned", false},
+    {"browser.show_home_button", false},
+    {"browser.show_forward_button", false},
+    {"bookmark_bar.show_on_all_tabs", false},
+    {"tab_search.pinned_to_tabstrip", false},
+    {"browser.ctrl_tab_mru", false},
+    {"browser.hovercard.image_previews_enabled", false},
+    {"browser.hovercard.memory_usage_enabled", false},
+    {"https_only_mode_enabled", false},
+    {"hivey.memory_limit_mb", true},
+    {hivey::kCpuLimitPercent, true},
+    {hivey::kNetworkLimitKbps, true},
+};
+
+// chrome://flags entries shown in Hivey Studio (they need a restart).
+constexpr const char* kCuratedFlags[] = {
+    "hivey-compact-ui",     "scroll-tabs",          "close-window-with-last-tab",
+    "tab-hover-cards",      "hide-tab-close-buttons", "show-avatar-button",
+    "hide-extensions-menu", "remove-grab-handle",   "hide-fullscreen-exit-ui",
+    "popups-to-tabs",       "close-confirmation",   "bookmark-bar-ntp",
+    "disable-link-drag",    "clear-data-on-exit",   "enable-incognito-themes",
+    "disable-fingerprinting-noise",
+};
+
+constexpr auto kVariants =
+    base::MakeFixedFlatMap<std::string_view, ui::mojom::BrowserColorVariant>({
+        {"system", ui::mojom::BrowserColorVariant::kSystem},
+        {"tonal", ui::mojom::BrowserColorVariant::kTonalSpot},
+        {"neutral", ui::mojom::BrowserColorVariant::kNeutral},
+        {"vibrant", ui::mojom::BrowserColorVariant::kVibrant},
+        {"expressive", ui::mojom::BrowserColorVariant::kExpressive},
+    });
+
+constexpr auto kSchemes =
+    base::MakeFixedFlatMap<std::string_view, ThemeService::BrowserColorScheme>({
+        {"system", ThemeService::BrowserColorScheme::kSystem},
+        {"light", ThemeService::BrowserColorScheme::kLight},
+        {"dark", ThemeService::BrowserColorScheme::kDark},
+    });
+
+const AllowedPref* FindAllowedPref(std::string_view name) {
+  for (const AllowedPref& pref : kAllowedPrefs) {
+    if (name == pref.name) {
+      return &pref;
+    }
+  }
+  return nullptr;
+}
+
+bool IsCuratedFlag(std::string_view name) {
+  return std::ranges::any_of(kCuratedFlags,
+                             [name](std::string_view flag) { return flag == name; });
+}
+
+std::string ColorToHex(SkColor color) {
+  return base::StringPrintf("#%02x%02x%02x", SkColorGetR(color),
+                            SkColorGetG(color), SkColorGetB(color));
+}
+
+// Parses "#rrggbb".
+std::optional<SkColor> HexToColor(const std::string& hex) {
+  uint32_t rgb = 0;
+  if (hex.size() != 7 || hex[0] != '#' ||
+      !base::HexStringToUInt(std::string_view(hex).substr(1), &rgb)) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB((rgb >> 16) & 0xff, (rgb >> 8) & 0xff, rgb & 0xff);
+}
