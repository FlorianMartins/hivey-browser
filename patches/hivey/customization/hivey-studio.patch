+// Streams task manager data (CPU, memory, network per task) to the page,
+// once per second, while the Resources section is visible.
+class HiveyStudioHandler::UsageObserver
+    : public task_manager::TaskManagerObserver {
+ public:
+  using Callback = base::RepeatingCallback<void(base::DictValue)>;
+
+  explicit UsageObserver(Callback callback)
+      : TaskManagerObserver(base::Seconds(1),
+                            task_manager::REFRESH_TYPE_CPU |
+                                task_manager::REFRESH_TYPE_MEMORY_FOOTPRINT |
+                                task_manager::REFRESH_TYPE_NETWORK_USAGE),
+        callback_(std::move(callback)) {
+    task_manager::TaskManagerInterface::GetTaskManager()->AddObserver(this);
+  }
+
+  ~UsageObserver() override {
+    if (observed_task_manager()) {
+      observed_task_manager()->RemoveObserver(this);
+    }
+  }
+
+  // task_manager::TaskManagerObserver:
+  void OnTasksRefreshed(const task_manager::TaskIdList& task_ids) override {
+    task_manager::TaskManagerInterface* tm = observed_task_manager();
+    double total_cpu = 0;
+    int64_t total_memory = 0;
+    int64_t total_network = 0;
+    base::ListValue tasks;
+    std::set<base::ProcessId> counted_processes;
+    for (task_manager::TaskId id : task_ids) {
+      const double cpu = tm->GetPlatformIndependentCPUUsage(id);
+      const int64_t memory =
+          tm->GetMemoryFootprintUsage(id).value_or(base::ByteSize()).InBytes();
+      const int64_t network = tm->GetNetworkUsage(id).InBytes();
+      total_network += network;
+      // CPU and memory are per process: count each process once.
+      if (counted_processes.insert(tm->GetProcessId(id)).second) {
+        total_cpu += std::max(cpu, 0.0);
+        total_memory += memory;
+      }
+      tasks.Append(base::DictValue()
+                       .Set("id", static_cast<double>(id))
+                       .Set("title", tm->GetTitle(id))
+                       .Set("type", static_cast<int>(tm->GetType(id)))
+                       .Set("isTab", tm->GetTabId(id).is_valid())
+                       .Set("cpu", std::max(cpu, 0.0))
+                       .Set("memoryMb", static_cast<double>(memory) / (1 << 20))
+                       .Set("networkKbps", network * 8 / 1000.0)
+                       .Set("killable", tm->IsTaskKillable(id)));
+    }
+    callback_.Run(
+        base::DictValue()
+            .Set("tasks", std::move(tasks))
+            .Set("cpu", total_cpu)
+            .Set("memoryMb", static_cast<double>(total_memory) / (1 << 20))
+            .Set("networkKbps", total_network * 8 / 1000.0)
+            .Set("cores", static_cast<int>(base::SysInfo::NumberOfProcessors())));
+  }
+
+ private:
+  Callback callback_;
+};
