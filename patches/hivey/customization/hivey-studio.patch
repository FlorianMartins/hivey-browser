+
+class HiveyStudioUI;
+
+// chrome://hivey: Hivey Studio, every customization in one place (colors,
+// layout, tab behaviour, resource limiters, privacy shields).
+inline constexpr char kChromeUIHiveyStudioHost[] = "hivey";
+inline constexpr char kChromeUIHiveyStudioURL[] = "chrome://hivey/";
+
+class HiveyStudioUIConfig : public content::DefaultWebUIConfig<HiveyStudioUI> {
+ public:
+  HiveyStudioUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme, kChromeUIHiveyStudioHost) {
+  }
+};
+
