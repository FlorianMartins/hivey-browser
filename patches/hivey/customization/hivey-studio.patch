+
+// Backend of chrome://hivey. Reads and writes a fixed allowlist of settings:
+// the browser theme, some profile and Local State prefs, a curated set of
+// chrome://flags entries, and streams live resource usage from the task
+// manager while the Resources section is open.
+class HiveyStudioHandler : public content::WebUIMessageHandler {
+ public:
+  HiveyStudioHandler();
+  HiveyStudioHandler(const HiveyStudioHandler&) = delete;
+  HiveyStudioHandler& operator=(const HiveyStudioHandler&) = delete;
+  ~HiveyStudioHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  class UsageObserver;
+
+  Profile* GetProfile();
+  base::DictValue BuildState();
+  base::DictValue BuildThemeState();
+  base::DictValue BuildPrefsState();
+  base::ListValue BuildFlagsState();
+  base::DictValue BuildShieldState();
+
+  void HandleGetState(const base::ListValue& args);
+  void HandleSetThemeColor(const base::ListValue& args);
+  void HandleSetColorScheme(const base::ListValue& args);
+  void HandleSetGrayscale(const base::ListValue& args);
+  void HandleResetTheme(const base::ListValue& args);
+  void HandleSetPref(const base::ListValue& args);
+  void HandleSetFlag(const base::ListValue& args);
+  void HandleRestart(const base::ListValue& args);
+  void HandleStartUsage(const base::ListValue& args);
+  void HandleStopUsage(const base::ListValue& args);
+  void HandleTaskAction(const base::ListValue& args);
+  void HandleOpenCustomizeToolbar(const base::ListValue& args);
+
+  // Pushes the current state to the page ("hivey-state" event).
+  void FireStateChanged();
+  void OnUsageRefreshed(base::DictValue usage);
+
+  std::unique_ptr<UsageObserver> usage_observer_;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_HIVEY_HIVEY_STUDIO_HANDLER_H_
