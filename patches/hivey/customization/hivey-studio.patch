--- a/chrome/browser/resources/hivey_studio/studio.css
+++ b/chrome/browser/resources/hivey_studio/studio.css
@@ -0,0 +1,836 @@
+/* Copyright 2026 The Hivey Browser contributors
+ * Use of this source code is governed by the MIT license that can be found in
+ * the LICENSE file of the Hivey Browser repository. */
+
+/* Hivey Studio: the Hivey AI sidebar's look (deep ink background, glass
+ * cards, indigo-to-violet accents, soft aura). --user is the browser color
+ * the user picked; it tints the preview and the active controls. */
+
+@property --fill {
+  syntax: '<number>';
+  inherits: false;
+  initial-value: 0;
+}
+
+:root {
+  --bg: #0b0c14;
+  --panel: #151726;
+  --panel-2: #1d2033;
+  --elevated: rgba(38, 42, 64, 0.55);
+  --border: rgba(255, 255, 255, 0.09);
+  --border-strong: rgba(255, 255, 255, 0.16);
+  --text: #f4f2fc;
+  --muted: #9b9db5;
+  --accent: #6366f1;
+  --accent-2: #8b5cf6;
+  --grad: linear-gradient(135deg, #6366f1 0%, #6366f1 40%, #8b5cf6 100%);
+  --grad-soft: linear-gradient(135deg, rgba(99, 102, 241, 0.16), rgba(139, 92, 246, 0.16));
+  --ok: #22c55e;
+  --warn: #f59e0b;
+  --danger: #f43f5e;
+  --user: #f7a21b;
+  --radius: 14px;
+  --radius-sm: 9px;
+  color-scheme: dark;
+}
+
+@media (prefers-color-scheme: light) {
+  :root {
+    --bg: #f6f6fb;
+    --panel: #ffffff;
+    --panel-2: #f0f0f8;
+    --elevated: rgba(255, 255, 255, 0.8);
+    --border: rgba(20, 20, 60, 0.09);
+    --border-strong: rgba(20, 20, 60, 0.18);
+    --text: #16172a;
+    --muted: #5d6079;
+    color-scheme: light;
+  }
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  margin: 0;
+  min-height: 100%;
+  background: var(--bg);
+  color: var(--text);
+  font: 14px/1.5 system-ui, 'Segoe UI Variable Text', 'Segoe UI', Ubuntu, Cantarell, sans-serif;
+  -webkit-font-smoothing: antialiased;
+}
+
+.aura {
+  position: fixed;
+  inset: 0;
+  pointer-events: none;
+  background:
+    radial-gradient(620px circle at 0% 0%, color-mix(in srgb, var(--accent-2) 22%, transparent), transparent 60%),
+    radial-gradient(520px circle at 100% 0%, color-mix(in srgb, var(--user) 12%, transparent), transparent 60%);
+  z-index: 0;
+}
+
+.top,
+.layout,
+.restart-bar {
+  position: relative;
+  z-index: 1;
+}
+
+.top {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: 36px 32px 8px;
+}
+
+.logo {
+  width: 52px;
+  height: 52px;
+  display: grid;
+  place-items: center;
+  border-radius: 16px;
+  background: var(--grad);
+  box-shadow: 0 10px 40px -12px var(--accent-2);
+  flex: none;
+}
+
+.logo svg {
+  width: 30px;
+  height: 30px;
+  fill: none;
+  stroke: #fff;
+  stroke-width: 2;
+  stroke-linejoin: round;
+}
+
+h1 {
+  margin: 0;
+  font-size: 28px;
+  letter-spacing: -0.02em;
+  background: linear-gradient(90deg, var(--text), color-mix(in srgb, var(--accent-2) 60%, var(--text)));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+
+h2 {
+  margin: 0 0 4px;
+  font-size: 22px;
+  letter-spacing: -0.01em;
+}
+
+.muted {
+  color: var(--muted);
+  margin: 0;
+}
+
+.small {
+  font-size: 12.5px;
+}
+
+.mono {
+  font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
+  color: var(--muted);
+}
+
+.layout {
+  display: grid;
+  grid-template-columns: 240px minmax(0, 1fr);
+  gap: 28px;
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: 24px 32px 120px;
+}
+
+/* ------------------------------------------------------------- navigation */
+
+.rail {
+  position: sticky;
+  top: 24px;
+  align-self: start;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.nav-item {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 10px 14px;
+  border: 1px solid transparent;
+  border-radius: 12px;
+  background: none;
+  color: var(--muted);
+  font: inherit;
+  font-weight: 500;
+  text-align: start;
+  cursor: pointer;
+  position: relative;
+  transition: background 0.15s, color 0.15s;
+}
+
+.nav-item:hover {
+  background: var(--elevated);
+  color: var(--text);
+}
+
+.nav-item.active {
+  background: var(--grad-soft);
+  border-color: var(--border);
+  color: var(--text);
+}
+
+.nav-item.active::before {
+  content: '';
+  position: absolute;
+  inset-inline-start: -10px;
+  top: 10px;
+  bottom: 10px;
+  width: 3px;
+  border-radius: 3px;
+  background: var(--grad);
+}
+
+.icon {
+  width: 20px;
+  height: 20px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.8;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  flex: none;
+}
+
+.nav-item.active .icon {
+  stroke: var(--accent);
+}
+
+main {
+  outline: none;
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+  min-width: 0;
+}
+
+main > div {
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+}
+
+.section-header {
+  margin-bottom: 4px;
+}
+
+/* ------------------------------------------------------------------ cards */
+
+.card {
+  background: color-mix(in srgb, var(--panel) 88%, transparent);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: 8px 20px;
+  backdrop-filter: blur(12px);
+}
+
+.card-title {
+  margin: 14px 0 4px;
+  font-size: 11.5px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: color-mix(in srgb, var(--accent) 70%, var(--text));
+}
+
+.grid-2 {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+  gap: 16px;
+}
+
+.notice {
+  padding: 12px 16px;
+  border-radius: var(--radius-sm);
+  border: 1px solid color-mix(in srgb, var(--warn) 40%, transparent);
+  background: color-mix(in srgb, var(--warn) 10%, transparent);
+}
+
+/* ------------------------------------------------------------------- rows */
+
+.row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  min-height: 56px;
+  padding: 10px 0;
+  border-top: 1px solid var(--border);
+  width: 100%;
+}
+
+.card > .row:first-child,
+.card > .card-title + .row {
+  border-top: none;
+}
+
+.row.disabled {
+  opacity: 0.55;
+}
+
+.row-text {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+}
+
+.row-label {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-weight: 550;
+}
+
+.row-hint {
+  color: var(--muted);
+  font-size: 12.5px;
+}
+
+.pill {
+  font-size: 11px;
+  padding: 0 7px;
+  border-radius: 999px;
+  border: 1px solid var(--border-strong);
+  color: var(--muted);
+}
+
+.link-row {
+  background: none;
+  border-inline: none;
+  border-bottom: none;
+  color: inherit;
+  font: inherit;
+  text-align: start;
+  cursor: pointer;
+}
+
+.link-row:hover .row-label {
+  color: var(--accent);
+}
+
+.chevron {
+  font-size: 22px;
+  color: var(--muted);
+}
+
+/* ---------------------------------------------------------------- switch */
+
+.switch {
+  position: relative;
+  flex: none;
+  width: 44px;
+  height: 24px;
+}
+
+.switch-input {
+  position: absolute;
+  inset: 0;
+  margin: 0;
+  opacity: 0;
+  cursor: pointer;
+  z-index: 1;
+}
+
+.switch-track {
+  position: absolute;
+  inset: 0;
+  border-radius: 999px;
+  background: var(--panel-2);
+  border: 1px solid var(--border-strong);
+  transition: background 0.2s;
+}
+
+.switch-track::after {
+  content: '';
+  position: absolute;
+  top: 3px;
+  left: 3px;
+  width: 16px;
+  height: 16px;
+  border-radius: 50%;
+  background: var(--muted);
+  transition: transform 0.2s, background 0.2s;
+}
+
+.switch-input:checked + .switch-track {
+  background: var(--grad);
+  border-color: transparent;
+  box-shadow: 0 0 18px -6px var(--accent-2);
+}
+
+.switch-input:checked + .switch-track::after {
+  transform: translateX(20px);
+  background: #fff;
+}
+
+.switch-input:focus-visible + .switch-track {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+/* ------------------------------------------------------- selects, buttons */
+
+.select {
+  flex: none;
+  min-width: 190px;
+  padding: 8px 12px;
+  border-radius: var(--radius-sm);
+  border: 1px solid var(--border-strong);
+  background: var(--panel-2);
+  color: var(--text);
+  font: inherit;
+}
+
+.select:focus-visible,
+.button:focus-visible,
+.segment:focus-visible,
+.swatch:focus-visible,
+.nav-item:focus-visible,
+.link-row:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.button {
+  padding: 8px 16px;
+  border-radius: 10px;
+  border: 1px solid var(--border-strong);
+  background: var(--panel-2);
+  color: var(--text);
+  font: inherit;
+  font-weight: 550;
+  cursor: pointer;
+}
+
+.button:hover {
+  border-color: var(--accent);
+}
+
+.button.primary {
+  background: var(--grad);
+  border-color: transparent;
+  color: #fff;
+}
+
+.button.ghost {
+  background: transparent;
+}
+
+.button.danger:hover {
+  border-color: var(--danger);
+  color: var(--danger);
+}
+
+.button.small {
+  padding: 4px 10px;
+  font-size: 12.5px;
+}
+
+.actions {
+  display: flex;
+  justify-content: flex-end;
+  padding: 14px 0;
+  border-top: 1px solid var(--border);
+}
+
+.field {
+  padding: 14px 0;
+  border-top: 1px solid var(--border);
+}
+
+.card > .field:first-child {
+  border-top: none;
+}
+
+.field-label {
+  font-weight: 550;
+  margin-bottom: 10px;
+}
+
+.segmented {
+  display: inline-flex;
+  flex-wrap: wrap;
+  gap: 4px;
+  padding: 4px;
+  border-radius: 12px;
+  background: var(--panel-2);
+  border: 1px solid var(--border);
+}
+
+.segment {
+  padding: 7px 16px;
+  border: none;
+  border-radius: 9px;
+  background: none;
+  color: var(--muted);
+  font: inherit;
+  font-weight: 550;
+  cursor: pointer;
+}
+
+.segment.active {
+  background: var(--grad);
+  color: #fff;
+  box-shadow: 0 4px 18px -8px var(--accent-2);
+}
+
+/* ---------------------------------------------------------------- colors */
+
+.swatches {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 14px 8px;
+  padding: 10px 0 16px;
+}
+
+.swatch-wrap {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 6px;
+}
+
+.swatch {
+  width: 44px;
+  height: 44px;
+  border-radius: 50%;
+  border: 2px solid transparent;
+  background:
+    radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--swatch) 55%, #fff), var(--swatch) 65%);
+  cursor: pointer;
+  transition: transform 0.15s, box-shadow 0.15s;
+}
+
+.swatch:hover {
+  transform: scale(1.08);
+}
+
+.swatch.active {
+  border-color: var(--text);
+  box-shadow: 0 0 0 4px color-mix(in srgb, var(--swatch) 35%, transparent), 0 8px 24px -6px var(--swatch);
+}
+
+.swatch-name {
+  font-size: 11.5px;
+  color: var(--muted);
+  text-align: center;
+}
+
+.custom-color {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 14px 0;
+  border-top: 1px solid var(--border);
+}
+
+.color-input {
+  flex: none;
+  width: 44px;
+  height: 44px;
+  padding: 0;
+  border: 2px solid var(--border-strong);
+  border-radius: 12px;
+  background: none;
+  cursor: pointer;
+}
+
+.color-input::-webkit-color-swatch-wrapper {
+  padding: 3px;
+}
+
+.color-input::-webkit-color-swatch {
+  border: none;
+  border-radius: 8px;
+}
+
+/* Mini browser drawn with the user's color. */
+.preview {
+  margin: 10px 0 18px;
+  border-radius: 12px;
+  overflow: hidden;
+  border: 1px solid var(--border);
+  background: var(--panel-2);
+}
+
+.pv-frame {
+  background: color-mix(in srgb, var(--user) 28%, var(--panel));
+  padding: 8px 8px 0;
+}
+
+.pv-tabs {
+  display: flex;
+  gap: 4px;
+}
+
+.pv-tab {
+  height: 26px;
+  flex: 0 0 64px;
+  border-radius: 8px 8px 0 0;
+  background: color-mix(in srgb, var(--user) 18%, var(--panel));
+}
+
+.pv-tab.active {
+  flex-basis: 120px;
+  padding: 4px 10px;
+  font-size: 11.5px;
+  white-space: nowrap;
+  overflow: hidden;
+  background: color-mix(in srgb, var(--user) 10%, var(--panel));
+}
+
+.pv-toolbar {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 8px;
+  background: color-mix(in srgb, var(--user) 10%, var(--panel));
+}
+
+.pv-dot {
+  width: 14px;
+  height: 14px;
+  border-radius: 50%;
+  background: color-mix(in srgb, var(--text) 25%, transparent);
+}
+
+.pv-dot.accent {
+  background: var(--user);
+}
+
+.pv-omnibox {
+  flex: 1;
+  padding: 3px 12px;
+  border-radius: 999px;
+  font-size: 11.5px;
+  color: var(--muted);
+  background: color-mix(in srgb, var(--user) 16%, var(--panel-2));
+}
+
+.pv-page {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  padding: 16px;
+}
+
+.pv-line {
+  height: 8px;
+  width: 45%;
+  border-radius: 4px;
+  background: color-mix(in srgb, var(--text) 14%, transparent);
+}
+
+.pv-line.wide {
+  width: 75%;
+}
+
+.pv-button {
+  width: 72px;
+  height: 22px;
+  border-radius: 999px;
+  background: var(--user);
+}
+
+/* ------------------------------------------------------------- resources */
+
+.gauges {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 16px;
+}
+
+.gauge {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 4px;
+  padding: 20px 12px 16px;
+  border-radius: var(--radius);
+  border: 1px solid var(--border);
+  background: color-mix(in srgb, var(--panel) 88%, transparent);
+}
+
+.gauge-ring {
+  --fill: 0;
+  width: 112px;
+  height: 112px;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  background:
+    radial-gradient(closest-side, var(--panel) 78%, transparent 80% 100%),
+    conic-gradient(var(--accent) 0, var(--accent-2) calc(var(--fill) * 100%), var(--panel-2) 0);
+  transition: --fill 0.6s;
+}
+
+.gauge-value {
+  font-size: 20px;
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+}
+
+.gauge-label {
+  margin-top: 8px;
+  font-weight: 600;
+}
+
+.gauge-sub {
+  font-size: 12px;
+  min-height: 1.5em;
+}
+
+.tasks {
+  list-style: none;
+  margin: 0;
+  padding: 0 0 8px;
+}
+
+.task {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 56px 76px 84px auto;
+  align-items: center;
+  gap: 12px;
+  padding: 10px 0;
+  border-top: 1px solid var(--border);
+  font-variant-numeric: tabular-nums;
+}
+
+.task-title {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.task-metric {
+  color: var(--muted);
+  text-align: end;
+  font-size: 12.5px;
+}
+
+.task-actions {
+  display: flex;
+  gap: 6px;
+  justify-content: flex-end;
+}
+
+/* --------------------------------------------------------------- privacy */
+
+.shield-card {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding: 18px 20px;
+  background: var(--grad-soft), color-mix(in srgb, var(--panel) 88%, transparent);
+}
+
+.shield-badge {
+  width: 48px;
+  height: 48px;
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: 14px;
+  background: var(--grad);
+  color: #fff;
+  box-shadow: 0 10px 30px -12px var(--accent-2);
+}
+
+.shield-card .row-text {
+  flex: 1;
+}
+
+.status {
+  font-size: 11.5px;
+  font-weight: 600;
+  padding: 1px 9px;
+  border-radius: 999px;
+  border: 1px solid currentColor;
+}
+
+.status.ok {
+  color: var(--ok);
+}
+
+.status.warn {
+  color: var(--warn);
+}
+
+/* ---------------------------------------------------------- restart bar */
+
+.restart-bar {
+  position: fixed;
+  left: 50%;
+  bottom: 24px;
+  transform: translateX(-50%);
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 10px 12px 10px 18px;
+  border-radius: 16px;
+  border: 1px solid var(--border-strong);
+  background: color-mix(in srgb, var(--panel) 92%, transparent);
+  backdrop-filter: blur(16px);
+  box-shadow: 0 18px 50px -18px rgba(0, 0, 0, 0.6);
+  z-index: 2;
+}
+
+.restart-bar[hidden] {
+  display: none;
+}
+
+@media (max-width: 860px) {
+  .layout {
+    grid-template-columns: 1fr;
+    padding: 16px 16px 120px;
+  }
+
+  .top {
+    padding: 24px 16px 0;
+  }
+
+  .rail {
+    position: static;
+    flex-direction: row;
+    overflow-x: auto;
+  }
+
+  .nav-item.active::before {
+    display: none;
+  }
+
+  .gauges {
+    grid-template-columns: 1fr;
+  }
+
+  .task {
+    grid-template-columns: minmax(0, 1fr) auto;
+  }
+
+  .task-metric {
+    display: none;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  * {
+    transition: none !important;
+  }
+}
