+// the LICENSE file of the Hivey Browser repository.
+
+// Hivey Studio (chrome://hivey). The page builds its DOM with
+// createElement/textContent only (Trusted Types are enforced) and talks to
+// HiveyStudioHandler through chrome.send.
+
+import {addWebUiListener, sendWithPromise} from 'chrome://resources/js/cr.js';
+
+import {setLanguage, t} from './i18n.js';
+
+const DEFAULT_COLOR = '#f7a21b';
+
+const PRESETS = [
+  {key: 'presetAmber', color: '#f7a21b'},
+  {key: 'presetAura', color: '#6366f1'},
+  {key: 'presetViolet', color: '#8b5cf6'},
+  {key: 'presetOcean', color: '#0ea5e9'},
+  {key: 'presetMint', color: '#10b981'},
+  {key: 'presetCoral', color: '#f43f5e'},
+  {key: 'presetRose', color: '#ec4899'},
+  {key: 'presetGraphite', color: '#64748b'},
+];
+
+const SECTIONS = [
+  {id: 'appearance', nav: 'navAppearance', icon: 'palette', build: buildAppearance},
+  {id: 'layout', nav: 'navLayout', icon: 'layout', build: buildLayout},
+  {id: 'tabs', nav: 'navTabs', icon: 'tabs', build: buildTabs},
+  {id: 'resources', nav: 'navResources', icon: 'gauge', build: buildResources},
+  {id: 'privacy', nav: 'navPrivacy', icon: 'shield', build: buildPrivacy},
+  {id: 'about', nav: 'navAbout', icon: 'info', build: buildAbout},
+];
+
+// 24x24 stroke icons (Lucide-style paths).
+const ICONS = {
+  palette: ['M12 22a10 10 0 1 1 10-10c0 2.2-1.8 3.5-4 3.5h-1.6a1.9 1.9 0 0 0-1.4 3.2A1.9 1.9 0 0 1 12 22z',
+            'M7.5 10.5h.01', 'M12 7.5h.01', 'M16.5 10.5h.01'],
+  layout: ['M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z', 'M9 3v18', 'M9 9h12'],
+  tabs: ['M3 8a2 2 0 0 1 2-2h4l2 3h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z', 'M13 6h4l2 3'],
+  gauge: ['M12 14l4-4', 'M3.3 19a10 10 0 1 1 17.4 0', 'M12 14h.01'],
+  shield: ['M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10z', 'M9 12l2 2 4-4'],
+  info: ['M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z', 'M12 16v-4', 'M12 8h.01'],
+  restart: ['M3 12a9 9 0 1 0 3-6.7L3 8', 'M3 3v5h5'],
+};
+
+let state = null;
+let current = 'appearance';
+let usageStarted = false;
+
+// ------------------------------------------------------------------ helpers
+
+function el(tag, props = {}, ...children) {
+  const node = document.createElement(tag);
+  for (const [key, value] of Object.entries(props)) {
+    if (key === 'class') {
+      node.className = value;
+    } else if (key === 'text') {
+      node.textContent = value;
+    } else if (key.startsWith('on')) {
+      node.addEventListener(key.slice(2), value);
+    } else if (value !== undefined && value !== null && value !== false) {
+      node.setAttribute(key, value === true ? '' : value);
+    }
+  }
+  for (const child of children.flat()) {
+    if (child !== null && child !== undefined && child !== false) {
+      node.append(child);
+    }
+  }
+  return node;
+}
+
+function icon(name) {
+  const ns = 'http://www.w3.org/2000/svg';
+  const svg = document.createElementNS(ns, 'svg');
+  svg.setAttribute('viewBox', '0 0 24 24');
+  svg.setAttribute('aria-hidden', 'true');
+  svg.classList.add('icon');
+  for (const d of ICONS[name] || []) {
+    const path = document.createElementNS(ns, 'path');
+    path.setAttribute('d', d);
+    svg.append(path);
+  }
+  return svg;
+}
+
+function pref(name) {
+  return state.prefs[name];
+}
+
+function hasPref(name) {
+  return name in state.prefs;
+}
+
+function flag(name) {
+  return state.flags.find(f => f.name === name);
+}
+
+function setPref(name, value) {
+  chrome.send('setPref', [name, value]);
+}
+
+function setFlag(name, value) {
+  chrome.send('setFlag', [name, value]);
+}
+
+// A flag shown as a switch: single-value flags use "enabled"; multi-value
+// ones are on when option `onOption` is selected (0 = default = off).
+function flagIsOn(spec) {
+  const f = flag(spec.flag);
+  if (!f) {
+    return false;
+  }
+  const on = f.kind === 'single' ? f.enabled : f.selected === (spec.onOption ?? 1);
+  return spec.invert ? !on : on;
+}
+
+function setFlagOn(spec, on) {
+  const f = flag(spec.flag);
+  if (!f) {
+    return;
+  }
+  const wanted = spec.invert ? !on : on;
+  setFlag(spec.flag, f.kind === 'single' ? wanted : (wanted ? (spec.onOption ?? 1) : 0));
+}
+
+// ----------------------------------------------------------------- controls
+
+function toggleRow({label, hint, checked, onChange, restart, disabled}) {
+  const id = `t${Math.random().toString(36).slice(2)}`;
+  const input = el('input', {type: 'checkbox', role: 'switch', id, class: 'switch-input', disabled, 'data-key': label});
+  input.checked = !!checked;
+  input.addEventListener('change', () => onChange(input.checked));
+  return el('div', {class: `row${disabled ? ' disabled' : ''}`},
+            el('label', {class: 'row-text', for: id},
+               el('span', {class: 'row-label'}, label, restart ? el('span', {class: 'pill', text: '↻'}) : null),
+               hint ? el('span', {class: 'row-hint', text: hint}) : null),
+            el('span', {class: 'switch'}, input, el('span', {class: 'switch-track', 'aria-hidden': 'true'})));
+}
+
+function selectRow({label, hint, value, options, onChange, restart, disabled}) {
+  const select = el('select', {class: 'select', disabled, 'aria-label': label, 'data-key': label});
+  for (const option of options) {
+    const node = el('option', {value: String(option.value), text: option.label});
+    if (String(option.value) === String(value)) {
+      node.selected = true;
+    }
+    select.append(node);
+  }
+  select.addEventListener('change', () => {
+    const option = options[select.selectedIndex];
+    onChange(option.value);
+  });
+  return el('div', {class: `row${disabled ? ' disabled' : ''}`},
+            el('div', {class: 'row-text'},
+               el('span', {class: 'row-label'}, label, restart ? el('span', {class: 'pill', text: '↻'}) : null),
+               hint ? el('span', {class: 'row-hint', text: hint}) : null),
+            select);
+}
+
+function segmented({label, value, options, onChange}) {
+  const group = el('div', {class: 'segmented', role: 'radiogroup', 'aria-label': label});
+  for (const option of options) {
+    const button = el('button', {
+      class: `segment${option.value === value ? ' active' : ''}`,
+      role: 'radio',
+      'aria-checked': option.value === value ? 'true' : 'false',
+      text: option.label,
+      'data-key': `${label}/${option.value}`,
+      onclick: () => onChange(option.value),
+    });
+    group.append(button);
+  }
+  return el('div', {class: 'field'}, el('div', {class: 'field-label', text: label}), group);
+}
+
+function linkRow({label, hint, onClick}) {
+  return el('button', {class: 'row link-row', onclick: onClick},
+            el('span', {class: 'row-text'},
+               el('span', {class: 'row-label', text: label}),
+               hint ? el('span', {class: 'row-hint', text: hint}) : null),
+            el('span', {class: 'chevron', 'aria-hidden': 'true', text: '›'}));
+}
+
+function card(title, ...children) {
+  return el('section', {class: 'card'}, title ? el('h3', {class: 'card-title', text: title}) : null, ...children);
+}
+
+function sectionHeader(titleKey, hintKey) {
+  return el('header', {class: 'section-header'},
+            el('h2', {text: t(titleKey)}),
+            el('p', {class: 'muted', text: t(hintKey)}));
+}
+
+function openUrl(url) {
+  window.open(url, '_blank');
+}
+
+// --------------------------------------------------------------- appearance
+
+function themeColor() {
+  return state.theme.color || DEFAULT_COLOR;
+}
+
+function applyAccent() {
+  document.documentElement.style.setProperty('--user', themeColor());
+}
+
+function buildAppearance() {
+  const theme = state.theme;
+  const color = themeColor();
+
+  const swatches = el('div', {class: 'swatches'});
+  for (const preset of PRESETS) {
+    const active = preset.color.toLowerCase() === color.toLowerCase();
+    const swatch = el('button', {
+      class: `swatch${active ? ' active' : ''}`,
+      title: t(preset.key),
+      'aria-label': t(preset.key),
+      'aria-pressed': active ? 'true' : 'false',
+      onclick: () => chrome.send('setThemeColor', [preset.color, theme.variant === 'system' ? 'tonal' : theme.variant]),
+    });
+    swatch.style.setProperty('--swatch', preset.color);
+    swatches.append(el('div', {class: 'swatch-wrap'}, swatch, el('span', {class: 'swatch-name', text: t(preset.key)})));
+  }
+
+  const picker = el('input', {type: 'color', class: 'color-input', value: color, 'aria-label': t('customColor')});
+  picker.addEventListener('input', () => document.documentElement.style.setProperty('--user', picker.value));
+  picker.addEventListener('change', () =>
+      chrome.send('setThemeColor', [picker.value, theme.variant === 'system' ? 'tonal' : theme.variant]));
+
+  const preview = el('div', {class: 'preview', 'aria-label': t('preview')},
+                     el('div', {class: 'pv-frame'},
+                        el('div', {class: 'pv-tabs'},
+                           el('span', {class: 'pv-tab active', text: t('previewTab')}),
+                           el('span', {class: 'pv-tab'}), el('span', {class: 'pv-tab'})),
+                        el('div', {class: 'pv-toolbar'},
+                           el('span', {class: 'pv-dot'}), el('span', {class: 'pv-dot'}),
+                           el('span', {class: 'pv-omnibox', text: t('previewAddress')}),
+                           el('span', {class: 'pv-dot accent'}))),
+                     el('div', {class: 'pv-page'},
+                        el('span', {class: 'pv-line wide'}), el('span', {class: 'pv-line'}),
+                        el('span', {class: 'pv-button'})));
+
+  return el('div', {},
+            sectionHeader('appearanceTitle', 'appearanceHint'),
+            theme.extensionTheme ? el('div', {class: 'notice', text: t('extensionTheme')}) : null,
+            el('div', {class: 'grid-2'},
+               card(t('presets'), swatches,
+                    el('div', {class: 'custom-color'},
+                       picker,
+                       el('div', {class: 'row-text'},
+                          el('span', {class: 'row-label', text: t('customColor')}),
+                          el('span', {class: 'row-hint', text: t('customColorHint')})))),
+               card(t('preview'), preview)),
+            card(null,
+                 segmented({
+                   label: t('variant'),
+                   value: theme.variant === 'system' ? 'tonal' : theme.variant,
+                   options: [
+                     {value: 'tonal', label: t('variantTonal')},
+                     {value: 'neutral', label: t('variantNeutral')},
+                     {value: 'vibrant', label: t('variantVibrant')},
+                     {value: 'expressive', label: t('variantExpressive')},
+                   ],
+                   onChange: v => chrome.send('setThemeColor', [color, v]),
+                 }),
+                 segmented({
+                   label: t('scheme'),
+                   value: theme.scheme,
+                   options: [
+                     {value: 'system', label: t('schemeSystem')},
+                     {value: 'light', label: t('schemeLight')},
+                     {value: 'dark', label: t('schemeDark')},
+                   ],
+                   onChange: v => chrome.send('setColorScheme', [v]),
+                 }),
+                 toggleRow({
+                   label: t('grayscale'), hint: t('grayscaleHint'), checked: theme.grayscale,
+                   onChange: on => chrome.send('setGrayscale', [on]),
+                 }),
+                 flag('enable-incognito-themes') ? toggleRow({
+                   label: t('incognitoThemes'), hint: t('incognitoThemesHint'), restart: true,
+                   checked: flagIsOn({flag: 'enable-incognito-themes'}),
+                   onChange: on => setFlagOn({flag: 'enable-incognito-themes'}, on),
+                 }) : null,
+                 el('div', {class: 'actions'},
+                    el('button', {class: 'button ghost', text: t('resetTheme'), onclick: () => chrome.send('resetTheme')}))));
+}
+
+// ------------------------------------------------------------------- layout
+
+function prefToggle(name, labelKey, hintKey) {
+  if (!hasPref(name)) {
+    return null;
+  }
+  return toggleRow({
+    label: t(labelKey), hint: hintKey ? t(hintKey) : null, checked: pref(name),
+    onChange: on => setPref(name, on),
+  });
+}
+
+function flagToggle(spec, labelKey, hintKey) {
+  if (!flag(spec.flag)) {
+    return null;
+  }
+  return toggleRow({
+    label: t(labelKey), hint: hintKey ? t(hintKey) : null, restart: true,
+    checked: flagIsOn(spec), onChange: on => setFlagOn(spec, on),
+  });
+}
+
+function flagSelect(name, labelKey, optionKeys) {
+  const f = flag(name);
+  if (!f || f.kind !== 'multi') {
+    return null;
+  }
+  return selectRow({
+    label: t(labelKey), restart: true, value: f.selected,
+    options: optionKeys.map((key, index) => ({value: index, label: t(key)})),
+    onChange: v => setFlag(name, Number(v)),
+  });
+}
+
+function buildLayout() {
+  const vertical = hasPref('vertical_tabs.enabled') && pref('vertical_tabs.enabled');
+  return el('div', {},
+            sectionHeader('layoutTitle', 'layoutHint'),
+            card(null,
+                 prefToggle('vertical_tabs.enabled', 'verticalTabs', 'verticalTabsHint'),
+                 vertical ? prefToggle('vertical_tabs.expand_on_hover', 'expandOnHover') : null,
+                 flagToggle({flag: 'hivey-compact-ui'}, 'compactMode', 'compactModeHint'),
+                 hasPref('side_panel.is_right_aligned') ? selectRow({
+                   label: t('sidePanel'), value: pref('side_panel.is_right_aligned') ? 1 : 0,
+                   options: [{value: 0, label: t('left')}, {value: 1, label: t('right')}],
+                   onChange: v => setPref('side_panel.is_right_aligned', Number(v) === 1),
+                 }) : null),
+            card(null,
+                 prefToggle('browser.show_home_button', 'homeButton'),
+                 prefToggle('browser.show_forward_button', 'forwardButton'),
+                 prefToggle('bookmark_bar.show_on_all_tabs', 'bookmarkBar'),
+                 flagToggle({flag: 'bookmark-bar-ntp'}, 'bookmarkBarNtp'),
+                 prefToggle('tab_search.pinned_to_tabstrip', 'tabSearch'),
+                 flagToggle({flag: 'hide-extensions-menu'}, 'hideExtensionsMenu'),
+                 flagToggle({flag: 'remove-grab-handle'}, 'removeGrabHandle'),
+                 flagSelect('show-avatar-button', 'avatarButton',
+                            ['avatarDefault', 'avatarAlways', 'avatarIncognito', 'avatarNever']),
+                 linkRow({
+                   label: t('customizeToolbar'), hint: t('customizeToolbarHint'),
+                   onClick: () => chrome.send('openCustomizeToolbar'),
+                 })));
+}
+
+// --------------------------------------------------------------------- tabs
+
+function buildTabs() {
+  return el('div', {},
+            sectionHeader('tabsTitle', 'tabsHint'),
+            card(null,
+                 prefToggle('browser.ctrl_tab_mru', 'ctrlTabMru'),
+                 flagSelect('scroll-tabs', 'scrollTabs', ['scrollTabsDefault', 'scrollTabsAlways', 'scrollTabsNever']),
+                 flagToggle({flag: 'close-window-with-last-tab'}, 'keepWindow'),
+                 flagToggle({flag: 'hide-tab-close-buttons'}, 'hideCloseButtons', 'hideCloseButtonsHint'),
+                 flagToggle({flag: 'popups-to-tabs'}, 'popupsToTabs'),
+                 flagToggle({flag: 'disable-link-drag'}, 'disableLinkDrag'),
+                 flagToggle({flag: 'hide-fullscreen-exit-ui'}, 'hideFullscreenExit'),
+                 flagSelect('close-confirmation', 'closeConfirmation',
+                            ['closeConfirmationDefault', 'closeConfirmationLast', 'closeConfirmationMultiple'])),
+            card(null,
+                 flagSelect('tab-hover-cards', 'hoverCards', ['hoverCardsDefault', 'hoverCardsNone', 'hoverCardsTooltip']),
+                 prefToggle('browser.hovercard.image_previews_enabled', 'hoverImages'),
+                 prefToggle('browser.hovercard.memory_usage_enabled', 'hoverMemory')));
+}
+
+// ---------------------------------------------------------------- resources
+
+function formatMb(mb) {
+  return mb >= 1024 ? `${(mb / 1024).toFixed(1)} GB` : `${Math.round(mb)} MB`;
+}
+
+function formatRate(kbps) {
+  return kbps >= 1000 ? `${(kbps / 1000).toFixed(1)} Mb/s` : `${Math.round(kbps)} kb/s`;
+}
+
+function gauge(id, labelKey) {
+  return el('div', {class: 'gauge', id},
+            el('div', {class: 'gauge-ring'}, el('div', {class: 'gauge-value', text: '–'})),
+            el('div', {class: 'gauge-label', text: t(labelKey)}),
+            el('div', {class: 'gauge-sub muted', text: ''}));
+}
+
+function buildResources() {
+  const memoryOptions = [0, 2, 4, 6, 8, 12, 16].map(gb => ({value: gb * 1024, label: gb ? `${gb} GB` : t('noLimit')}));
+  const cpuOptions = [0, 10, 25, 50, 75].map(p => ({value: p, label: p ? `${p} % ${t('perTab')}` : t('noLimit')}));
+  const networkOptions = [0, 1, 5, 10, 25, 50, 100].map(m => ({value: m * 1000, label: m ? `${m} Mb/s` : t('noLimit')}));
+  return el('div', {},
+            sectionHeader('resourcesTitle', 'resourcesHint'),
+            el('div', {class: 'gauges'}, gauge('gauge-cpu', 'cpu'), gauge('gauge-ram', 'ram'), gauge('gauge-net', 'network')),
+            card(null,
+                 hasPref('hivey.memory_limit_mb') ? selectRow({
+                   label: t('ramLimiter'), hint: t('ramLimiterHint'), value: pref('hivey.memory_limit_mb'),
+                   options: memoryOptions, onChange: v => setPref('hivey.memory_limit_mb', Number(v)),
+                 }) : null,
+                 hasPref('hivey.cpu_limit_percent') ? selectRow({
+                   label: t('cpuLimiter'),
+                   hint: state.cpuLimiterSupported ? t('cpuLimiterHint') : t('cpuLimiterUnsupported'),
+                   value: pref('hivey.cpu_limit_percent'), options: cpuOptions,
+                   disabled: !state.cpuLimiterSupported,
+                   onChange: v => setPref('hivey.cpu_limit_percent', Number(v)),
+                 }) : null,
+                 hasPref('hivey.network_limit_kbps') ? selectRow({
+                   label: t('networkLimiter'), hint: t('networkLimiterHint'), value: pref('hivey.network_limit_kbps'),
+                   options: networkOptions, onChange: v => setPref('hivey.network_limit_kbps', Number(v)),
+                 }) : null,
+                 linkRow({label: t('memorySaver'), onClick: () => openUrl('chrome://settings/performance')})),
+            card(t('hotTabs'),
+                 el('p', {class: 'muted small', text: t('hotTabsHint')}),
+                 el('ol', {class: 'tasks', id: 'tasks'})));
+}
+
+function setGauge(id, fraction, value, sub) {
+  const node = document.getElementById(id);
+  if (!node) {
+    return;
+  }
+  node.querySelector('.gauge-ring').style.setProperty('--fill', String(Math.max(0, Math.min(1, fraction))));
+  node.querySelector('.gauge-value').textContent = value;
+  node.querySelector('.gauge-sub').textContent = sub;
+}
+
+function onUsage(usage) {
+  const cores = Math.max(1, usage.cores);
+  const cpuShare = usage.cpu / cores;
+  setGauge('gauge-cpu', cpuShare / 100, `${Math.round(cpuShare)} %`, t('ofMachine'));
+  const limitMb = pref('hivey.memory_limit_mb') || 0;
+  setGauge('gauge-ram', limitMb ? usage.memoryMb / limitMb : Math.min(1, usage.memoryMb / 8192),
+           formatMb(usage.memoryMb), limitMb ? `/ ${formatMb(limitMb)}` : '');
+  const limitKbps = pref('hivey.network_limit_kbps') || 0;
+  setGauge('gauge-net', limitKbps ? usage.networkKbps / limitKbps : Math.min(1, usage.networkKbps / 50000),
+           formatRate(usage.networkKbps), limitKbps ? `/ ${formatRate(limitKbps)}` : '');
+
+  const list = document.getElementById('tasks');
+  if (!list) {
+    return;
+  }
+  const hot = usage.tasks.filter(task => task.type !== 1 /* BROWSER */)
+                  .sort((a, b) => (b.cpu - a.cpu) || (b.memoryMb - a.memoryMb))
+                  .slice(0, 8);
+  list.replaceChildren(...hot.map(task => el('li', {class: 'task'},
+      el('span', {class: 'task-title', title: task.title, text: task.title}),
+      el('span', {class: 'task-metric', text: `${Math.round(task.cpu / cores)} %`}),
+      el('span', {class: 'task-metric', text: formatMb(task.memoryMb)}),
+      el('span', {class: 'task-metric', text: formatRate(task.networkKbps)}),
+      el('span', {class: 'task-actions'},
+         task.isTab ? el('button', {class: 'button small ghost', text: t('show'),
+                                    onclick: () => chrome.send('taskAction', ['activate', task.id])}) : null,
+         task.killable ? el('button', {class: 'button small danger', text: t('close'),
+                                       onclick: () => chrome.send('taskAction', ['kill', task.id])}) : null))));
+}
+
+function updateUsageSubscription() {
+  const wanted = current === 'resources' && document.visibilityState === 'visible';
+  if (wanted !== usageStarted) {
+    usageStarted = wanted;
+    chrome.send(wanted ? 'startUsage' : 'stopUsage');
+  }
+}
+
+// ------------------------------------------------------------------ privacy
+
+function buildPrivacy() {
+  const shield = state.shield;
+  const shieldStatus = !shield.installed ? 'shieldMissing' : (shield.enabled ? 'shieldOn' : 'shieldOff');
+  return el('div', {},
+            sectionHeader('privacyTitle', 'privacyHint'),
+            el('div', {class: 'card shield-card'},
+               el('div', {class: 'shield-badge'}, icon('shield')),
+               el('div', {class: 'row-text'},
+                  el('span', {class: 'row-label'}, t('shield'),
+                     el('span', {class: `status ${shield.enabled ? 'ok' : 'warn'}`, text: t(shieldStatus)})),
+                  el('span', {class: 'row-hint', text: t('shieldHint')})),
+               el('button', {class: 'button ghost', text: t('manage'),
+                             onclick: () => openUrl(`chrome://extensions/?id=${shield.id}`)})),
+            card(null,
+                 flagToggle({flag: 'disable-fingerprinting-noise', invert: true}, 'antiFingerprint', 'antiFingerprintHint'),
+                 prefToggle('https_only_mode_enabled', 'httpsOnly', 'httpsOnlyHint'),
+                 flagToggle({flag: 'clear-data-on-exit'}, 'clearOnExit', 'clearOnExitHint'),
+                 linkRow({label: t('secureDns'), onClick: () => openUrl('chrome://settings/security')}),
+                 linkRow({label: t('cookies'), onClick: () => openUrl('chrome://settings/cookies')})),
+            card(t('builtIn'), el('p', {class: 'muted', text: t('builtInItems')})));
+}
+
+// -------------------------------------------------------------------- about
+
+function buildAbout() {
+  return el('div', {},
+            sectionHeader('aboutTitle', 'aboutText'),
+            card(null,
+                 el('div', {class: 'row'},
+                    el('span', {class: 'row-label', text: t('version')}),
+                    el('span', {class: 'mono', text: state.version})),
+                 linkRow({label: t('sourceCode'),
+                          onClick: () => openUrl('https://github.com/FlorianMartins/hivey-browser')}),
+                 linkRow({label: t('flags'), onClick: () => openUrl('chrome://flags')})));
+}
+
+// ---------------------------------------------------------------- page shell
+
+function buildNav() {
+  const nav = document.getElementById('nav');
+  nav.replaceChildren(...SECTIONS.map(section => el('button', {
+    class: `nav-item${section.id === current ? ' active' : ''}`,
+    'aria-current': section.id === current ? 'page' : null,
+    onclick: () => select(section.id),
+  }, icon(section.icon), el('span', {text: t(section.nav)}))));
+}
+
+function render() {
+  applyAccent();
+  buildNav();
+  const section = SECTIONS.find(s => s.id === current);
+  const main = document.getElementById('main');
+  main.replaceChildren(section.build());
+  document.getElementById('restart').hidden = !state.restartNeeded;
+  updateUsageSubscription();
+}
+
+function select(id) {
+  if (id === current) {
+    return;
+  }
+  current = id;
+  history.replaceState(null, '', `#${id}`);
+  render();
+  document.getElementById('main').focus({preventScroll: true});
+  window.scrollTo({top: 0});
+}
+
+function buildShell() {
+  document.getElementById('title').textContent = t('title');
+  document.getElementById('subtitle').textContent = t('subtitle');
+  document.title = t('title');
+  const bar = document.getElementById('restart');
+  bar.replaceChildren(icon('restart'), el('span', {text: t('restartNeeded')}),
+                      el('button', {class: 'button primary', text: t('restart'), onclick: () => chrome.send('restart')}));
+}
+
+async function main() {
+  state = await sendWithPromise('getState');
+  setLanguage(state.language);
+  const fromHash = location.hash.slice(1);
+  if (SECTIONS.some(s => s.id === fromHash)) {
+    current = fromHash;
+  }
+  buildShell();
+  render();
+  addWebUiListener('hivey-state', newState => {
+    state = newState;
+    // Re-render after the current event, keeping keyboard focus on the
+    // control the user just used.
+    setTimeout(() => {
+      const key = document.activeElement?.dataset?.key;
+      render();
+      if (key) {
+        document.querySelector(`[data-key="${CSS.escape(key)}"]`)?.focus();
+      }
+    });
+  });
+  addWebUiListener('hivey-usage', onUsage);
+  document.addEventListener('visibilitychange', updateUsageSubscription);
+}
+
+main();
