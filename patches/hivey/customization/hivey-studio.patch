+export function setLanguage(locale) {
+  current = (locale || '').toLowerCase().startsWith('fr') ? STRINGS.fr : STRINGS.en;
+  document.documentElement.lang = current === STRINGS.fr ? 'fr' : 'en';
+}
+
+export function t(key) {
+  return current[key] ?? STRINGS.en[key] ?? key;
