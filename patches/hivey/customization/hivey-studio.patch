+        name, base::BindRepeating(method, base::Unretained(this)));
+  };
+  add("getState", &HiveyStudioHandler::HandleGetState);
+  add("setThemeColor", &HiveyStudioHandler::HandleSetThemeColor);
+  add("setColorScheme", &HiveyStudioHandler::HandleSetColorScheme);
+  add("setGrayscale", &HiveyStudioHandler::HandleSetGrayscale);
+  add("resetTheme", &HiveyStudioHandler::HandleResetTheme);
+  add("setPref", &HiveyStudioHandler::HandleSetPref);
+  add("setFlag", &HiveyStudioHandler::HandleSetFlag);
+  add("restart", &HiveyStudioHandler::HandleRestart);
+  add("startUsage", &HiveyStudioHandler::HandleStartUsage);
+  add("stopUsage", &HiveyStudioHandler::HandleStopUsage);
+  add("taskAction", &HiveyStudioHandler::HandleTaskAction);
+  add("openCustomizeToolbar", &HiveyStudioHandler::HandleOpenCustomizeToolbar);
+}
