+
+Profile* HiveyStudioHandler::GetProfile() {
+  return Profile::FromWebUI(web_ui());
+}
+
+base::DictValue HiveyStudioHandler::BuildThemeState() {
+  ThemeService* theme = ThemeServiceFactory::GetForProfile(GetProfile());
+  std::string variant = "system";
+  for (const auto& [name, value] : kVariants) {
+    if (value == theme->GetBrowserColorVariant()) {
+      variant = std::string(name);
+    }
+  }
+  std::string scheme = "system";
+  for (const auto& [name, value] : kSchemes) {
+    if (value == theme->GetBrowserColorScheme()) {
+      scheme = std::string(name);
+    }
+  }
+  const std::optional<SkColor> color = theme->GetUserColor();
+  return base::DictValue()
+      .Set("color", color ? ColorToHex(*color) : std::string())
+      .Set("variant", variant)
+      .Set("scheme", scheme)
+      .Set("grayscale", theme->GetIsGrayscale())
+      .Set("extensionTheme", theme->UsingExtensionTheme());
+}
+
+base::DictValue HiveyStudioHandler::BuildPrefsState() {
+  base::DictValue prefs;
+  for (const AllowedPref& pref : kAllowedPrefs) {
+    PrefService* service = pref.local_state ? g_browser_process->local_state()
+                                            : GetProfile()->GetPrefs();
+    if (const PrefService::Preference* p =
+            service ? service->FindPreference(pref.name) : nullptr) {
+      prefs.Set(pref.name, p->GetValue()->Clone());
+    }
+  }
+  return prefs;
+}
+
+base::ListValue HiveyStudioHandler::BuildFlagsState() {
+  flags_ui::PrefServiceFlagsStorage storage(g_browser_process->local_state());
+  base::ListValue supported;
+  base::ListValue unsupported;
+  about_flags::GetFlagFeatureEntries(&storage, flags_ui::kOwnerAccessToFlags,
+                                     supported, unsupported);
+  base::ListValue flags;
+  for (const base::Value& entry : supported) {
+    const base::DictValue& dict = entry.GetDict();
+    const std::string* name = dict.FindString("internal_name");
+    if (!name || !IsCuratedFlag(*name)) {
+      continue;
+    }
+    base::DictValue flag;
+    flag.Set("name", *name);
+    if (const base::ListValue* options = dict.FindList("options")) {
+      int selected = 0;
+      for (size_t i = 0; i < options->size(); ++i) {
+        if ((*options)[i].GetDict().FindBool("selected").value_or(false)) {
+          selected = static_cast<int>(i);
+        }
+      }
+      flag.Set("kind", "multi");
+      flag.Set("selected", selected);
+      flag.Set("options", static_cast<int>(options->size()));
+    } else {
+      flag.Set("kind", "single");
+      flag.Set("enabled", dict.FindBool("enabled").value_or(false));
+    }
+    flags.Append(std::move(flag));
+  }
+  return flags;
+}
+
+base::DictValue HiveyStudioHandler::BuildShieldState() {
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(GetProfile());
+  return base::DictValue()
+      .Set("id", HIVEY_BUNDLED_SHIELD_ID)
+      .Set("installed",
+           registry->GetInstalledExtension(HIVEY_BUNDLED_SHIELD_ID) != nullptr)
+      .Set("enabled",
+           registry->enabled_extensions().Contains(HIVEY_BUNDLED_SHIELD_ID));
+}
+
+base::DictValue HiveyStudioHandler::BuildState() {
+#if BUILDFLAG(IS_WIN)
+  const char* platform = "win";
+#elif BUILDFLAG(IS_LINUX)
+  const char* platform = "linux";
+#else
+  const char* platform = "other";
+#endif
+  return base::DictValue()
+      .Set("language", g_browser_process->GetApplicationLocale())
+      .Set("platform", platform)
+      .Set("version", version_info::GetVersionNumber())
+      .Set("cpuLimiterSupported", hivey::IsCpuLimiterSupported())
+      .Set("theme", BuildThemeState())
+      .Set("prefs", BuildPrefsState())
+      .Set("flags", BuildFlagsState())
+      .Set("shield", BuildShieldState())
+      .Set("restartNeeded", about_flags::IsRestartNeededToCommitChanges());
+}
+
+void HiveyStudioHandler::FireStateChanged() {
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("hivey-state", BuildState());
+  }
+}
+
+void HiveyStudioHandler::HandleGetState(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], BuildState());
+}
+
+void HiveyStudioHandler::HandleSetThemeColor(const base::ListValue& args) {
+  const std::string* hex = args[0].GetIfString();
+  const std::string* variant_name = args[1].GetIfString();
+  const std::optional<SkColor> color = hex ? HexToColor(*hex) : std::nullopt;
+  if (!color || !variant_name) {
+    return;
+  }
+  auto variant = kVariants.find(*variant_name);
+  ThemeServiceFactory::GetForProfile(GetProfile())
+      ->SetUserColorAndBrowserColorVariant(
+          *color, variant != kVariants.end()
+                      ? variant->second
+                      : ui::mojom::BrowserColorVariant::kTonalSpot);
+  FireStateChanged();
+}
+
+void HiveyStudioHandler::HandleSetColorScheme(const base::ListValue& args) {
+  const std::string* name = args[0].GetIfString();
+  auto scheme = name ? kSchemes.find(*name) : kSchemes.end();
+  if (scheme == kSchemes.end()) {
+    return;
+  }
+  ThemeServiceFactory::GetForProfile(GetProfile())
+      ->SetBrowserColorScheme(scheme->second);
+  FireStateChanged();
+}
+
+void HiveyStudioHandler::HandleSetGrayscale(const base::ListValue& args) {
+  if (std::optional<bool> on = args[0].GetIfBool()) {
+    ThemeServiceFactory::GetForProfile(GetProfile())->SetIsGrayscale(*on);
+    FireStateChanged();
+  }
+}
+
+void HiveyStudioHandler::HandleResetTheme(const base::ListValue& args) {
+  ThemeService* theme = ThemeServiceFactory::GetForProfile(GetProfile());
+  theme->UseDefaultTheme();
+  theme->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kSystem);
+  theme->SetIsGrayscale(false);
+  FireStateChanged();
+}
+
+void HiveyStudioHandler::HandleSetPref(const base::ListValue& args) {
+  const std::string* name = args[0].GetIfString();
+  const AllowedPref* allowed = name ? FindAllowedPref(*name) : nullptr;
+  if (!allowed) {
+    return;
+  }
+  PrefService* service = allowed->local_state
+                             ? g_browser_process->local_state()
+                             : GetProfile()->GetPrefs();
+  const PrefService::Preference* pref =
+      service ? service->FindPreference(*name) : nullptr;
+  if (!pref || !pref->IsUserModifiable()) {
+    return;
+  }
+  const base::Value& value = args[1];
+  if (pref->GetType() == base::Value::Type::BOOLEAN && value.is_bool()) {
+    service->SetBoolean(*name, value.GetBool());
+  } else if (pref->GetType() == base::Value::Type::INTEGER &&
+             (value.is_int() || value.is_double())) {
+    service->SetInteger(*name, static_cast<int>(value.GetDouble()));
+  } else {
+    return;
+  }
+  FireStateChanged();
+}
+
+void HiveyStudioHandler::HandleSetFlag(const base::ListValue& args) {
+  const std::string* name = args[0].GetIfString();
+  if (!name || !IsCuratedFlag(*name)) {
+    return;
+  }
+  flags_ui::PrefServiceFlagsStorage storage(g_browser_process->local_state());
+  if (args[1].is_bool()) {
+    about_flags::SetFeatureEntryEnabled(&storage, *name, args[1].GetBool());
+  } else if (args[1].is_int() || args[1].is_double()) {
+    const int option = static_cast<int>(args[1].GetDouble());
+    if (option < 0) {
+      return;
+    }
+    about_flags::SetFeatureEntryEnabled(
+        &storage, *name + "@" + base::NumberToString(option), true);
+  } else {
+    return;
+  }
+  FireStateChanged();
+}
+
+void HiveyStudioHandler::HandleRestart(const base::ListValue& args) {
+  chrome::AttemptRestart();
+}
+
+void HiveyStudioHandler::HandleStartUsage(const base::ListValue& args) {
+  AllowJavascript();
+  if (!usage_observer_) {
+    usage_observer_ = std::make_unique<UsageObserver>(base::BindRepeating(
+        &HiveyStudioHandler::OnUsageRefreshed, base::Unretained(this)));
+  }
+}
+
+void HiveyStudioHandler::HandleStopUsage(const base::ListValue& args) {
+  usage_observer_.reset();
+}
+
+void HiveyStudioHandler::OnUsageRefreshed(base::DictValue usage) {
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("hivey-usage", usage);
+  }
+}
+
+void HiveyStudioHandler::HandleTaskAction(const base::ListValue& args) {
+  const std::string* action = args[0].GetIfString();
+  // Task IDs arrive as integers or doubles, depending on their size.
+  if (!action || !(args[1].is_int() || args[1].is_double()) ||
+      !usage_observer_) {
+    return;
+  }
+  task_manager::TaskManagerInterface* tm =
+      task_manager::TaskManagerInterface::GetTaskManager();
+  const auto id = static_cast<task_manager::TaskId>(args[1].GetDouble());
+  if (!tm->IsTaskValid(id)) {
+    return;
+  }
+  if (*action == "activate") {
+    tm->ActivateTask(id);
+  } else if (*action == "kill" && tm->IsTaskKillable(id)) {
+    tm->KillTask(id);
+  }
+}
+
+void HiveyStudioHandler::HandleOpenCustomizeToolbar(
+    const base::ListValue& args) {
+  if (BrowserWindowInterface* browser =
+          GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+              web_ui()->GetWebContents())) {
+    chrome::ExecuteCommand(browser, IDC_SHOW_CUSTOMIZE_CHROME_TOOLBAR);
+  }
+}
