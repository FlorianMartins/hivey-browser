-HiveyBarView::~HiveyBarView() {
-  chrome::RemoveCommandObserver(browser_view_->browser(), IDC_BACK, this);
-  chrome::RemoveCommandObserver(browser_view_->browser(), IDC_FORWARD, this);
+  // Google is the default search engine: a profile still on DuckDuckGo
+  // (Hivey's default before 156.0.8078.4707) moves to Google, once.
+  TemplateURLService* search = TemplateURLServiceFactory::GetForProfile(profile);
+  if (search && !profile->GetPrefs()->GetBoolean(
+                    hivey::kHiveyGoogleDefaultApplied)) {
+    search_loaded_subscription_ =
+        search->RegisterOnLoadedCallback(base::BindOnce(
+            [](TemplateURLService* search, PrefService* prefs) {
+              if (prefs->GetBoolean(hivey::kHiveyGoogleDefaultApplied)) {
+                return;
+              }
+              prefs->SetBoolean(hivey::kHiveyGoogleDefaultApplied, true);
+              // Prepopulated engine ids (prepopulated_engines.json).
+              constexpr int kGoogleId = 1;
+              constexpr int kDuckDuckGoId = 92;
+              const TemplateURL* current = search->GetDefaultSearchProvider();
+              if (!current || search->is_default_search_managed() ||
+                  current->prepopulate_id() != kDuckDuckGoId) {
+                return;
+              }
+              for (TemplateURL* engine : search->GetTemplateURLs()) {
+                if (engine->prepopulate_id() == kGoogleId) {
+                  search->SetUserSelectedDefaultSearchProvider(engine);
+                  return;
+                }
+              }
+            },
+            search, profile->GetPrefs()));
+    search->Load();
+  }
 }
 
