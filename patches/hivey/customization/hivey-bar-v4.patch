+// The portable package is not installed by a package manager: its desktop
+// entry goes to $XDG_DATA_HOME/applications, launching this copy (through its
+// launcher script, CHROME_WRAPPER, when there is one).
+bool InstallDesktopEntry(base::Environment* env) {
+  base::FilePath program;
+  if (std::optional<std::string> wrapper = env->GetVar("CHROME_WRAPPER")) {
+    program = base::FilePath(*wrapper);
+  } else if (!base::PathService::Get(base::FILE_EXE, &program)) {
+    return false;
+  }
+  const base::FilePath dir =
+      base::nix::GetXDGDataWriteLocation(env).Append("applications");
+  if (!base::CreateDirectory(dir)) {
+    return false;
+  }
+  const std::string entry = base::StrCat(
+      {"[Desktop Entry]\nVersion=1.0\nType=Application\nName=Hivey Browser\n"
+       "GenericName=Web Browser\n"
+       "Comment=Privacy-first, customizable web browser\nExec=\"",
+       program.value(),
+       "\" %U\nIcon=hivey-browser\nTerminal=false\n"
+       "Categories=Network;WebBrowser;\n"
+       "MimeType=text/html;text/xml;application/xhtml+xml;"
+       "x-scheme-handler/http;x-scheme-handler/https;\n"
+       "StartupWMClass=hivey-browser\n"});
+  return base::ImportantFileWriter::WriteFileAtomically(
+      dir.Append(kDesktopFileName), entry);
+}
