+void HiveyBarView::UpdateToolbarNavigation() {
+  ToolbarView* toolbar = browser_view_->toolbar();
+  if (!toolbar) {
+    return;
+  }
+  const bool in_bar = ShouldShow();
+  for (views::View* child : toolbar->children()) {
+    if (child->GetProperty(views::kElementIdentifierKey) ==
+        kToolbarBackButtonElementId) {
+      child->SetVisible(!in_bar);
+    }
+  }
+  if (views::View* forward = toolbar->forward_button()) {
+    forward->SetVisible(!in_bar &&
+                        prefs_.prefs()->GetBoolean(prefs::kShowForwardButton));
+  }
+  if (views::View* reload = toolbar->reload_button()) {
+    reload->SetVisible(!in_bar);
+  }
+  toolbar->InvalidateLayout();
+}
+
+void HiveyBarView::UpdateNavigationEnabled() {
+  BrowserWindowInterface* browser = browser_view_->browser();
+  if (back_button_) {
+    back_button_->SetEnabled(chrome::IsCommandEnabled(browser, IDC_BACK));
+  }
+  if (forward_button_) {
+    forward_button_->SetEnabled(chrome::IsCommandEnabled(browser, IDC_FORWARD));
+  }
+}
+
+void HiveyBarView::EnabledStateChangedForCommand(int id, bool enabled) {
+  if (id == IDC_BACK && back_button_) {
+    back_button_->SetEnabled(enabled);
+  } else if (id == IDC_FORWARD && forward_button_) {
+    forward_button_->SetEnabled(enabled);
+  }
+}
