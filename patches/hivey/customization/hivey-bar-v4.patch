+std::u16string HiveyBarView::ItemTitle(std::string_view id) const {
+  if (id == "back") {
+    return l10n_util::GetStringUTF16(IDS_ACCNAME_BACK);
+  }
+  if (id == "forward") {
+    return l10n_util::GetStringUTF16(IDS_ACCNAME_FORWARD);
+  }
+  if (id == "reload") {
+    return l10n_util::GetStringUTF16(IDS_ACCNAME_RELOAD);
+  }
+  if (id == "cyber") {
+    return u"Hivey Cyber";
+  }
+  if (id == "performance") {
+    return l10n_util::GetStringUTF16(IDS_HIVEY_BAR_PERFORMANCE);
+  }
+  if (id == "history") {
+    return l10n_util::GetStringUTF16(IDS_HIVEY_BAR_HISTORY);
+  }
+  if (id == "bookmarks") {
+    return l10n_util::GetStringUTF16(IDS_HIVEY_BAR_BOOKMARKS);
+  }
+  if (const base::DictValue* app =
+          hivey::FindHiveyBarApp(*prefs_.prefs(), id)) {
+    const std::string* title = app->FindString("title");
+    return base::UTF8ToUTF16(title ? *title : "");
+  }
+  const bool french =
+      base::StartsWith(g_browser_process->GetApplicationLocale(), "fr");
+  for (const HiveyBarWorkspace& workspace : kHiveyBarWorkspaces) {
+    if (id == workspace.mode) {
+      return base::UTF8ToUTF16(french ? workspace.title_fr
+                                      : workspace.title_en);
+    }
+  }
+  return std::u16string();
+}
