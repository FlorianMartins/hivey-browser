+std::vector<std::string> GetHiveyBarToolsOrder(const PrefService& prefs) {
+  std::vector<std::string> order;
+  auto add = [&](std::string_view id) {
+    if (std::ranges::contains(kHiveyBarTools, id) &&
+        !std::ranges::contains(order, id)) {
+      order.emplace_back(id);
+    }
+  };
+  for (const base::Value& id : prefs.GetList(kHiveyBarOrder)) {
+    if (id.is_string()) {
+      add(id.GetString());
+    }
+  }
+  for (const char* id : kHiveyBarTools) {
+    add(id);
+  }
+  return order;
+}
