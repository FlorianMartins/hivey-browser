+base::DictValue HiveyStudioHandler::BuildSearchState() {
+  // The search engines that may be the default (Google, DuckDuckGo, Brave,
+  // Startpage, Qwant, Ecosia... and the user's own), by GUID.
+  TemplateURLService* search =
+      TemplateURLServiceFactory::GetForProfile(GetProfile());
+  base::DictValue state;
+  if (!search || !search->loaded()) {
+    return state;
+  }
+  base::ListValue engines;
+  for (const TemplateURL* engine : search->GetTemplateURLs()) {
+    if (search->ShowInDefaultList(engine)) {
+      engines.Append(base::DictValue()
+                         .Set("id", engine->sync_guid())
+                         .Set("name", engine->short_name()));
+    }
+  }
+  const TemplateURL* current = search->GetDefaultSearchProvider();
+  state.Set("engines", std::move(engines));
+  state.Set("current", current ? current->sync_guid() : std::string());
+  state.Set("managed", search->is_default_search_managed());
+  return state;
+}
+
+void HiveyStudioHandler::HandleSetSearchEngine(const base::ListValue& args) {
+  const std::string* id = args.size() == 1 ? args[0].GetIfString() : nullptr;
+  TemplateURLService* search =
+      TemplateURLServiceFactory::GetForProfile(GetProfile());
+  if (!id || !search || !search->loaded() ||
+      search->is_default_search_managed()) {
+    return;
+  }
+  TemplateURL* engine = search->GetTemplateURLForGUID(*id);
+  if (engine && search->ShowInDefaultList(engine)) {
+    search->SetUserSelectedDefaultSearchProvider(engine);
+  }
+}
