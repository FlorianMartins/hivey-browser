+// ------------------------------------------------------------ drag and drop
+
+void HiveyBarView::WriteDragDataForView(views::View* sender,
+                                        const gfx::Point& press_pt,
+                                        ui::OSExchangeData* data) {
+  const Icon* icon = FindIcon(sender);
+  if (!icon) {
+    return;
+  }
+  data->SetString(base::UTF8ToUTF16(base::StrCat({kDragPrefix, icon->id})));
+  data->provider().SetDragImage(
+      icon->button->GetImage(views::Button::STATE_NORMAL),
+      press_pt.OffsetFromOrigin());
+}
+
+int HiveyBarView::GetDragOperationsForView(views::View* sender,
+                                           const gfx::Point& p) {
+  return ui::DragDropTypes::DRAG_MOVE;
+}
+
+bool HiveyBarView::CanStartDragForView(views::View* sender,
+                                       const gfx::Point& press_pt,
+                                       const gfx::Point& p) {
+  return views::View::ExceededDragThreshold(p - press_pt);
+}
+
+bool HiveyBarView::GetDropFormats(
+    int* formats,
+    std::set<ui::ClipboardFormatType>* format_types) {
+  *formats = ui::OSExchangeData::STRING;
+  return true;
+}
+
+bool HiveyBarView::AreDropTypesRequired() {
+  return true;
+}
+
+bool HiveyBarView::CanDrop(const OSExchangeData& data) {
+  return DraggedId(data).has_value();
+}
+
+int HiveyBarView::OnDragUpdated(const ui::DropTargetEvent& event) {
+  const std::optional<std::string> id = DraggedId(event.data());
+  drop_target_.reset();
+  if (id) {
+    drop_target_ =
+        GetDropTarget(event.location(), std::ranges::contains(
+                                            hivey::kHiveyBarTools, *id));
+  }
+  SchedulePaint();
+  return drop_target_ ? ui::DragDropTypes::DRAG_MOVE
+                      : ui::DragDropTypes::DRAG_NONE;
+}
+
+void HiveyBarView::OnDragExited() {
+  drop_target_.reset();
+  SchedulePaint();
+}
+
+views::View::DropCallback HiveyBarView::GetDropCallback(
+    const ui::DropTargetEvent& event) {
+  const std::optional<std::string> id = DraggedId(event.data());
+  const std::optional<DropTarget> target = drop_target_;
+  drop_target_.reset();
+  SchedulePaint();
+  if (!id || !target) {
+    return base::NullCallback();
+  }
+  return base::BindOnce(&HiveyBarView::PerformDrop, weak_factory_.GetWeakPtr(),
+                        *id, *target);
+}
+
+std::optional<HiveyBarView::DropTarget> HiveyBarView::GetDropTarget(
+    const gfx::Point& point,
+    bool tools) const {
+  views::View* group = tools ? tools_group_.get() : items_group_.get();
+  if (!group) {
+    return std::nullopt;
+  }
+  gfx::Point p = point;
+  views::View::ConvertPointToTarget(this, group, &p);
+  if (p.y() < -kBarWidth / 2 || p.y() > group->height() + kBarWidth / 2) {
+    return std::nullopt;  // over another group
+  }
+  DropTarget target;
+  target.tools = tools;
+  int line = 0;
+  for (views::View* child : group->children()) {
+    const Icon* icon = FindIcon(child);
+    if (!icon || !icon->movable) {
+      continue;
+    }
+    if (p.y() < child->bounds().CenterPoint().y()) {
+      target.before = icon->id;
+      line = child->y() - 2;
+      break;
+    }
+    line = child->bounds().bottom() + 2;
+  }
+  gfx::Point line_point(0, line);
+  views::View::ConvertPointToTarget(group, this, &line_point);
+  target.line_y = line_point.y();
+  return target;
+}
+
+void HiveyBarView::PerformDrop(
+    std::string id,
+    DropTarget target,
+    const ui::DropTargetEvent& event,
+    ui::mojom::DragOperation& output_drag_op,
+    std::unique_ptr<ui::LayerTreeOwner> drag_image_layer_owner) {
+  output_drag_op = ui::mojom::DragOperation::kMove;
+  if (target.before == id) {
+    return;
+  }
+  const PrefService& prefs = *prefs_.prefs();
+  std::vector<std::string> group = target.tools
+                                       ? hivey::GetHiveyBarToolsOrder(prefs)
+                                       : hivey::GetHiveyBarOrder(prefs);
+  std::erase(group, id);
+  group.insert(target.before.empty() ? group.end()
+                                     : std::ranges::find(group, target.before),
+               id);
+  // One list for both groups; the other one keeps its order.
+  const std::vector<std::string> other =
+      target.tools ? hivey::GetHiveyBarOrder(prefs)
+                   : hivey::GetHiveyBarToolsOrder(prefs);
+  base::ListValue order;
+  for (const std::string& item : group) {
+    order.Append(item);
+  }
+  for (const std::string& item : other) {
+    order.Append(item);
+  }
+  prefs_.prefs()->SetList(hivey::kHiveyBarOrder, std::move(order));
+}
+
+void HiveyBarView::PaintChildren(const views::PaintInfo& paint_info) {
+  views::View::PaintChildren(paint_info);
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!drop_target_ || !colors) {
+    return;
+  }
+  // Where the dragged button will land.
+  ui::PaintRecorder recorder(paint_info.context(), size());
+  recorder.canvas()->FillRect(
+      gfx::Rect(8, drop_target_->line_y - 1, width() - 16, 2),
+      colors->GetColor(ui::kColorSysPrimary));
+}
