+// Hivey: Hivey Tools (the Hivey AI sidebar) runs embedded while the Hivey bar
+// shows its workspaces; without the bar it is the full extension (its own
+// rail and menus).
+bool HiveyToolsEmbedded(Profile* profile) {
+  return profile->GetPrefs()->GetBoolean(hivey::kHiveyBarVisible);
+}
+
+GURL WithHiveyEmbed(GURL url, bool embedded) {
+  GURL::Replacements replacements;
+  if (embedded && !url.has_query()) {
+    replacements.SetQueryStr("embed=hivey");
+  } else if (!embedded && url.query() == "embed=hivey") {
+    replacements.ClearQuery();
+  }
+  return url.ReplaceComponents(replacements);
+}
