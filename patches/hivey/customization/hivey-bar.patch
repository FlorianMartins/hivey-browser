+// The Hivey bar: a column at the left or right edge of the window (Hivey
+// Studio, or its own right-click menu) with Hivey's tools. On top, the
+// workspaces of Hivey Tools (the Hivey AI sidebar: chat, translation...),
+// which open the side panel on that workspace; then Hivey Cyber and Hivey
+// Shield (their popup), Resources (its dropdown) and Hivey Studio. The
+// workspaces come from the sidebar itself (hivey-bar/tabs.json in its
+// package, written at build time), so new ones show up with its updates.
+class HiveyBarView : public views::View,
+                     public views::ContextMenuController,
+                     public ui::SimpleMenuModel::Delegate,
+                     public extensions::ExtensionRegistryObserver {
+  METADATA_HEADER(HiveyBarView, views::View)
+
+ public:
+  explicit HiveyBarView(BrowserView* browser_view);
+  HiveyBarView(const HiveyBarView&) = delete;
+  HiveyBarView& operator=(const HiveyBarView&) = delete;
+  ~HiveyBarView() override;
+
+  // Read by the browser layout.
+  bool ShouldShow() const;
+  bool IsOnLeft() const;
+  // Vertical tabs at the right edge ("Tabs on the right").
+  bool TabsOnRight() const;
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void OnThemeChanged() override;
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionReady(content::BrowserContext* browser_context,
+                        const extensions::Extension* extension) override;
+  void OnExtensionUnloaded(content::BrowserContext* browser_context,
+                           const extensions::Extension* extension,
+                           extensions::UnloadedExtensionReason reason) override;
+
+ private:
+  struct Workspace {
+    std::string mode;
+    raw_ptr<ToolbarButton> button = nullptr;
+    gfx::ImageSkia icon;  // white: tinted with the theme
+  };
+
+  void OnPrefsChanged();
+  void OnVisibilityChanged();
+  void Rebuild();
+  void OnWorkspacesRead(std::optional<base::ListValue> tabs);
+  void OnWorkspaceIcon(size_t index, const gfx::Image& image);
+  void UpdateColors();
+  void UpdateActive();
+  ToolbarButton* AddButton(std::u16string tooltip,
+                           base::RepeatingClosure callback);
+  views::BubbleBorder::Arrow PopupArrow() const;
+
+  void OnWorkspacePressed(std::string mode);
+  void ShowExtensionPopup(const char* extension_id, views::View* anchor);
+  void OnResourcesPressed();
+  void OnStudioPressed();
+
+  raw_ptr<BrowserView> browser_view_;
+  PrefChangeRegistrar prefs_;
+
+  std::vector<Workspace> workspaces_;
+  // The workspace last opened from the bar, highlighted while Hivey Tools is
+  // showing.
+  std::string active_mode_;
+  raw_ptr<ToolbarButton> cyber_button_ = nullptr;
+  raw_ptr<ToolbarButton> shield_button_ = nullptr;
+  raw_ptr<ToolbarButton> resources_button_ = nullptr;
+  raw_ptr<ToolbarButton> studio_button_ = nullptr;
+  raw_ptr<views::View> separator_ = nullptr;
+
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver>
+      registry_observation_{this};
+  base::CallbackListSubscription side_panel_shown_subscription_;
+  base::WeakPtrFactory<HiveyBarView> weak_factory_{this};
+};
