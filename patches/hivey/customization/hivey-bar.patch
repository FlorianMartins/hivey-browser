+#include "base/task/single_thread_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/win/shortcut.h"
+#include "chrome/browser/hivey/hivey_taskbar_icon.h"
+#include "chrome/common/chrome_paths.h"
+#include "chrome/common/chrome_paths_internal.h"
+#include "chrome/common/chrome_switches.h"
+#include "chrome/installer/util/install_util.h"
+#include "chrome/installer/util/shell_util.h"
+#include "content/public/browser/browser_thread.h"
+#include "ui/gfx/image/image.h"
+#include "ui/gfx/image/image_family.h"
+#include "ui/gfx/win/icon_util.h"
+
+namespace hivey {
+
+namespace {
+
+constexpr wchar_t kIconFilePattern[] = L"Hivey Icon *.ico";
+
+// The UI-thread side: the themed icon written in this session, if any, and
+// the windows waiting for it.
+struct WinIconState {
+  base::FilePath icon_path;
+  base::RepeatingClosureList callbacks;
+};
+
+WinIconState& GetWinState() {
+  static base::NoDestructor<WinIconState> state;
+  return *state;
+}
+
+// Shortcuts are COM objects: one COM STA sequence does all the work, in
+// order, so that two theme changes never race on the same files.
+scoped_refptr<base::SingleThreadTaskRunner> GetIconTaskRunner() {
+  static base::NoDestructor<scoped_refptr<base::SingleThreadTaskRunner>>
+      runner(base::ThreadPool::CreateCOMSTATaskRunner(
+          {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN}));
+  return *runner;
+}
+
+// One file name per accent: Explorer caches icons by path, a new path makes
+// it read the new one.
+std::wstring GetIconFileName(SkColor accent) {
+  return base::StrCat(
+      {L"Hivey Icon ",
+       base::ASCIIToWide(base::StringPrintf("%06X", accent & 0xFFFFFF)),
+       L".ico"});
+}
+
+// The folders that may hold shortcuts launching the browser: Desktop, Start
+// Menu, taskbar pins (as profile_shortcut_manager_win.cc looks for them).
+// System-level folders are left alone: their shortcuts are shared with other
+// users and can't point to this user's data dir.
+std::vector<base::FilePath> GetShortcutDirectories() {
+  std::vector<base::FilePath> dirs;
+  for (ShellUtil::ShortcutLocation location :
+       {ShellUtil::SHORTCUT_LOCATION_DESKTOP,
+        ShellUtil::SHORTCUT_LOCATION_START_MENU_ROOT,
+        ShellUtil::SHORTCUT_LOCATION_TASKBAR_PINS}) {
+    base::FilePath dir;
+    if (ShellUtil::GetShortcutPath(location, ShellUtil::CURRENT_USER, &dir)) {
+      dirs.push_back(dir);
+    }
+  }
+  base::FilePath implicit_app_shortcuts_dir;
+  if (base::PathService::Get(base::DIR_IMPLICIT_APP_SHORTCUTS,
+                             &implicit_app_shortcuts_dir)) {
+    base::FileEnumerator subdirs(implicit_app_shortcuts_dir, false,
+                                 base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath dir = subdirs.Next(); !dir.empty();
+         dir = subdirs.Next()) {
+      dirs.push_back(dir);
+    }
+  }
+  return dirs;
+}
+
+// Whether `shortcut` launches this browser's default profile. Profile and web
+// app shortcuts keep their own icons (badged avatar / app icon), managed by
+// ProfileShortcutManager and the web app code.
+bool IsBrowserShortcut(const base::FilePath& shortcut,
+                       const base::FilePath& exe,
+                       base::win::ShortcutProperties* properties) {
+  if (!base::win::ResolveShortcutProperties(
+          shortcut,
+          base::win::ShortcutProperties::PROPERTIES_TARGET |
+              base::win::ShortcutProperties::PROPERTIES_ARGUMENTS |
+              base::win::ShortcutProperties::PROPERTIES_ICON,
+          properties)) {
+    return false;
+  }
+  // One of the paths may be in short (elided) form.
+  if (!base::FilePath::CompareEqualIgnoreCase(
+          base::MakeLongFilePath(properties->target).value(),
+          base::MakeLongFilePath(exe).value())) {
+    return false;
+  }
+  const base::CommandLine command_line =
+      base::CommandLine::FromString(L"x " + properties->arguments);
+  return !command_line.HasSwitch(switches::kProfileDirectory) &&
+         !command_line.HasSwitch(switches::kAppId);
+}
+
+// Points the browser's shortcuts at `icon_path`. Returns false if one of them
+// could not be updated (it may still use an older themed icon).
+bool UpdateShortcutIcons(const base::FilePath& icon_path) {
+  base::FilePath exe;
+  if (!base::PathService::Get(base::FILE_EXE, &exe)) {
+    return false;
+  }
+  bool all_updated = true;
+  for (const base::FilePath& dir : GetShortcutDirectories()) {
+    base::FileEnumerator shortcuts(dir, false, base::FileEnumerator::FILES,
+                                   L"*.lnk");
+    for (base::FilePath shortcut = shortcuts.Next(); !shortcut.empty();
+         shortcut = shortcuts.Next()) {
+      base::win::ShortcutProperties current;
+      if (!IsBrowserShortcut(shortcut, exe, &current)) {
+        continue;
+      }
+      if (current.icon_index == 0 &&
+          base::FilePath::CompareEqualIgnoreCase(current.icon.value(),
+                                                 icon_path.value())) {
+        continue;
+      }
+      base::win::ShortcutProperties update;
+      update.set_icon(icon_path, 0);
+      if (!base::win::CreateOrUpdateShortcutLink(
+              shortcut, update,
+              base::win::ShortcutOperation::kUpdateExisting)) {
+        all_updated = false;
+        continue;
+      }
+      // Win 11 does not refresh taskbar pins on SHCNE_ASSOCCHANGED alone.
+      SHChangeNotify(SHCNE_UPDATEITEM, SHCNF_PATH, shortcut.value().c_str(),
+                     nullptr);
+    }
+  }
+  return all_updated;
+}
+
+void DeleteOtherIcons(const base::FilePath& dir,
+                      const base::FilePath& icon_path) {
+  base::FileEnumerator icons(dir, false, base::FileEnumerator::FILES,
+                             kIconFilePattern);
+  for (base::FilePath icon = icons.Next(); !icon.empty(); icon = icons.Next()) {
+    if (!base::FilePath::CompareEqualIgnoreCase(icon.value(),
+                                                icon_path.value())) {
+      base::DeleteFile(icon);
+    }
+  }
+}
+
+// Runs on the COM STA sequence. Returns the themed .ico, or an empty path on
+// failure.
+base::FilePath WriteIconAndUpdateShortcuts(SkColor accent,
+                                           std::vector<SkBitmap> bitmaps) {
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+  base::FilePath user_data_dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir)) {
+    return base::FilePath();
+  }
+  const base::FilePath icon_path =
+      user_data_dir.Append(GetIconFileName(accent));
+  if (!base::PathExists(icon_path)) {
+    gfx::ImageFamily family;
+    for (const SkBitmap& bitmap : bitmaps) {
+      family.Add(gfx::Image::CreateFrom1xBitmap(bitmap));
+    }
+    // Written to a temporary file, then moved in place (ATOMIC_WRITE).
+    if (!IconUtil::CreateIconFileFromImageFamily(family, icon_path,
+                                                 IconUtil::ATOMIC_WRITE)) {
+      return base::FilePath();
+    }
+    SHChangeNotify(SHCNE_CREATE, SHCNF_PATH, icon_path.value().c_str(),
+                   nullptr);
+  }
+
+  // Shortcuts launch the default user data dir: a browser started with
+  // another one (--user-data-dir) must not point them at its own icon.
+  base::FilePath default_dir;
+  const bool default_profile_dir =
+      chrome::GetDefaultUserDataDirectory(&default_dir) &&
+      base::FilePath::CompareEqualIgnoreCase(
+          base::MakeLongFilePath(default_dir).value(),
+          base::MakeLongFilePath(user_data_dir).value());
+  if (default_profile_dir && UpdateShortcutIcons(icon_path)) {
+    // Nothing points to the older icons anymore (open windows switch to the
+    // new one when the reply runs).
+    DeleteOtherIcons(user_data_dir, icon_path);
+  }
+  // Invalidates the shell's icon cache (taskbar, Start Menu, Desktop).
+  SHChangeNotify(SHCNE_ASSOCCHANGED, SHCNF_IDLIST, nullptr, nullptr);
+  return icon_path;
+}
+
+void OnIconWritten(const base::FilePath& icon_path) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (icon_path.empty()) {
+    return;
+  }
+  WinIconState& state = GetWinState();
+  state.icon_path = icon_path;
+  state.callbacks.Notify();
+}
+
+}  // namespace
+
+base::CallbackListSubscription RegisterTaskbarIconChangedCallback(
+    base::RepeatingClosure callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  return GetWinState().callbacks.Add(std::move(callback));
+}
+
+bool GetThemedRelaunchDetails(base::FilePath* icon_path,
+                              std::wstring* command_line,
+                              std::wstring* display_name) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  const base::FilePath& themed_icon = GetWinState().icon_path;
+  if (themed_icon.empty()) {
+    return false;
+  }
+  *icon_path = themed_icon;
+  if (command_line->empty()) {
+    base::FilePath exe;
+    if (base::PathService::Get(base::FILE_EXE, &exe)) {
+      *command_line = base::CommandLine(exe).GetCommandLineString();
+    }
+  }
+  if (display_name->empty()) {
+    *display_name = InstallUtil::GetShortcutName();
+  }
+  return true;
+}
