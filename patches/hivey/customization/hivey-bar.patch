+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#ifndef CHROME_BROWSER_HIVEY_HIVEY_TASKBAR_ICON_H_
+#define CHROME_BROWSER_HIVEY_HIVEY_TASKBAR_ICON_H_
+
+#include <string>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/functional/callback_forward.h"
+#include "build/build_config.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+namespace hivey {
+
+// Makes the app icon the OS shows outside of the browser windows (Windows
+// taskbar and shortcuts, Linux dock and application menu) follow `accent`,
+// the theme's accent color, like the window icon does.
+//
+// Cheap to call often (e.g. from BrowserView::OnThemeChanged): calls are
+// debounced, ignored while the accent does not change, and all file I/O runs
+// on a background sequence. Must be called on the UI thread. No-op on other
+// platforms than Windows and Linux.
+void UpdateTaskbarIcon(SkColor accent);
+
+#if BUILDFLAG(IS_WIN)
+// Runs `callback` on the UI thread each time a new themed icon file has been
+// written, so that windows can refresh their relaunch details.
+[[nodiscard]] base::CallbackListSubscription
+RegisterTaskbarIconChangedCallback(base::RepeatingClosure callback);
+
+// For a normal browser window: sets `icon_path` to the themed .ico and, when
+// they are empty, `command_line` and `display_name` to launch the browser
+// (Windows only honors a relaunch icon along with a relaunch command and
+// name). Returns false, leaving the arguments untouched, while no themed icon
+// has been written in this session. UI thread only, no file I/O.
+bool GetThemedRelaunchDetails(base::FilePath* icon_path,
+                              std::wstring* command_line,
+                              std::wstring* display_name);
+#endif
+
+namespace internal {
+
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+// Implemented per platform (hivey_taskbar_icon_{win,linux}.cc).
+
+// The icon sizes, in pixels, the platform wants.
+std::vector<int> GetTaskbarIconSizes();
+
+// Writes the icon (one bitmap per size of GetTaskbarIconSizes(), drawn in
+// `accent`) where the OS looks for it, on a background sequence.
+void WriteTaskbarIcon(SkColor accent, std::vector<SkBitmap> bitmaps);
+#endif
+
+}  // namespace internal
+
+}  // namespace hivey
+
+#endif  // CHROME_BROWSER_HIVEY_HIVEY_TASKBAR_ICON_H_
