+namespace internal {
+
+std::vector<int> GetTaskbarIconSizes() {
+  return {16, 24, 32, 48, 64, 256};
+}
+
+void WriteTaskbarIcon(SkColor accent, std::vector<SkBitmap> bitmaps) {
+  GetIconTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&WriteIconAndUpdateShortcuts, accent, std::move(bitmaps)),
+      base::BindOnce(&OnIconWritten));
+}
