@@ -0,0 +1,79 @@
+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#include "chrome/browser/hivey/hivey_taskbar_icon.h"
+
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "build/build_config.h"
+#include "chrome/browser/hivey/hivey_app_icon.h"
+#include "content/public/browser/browser_thread.h"
+#include "ui/gfx/image/image_skia.h"
+
+namespace hivey {
+
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+namespace {
+
+// Live theme edits (e.g. dragging a color picker) fire many theme changes:
+// only the color the user settles on gets written to disk.
+constexpr base::TimeDelta kDebounceDelay = base::Seconds(1);
+
+struct TaskbarIconState {
+  // The accent of the last icon handed to the platform, if any.
+  std::optional<SkColor> applied_accent;
+  // The accent of the last UpdateTaskbarIcon() call, if any.
+  std::optional<SkColor> requested_accent;
+  base::OneShotTimer debounce_timer;
+};
+
+TaskbarIconState& GetState() {
+  static base::NoDestructor<TaskbarIconState> state;
+  return *state;
+}
+
+void ApplyRequestedAccent() {
+  TaskbarIconState& state = GetState();
+  const SkColor accent = *state.requested_accent;
+  if (state.applied_accent == accent) {
+    return;
+  }
+
+  // Rendering stays on the UI thread; only the bitmaps (whose pixels are
+  // thread-safe ref-counted) go to the background sequence.
+  std::vector<SkBitmap> bitmaps;
+  for (int size : internal::GetTaskbarIconSizes()) {
+    const SkBitmap bitmap = *HiveyThemedAppIcon(accent, size).bitmap();
+    if (bitmap.isNull() || bitmap.width() != size) {
+      return;
+    }
+    bitmaps.push_back(bitmap);
+  }
+  state.applied_accent = accent;
+  internal::WriteTaskbarIcon(accent, std::move(bitmaps));
+}
+
+}  // namespace
+#endif  // BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+
+void UpdateTaskbarIcon(SkColor accent) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+  TaskbarIconState& state = GetState();
+  if (state.requested_accent == accent) {
+    return;
+  }
+  state.requested_accent = accent;
+  state.debounce_timer.Start(FROM_HERE, kDebounceDelay,
+                             base::BindOnce(&ApplyRequestedAccent));
+#endif
+}
+
+}  // namespace hivey
