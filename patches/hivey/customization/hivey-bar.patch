+
+HiveyBarView::HiveyBarView(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(8, 0), 4));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  set_context_menu_controller(this);
+  SetBackground(views::CreateSolidBackground(kColorToolbar));
+
+  Profile* profile = browser_view_->GetProfile();
+  prefs_.Init(profile->GetPrefs());
+  const auto changed = base::BindRepeating(&HiveyBarView::OnPrefsChanged,
+                                           base::Unretained(this));
+  prefs_.Add(hivey::kHiveyBarVisible,
+             base::BindRepeating(&HiveyBarView::OnVisibilityChanged,
+                                 base::Unretained(this)));
+  prefs_.Add(hivey::kHiveyBarSide, changed);
+  prefs_.Add(prefs::kVerticalTabsEnabled, changed);
+  prefs_.Add(hivey::kHiveyVerticalTabsRight, changed);
+  registry_observation_.Observe(extensions::ExtensionRegistry::Get(profile));
+  Rebuild();
+}
+
+HiveyBarView::~HiveyBarView() = default;
+
+bool HiveyBarView::ShouldShow() const {
+  return prefs_.prefs()->GetBoolean(hivey::kHiveyBarVisible);
+}
+
+bool HiveyBarView::IsOnLeft() const {
+  return hivey::IsHiveyBarOnLeft(*prefs_.prefs());
+}
+
+bool HiveyBarView::TabsOnRight() const {
+  return prefs_.prefs()->GetBoolean(hivey::kHiveyVerticalTabsRight);
+}
+
+gfx::Size HiveyBarView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(kBarWidth,
+                   views::View::CalculatePreferredSize(available_size).height());
+}
+
+void HiveyBarView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  UpdateColors();
+}
+
+void HiveyBarView::OnVisibilityChanged() {
+  // Without the bar, Hivey Tools and Hivey Cyber go back to the toolbar with
+  // the other extensions; with it, they live in the bar.
+  if (ToolbarActionsModel* model =
+          ToolbarActionsModel::Get(browser_view_->GetProfile())) {
+    for (const char* id : {HIVEY_BUNDLED_AI_ID, HIVEY_BUNDLED_CYBER_ID}) {
+      if (model->IsActionPinned(id) == ShouldShow()) {
+        model->SetActionVisibility(id, !ShouldShow());
+      }
+    }
+  }
+  OnPrefsChanged();
+}
+
+void HiveyBarView::OnPrefsChanged() {
+  // The layout reads ShouldShow() and IsOnLeft().
+  browser_view_->InvalidateLayout();
+  UpdateActive();
+}
+
+void HiveyBarView::OnExtensionReady(content::BrowserContext* browser_context,
+                                    const extensions::Extension* extension) {
+  if (extension->id() == HIVEY_BUNDLED_AI_ID ||
+      extension->id() == HIVEY_BUNDLED_CYBER_ID ||
+      extension->id() == HIVEY_BUNDLED_SHIELD_ID) {
+    Rebuild();
+  }
+}
+
+void HiveyBarView::OnExtensionUnloaded(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension,
+    extensions::UnloadedExtensionReason reason) {
+  OnExtensionReady(browser_context, extension);
+}
+
+void HiveyBarView::Rebuild() {
+  weak_factory_.InvalidateWeakPtrs();
+  RemoveAllChildViews();
+  workspaces_.clear();
+  cyber_button_ = shield_button_ = resources_button_ = studio_button_ = nullptr;
+
+  Profile* profile = browser_view_->GetProfile();
+  const extensions::ExtensionSet& enabled =
+      extensions::ExtensionRegistry::Get(profile)->enabled_extensions();
+
+  // Hivey Tools' workspaces, read from its package.
+  if (const extensions::Extension* tools =
+          enabled.GetByID(HIVEY_BUNDLED_AI_ID)) {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&ReadWorkspaces,
+                       tools->path().AppendASCII("hivey-bar/tabs.json")),
+        base::BindOnce(&HiveyBarView::OnWorkspacesRead,
+                       weak_factory_.GetWeakPtr()));
+  }
+  separator_ = AddChildView(std::make_unique<views::Separator>());
+  separator_->SetPreferredSize(gfx::Size(24, views::Separator::kThickness));
+  separator_->SetVisible(false);  // shown with the workspaces
+
+  if (enabled.Contains(HIVEY_BUNDLED_CYBER_ID)) {
+    cyber_button_ = AddButton(
+        u"Hivey Cyber",
+        base::BindRepeating(
+            [](HiveyBarView* bar) {
+              bar->ShowExtensionPopup(HIVEY_BUNDLED_CYBER_ID,
+                                      bar->cyber_button_);
+            },
+            base::Unretained(this)));
+  }
+  if (enabled.Contains(HIVEY_BUNDLED_SHIELD_ID)) {
+    shield_button_ = AddButton(
+        u"Hivey Shield",
+        base::BindRepeating(
+            [](HiveyBarView* bar) {
+              bar->ShowExtensionPopup(HIVEY_BUNDLED_SHIELD_ID,
+                                      bar->shield_button_);
+            },
+            base::Unretained(this)));
+  }
+  resources_button_ = AddButton(
+      l10n_util::GetStringUTF16(IDS_HIVEY_RESOURCES),
+      base::BindRepeating(&HiveyBarView::OnResourcesPressed,
+                          base::Unretained(this)));
+  resources_button_->SetVectorIcon(kSpeedIcon);
+  std::u16string studio = l10n_util::GetStringUTF16(IDS_HIVEY_STUDIO);
+  base::RemoveChars(studio, u"&", &studio);
+  studio_button_ = AddButton(std::move(studio),
+                             base::BindRepeating(&HiveyBarView::OnStudioPressed,
+                                                 base::Unretained(this)));
+  studio_button_->SetVectorIcon(kBrushFilledIcon);
+  UpdateColors();
+}
+
+ToolbarButton* HiveyBarView::AddButton(std::u16string tooltip,
+                                       base::RepeatingClosure callback) {
+  auto button = std::make_unique<ToolbarButton>(base::BindRepeating(
+      [](base::RepeatingClosure callback, const ui::Event&) { callback.Run(); },
+      std::move(callback)));
+  button->SetTooltipText(tooltip);
+  button->GetViewAccessibility().SetName(tooltip);
+  button->set_context_menu_controller(this);
+  return AddChildView(std::move(button));
+}
+
+void HiveyBarView::OnWorkspacesRead(std::optional<base::ListValue> tabs) {
+  if (!tabs) {
+    return;
+  }
+  Profile* profile = browser_view_->GetProfile();
+  const extensions::Extension* tools =
+      extensions::ExtensionRegistry::Get(profile)->enabled_extensions().GetByID(
+          HIVEY_BUNDLED_AI_ID);
+  if (!tools) {
+    return;
+  }
+  const bool french =
+      base::StartsWith(g_browser_process->GetApplicationLocale(), "fr");
+  for (const base::Value& tab : *tabs) {
+    const base::DictValue* dict = tab.GetIfDict();
+    const std::string* mode = dict ? dict->FindString("mode") : nullptr;
+    const std::string* icon = dict ? dict->FindString("icon") : nullptr;
+    if (!mode || !icon) {
+      continue;
+    }
+    const base::DictValue* titles = dict->FindDict("title");
+    const std::string* title =
+        titles ? titles->FindString(french ? "fr" : "en") : nullptr;
+    const size_t index = workspaces_.size();
+    ToolbarButton* button =
+        AddButton(base::UTF8ToUTF16(title ? *title : *mode),
+                  base::BindRepeating(&HiveyBarView::OnWorkspacePressed,
+                                      base::Unretained(this), *mode));
+    // Workspaces come first, before the separator and the tools.
+    ReorderChildView(button, index);
+    workspaces_.push_back({*mode, button, gfx::ImageSkia()});
+    extensions::ImageLoader::Get(profile)->LoadImageAsync(
+        tools, tools->GetResource(*icon), gfx::Size(40, 40),
+        base::BindOnce(&HiveyBarView::OnWorkspaceIcon,
+                       weak_factory_.GetWeakPtr(), index));
+  }
+  separator_->SetVisible(!workspaces_.empty());
+  UpdateActive();
+}
+
+void HiveyBarView::OnWorkspaceIcon(size_t index, const gfx::Image& image) {
+  if (index >= workspaces_.size() || image.IsEmpty()) {
+    return;
+  }
+  // 40 px drawn for 20 DIP: crisp at 2x, scaled down at 1x.
+  workspaces_[index].icon =
+      gfx::ImageSkia::CreateFromBitmap(image.AsBitmap(), 2.0f);
+  UpdateColors();
+}
+
+void HiveyBarView::UpdateColors() {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  const SkColor icon_color = colors->GetColor(kColorToolbarButtonIcon);
+  for (const Workspace& workspace : workspaces_) {
+    if (!workspace.icon.isNull()) {
+      workspace.button->SetImageModel(
+          views::Button::STATE_NORMAL,
+          ui::ImageModel::FromImageSkia(
+              gfx::ImageSkiaOperations::CreateColorMask(workspace.icon,
+                                                        icon_color)));
+    }
+  }
+  // The extensions' own icons.
+  ExtensionsContainer* container =
+      ExtensionsContainer::From(*browser_view_->browser());
+  content::WebContents* contents = browser_view_->GetActiveWebContents();
+  for (auto [button, id] :
+       {std::pair(cyber_button_.get(), HIVEY_BUNDLED_CYBER_ID),
+        std::pair(shield_button_.get(), HIVEY_BUNDLED_SHIELD_ID)}) {
+    ToolbarActionViewModel* action =
+        container && button ? container->GetActionForId(id) : nullptr;
+    if (action && contents) {
+      button->SetImageModel(
+          views::Button::STATE_NORMAL,
+          action->GetIcon(contents, gfx::Size(kIconSize, kIconSize)));
+      button->SetTooltipText(action->GetActionName());
+    }
+  }
+  UpdateActive();
+}
+
+void HiveyBarView::UpdateActive() {
+  const ui::ColorProvider* colors = GetColorProvider();
+  SidePanelUI* side_panel = SidePanelUI::From(browser_view_->browser());
+  const bool tools_showing =
+      side_panel && side_panel->IsSidePanelEntryShowing(HiveyToolsKey());
+  if (side_panel && !side_panel_shown_subscription_) {
+    side_panel_shown_subscription_ =
+        side_panel->RegisterSidePanelShown(base::BindRepeating(
+            &HiveyBarView::UpdateActive, base::Unretained(this)));
+  }
+  for (const Workspace& workspace : workspaces_) {
+    const bool active = tools_showing && workspace.mode == active_mode_;
+    workspace.button->SetBackground(
+        active && colors
+            ? views::CreateRoundedRectBackground(
+                  color_utils::AlphaBlend(colors->GetColor(ui::kColorSysPrimary),
+                                          colors->GetColor(kColorToolbar),
+                                          0.24f),
+                  8)
+            : nullptr);
+  }
+}
+
+views::BubbleBorder::Arrow HiveyBarView::PopupArrow() const {
+  return IsOnLeft() ? views::BubbleBorder::LEFT_TOP
+                    : views::BubbleBorder::RIGHT_TOP;
+}
+
+void HiveyBarView::OnWorkspacePressed(std::string mode) {
+  BrowserWindowInterface* browser = browser_view_->browser();
+  SidePanelUI* side_panel = SidePanelUI::From(browser);
+  extensions::ExtensionSidePanelManager* manager =
+      extensions::ExtensionSidePanelManager::From(browser);
+  extensions::ExtensionSidePanelCoordinator* coordinator =
+      manager ? manager->GetCoordinator(HIVEY_BUNDLED_AI_ID) : nullptr;
+  if (!side_panel || !coordinator) {
+    return;
+  }
+  if (side_panel->IsSidePanelEntryShowing(HiveyToolsKey()) &&
+      mode == active_mode_) {
+    // A second click on the open workspace closes the panel.
+    side_panel->Close();
+    active_mode_.clear();
+  } else {
+    coordinator->ShowHiveyMode(mode);
+    side_panel->Show(HiveyToolsKey(), SidePanelOpenTrigger::kExtension);
+    active_mode_ = std::move(mode);
+  }
+  UpdateActive();
+}
+
+void HiveyBarView::ShowExtensionPopup(const char* extension_id,
+                                      views::View* anchor) {
+  BrowserWindowInterface* browser = browser_view_->browser();
+  Profile* profile = browser_view_->GetProfile();
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)->enabled_extensions().GetByID(
+          extension_id);
+  content::WebContents* contents = browser_view_->GetActiveWebContents();
+  if (!extension || !contents || !anchor) {
+    return;
+  }
+  extensions::ExtensionAction* action =
+      extensions::ExtensionActionManager::Get(profile)->GetExtensionAction(
+          *extension);
+  const int tab_id = extensions::ExtensionTabUtil::GetTabId(contents);
+  if (!action || !action->HasPopup(tab_id)) {
+    return;
+  }
+  // Like a click on its toolbar icon: the extension may read this tab.
+  if (auto* granter =
+          extensions::ActiveTabPermissionGranter::FromWebContents(contents)) {
+    granter->GrantIfRequested(extension);
+  }
+  ExtensionPopup::ShowPopup(
+      browser,
+      extensions::ExtensionViewHostFactory::CreatePopupHost(
+          *extension, action->GetPopupUrl(tab_id), browser),
+      views::BubbleAnchor(anchor), PopupArrow(), PopupShowAction::kShow,
+      base::DoNothing());
+}
+
+void HiveyBarView::OnResourcesPressed() {
+  if (auto* coordinator =
+          HiveyResourcesCoordinator::From(browser_view_->browser())) {
+    coordinator->ShowAnchoredTo(resources_button_, PopupArrow());
+  }
+}
+
+void HiveyBarView::OnStudioPressed() {
+  chrome::ExecuteCommand(browser_view_->browser(), IDC_HIVEY_STUDIO);
+}
+
+void HiveyBarView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddRadioItemWithStringId(kCommandLeft, IDS_HIVEY_BAR_LEFT, 0);
+  menu_model_->AddRadioItemWithStringId(kCommandRight, IDS_HIVEY_BAR_RIGHT, 0);
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItemWithStringId(kCommandHide, IDS_HIVEY_BAR_HIDE);
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+bool HiveyBarView::IsCommandIdChecked(int command_id) const {
+  return command_id == kCommandLeft    ? IsOnLeft()
+         : command_id == kCommandRight ? !IsOnLeft()
+                                       : false;
+}
+
+void HiveyBarView::ExecuteCommand(int command_id, int event_flags) {
+  PrefService* prefs = browser_view_->GetProfile()->GetPrefs();
+  switch (command_id) {
+    case kCommandLeft:
+    case kCommandRight: {
+      const bool left = command_id == kCommandLeft;
+      prefs->SetInteger(hivey::kHiveyBarSide,
+                        static_cast<int>(left ? hivey::HiveyBarSide::kLeft
+                                              : hivey::HiveyBarSide::kRight));
+      // The side panel opens next to the bar.
+      prefs->SetBoolean(prefs::kSidePanelHorizontalAlignment, !left);
+      break;
+    }
+    case kCommandHide:
+      prefs->SetBoolean(hivey::kHiveyBarVisible, false);
+      break;
+  }
+}
