+void ExtensionSidePanelCoordinator::ShowHiveyMode(std::string_view mode) {
+  if (side_panel_url_.is_empty()) {
+    return;
+  }
+  // Only the fragment changes: a same-document navigation, the sidebar keeps
+  // its state and switches workspace on "hashchange". The counter makes the
+  // fragment new each time, also when the user moved to another workspace
+  // inside the sidebar since.
+  static int count = 0;
+  const std::string ref =
+      base::StrCat({"mode=", mode, "&n=", base::NumberToString(++count)});
+  GURL::Replacements fragment;
+  fragment.SetRefStr(ref);
+  side_panel_url_ = side_panel_url_.ReplaceComponents(fragment);
+  if (host_) {
+    NavigateIfNecessary();
+  }
+}
