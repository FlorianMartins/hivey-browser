@@ -0,0 +1,112 @@
+// Copyright 2026 The Hivey Browser contributors
+// Use of this source code is governed by the MIT license that can be found in
+// the LICENSE file of the Hivey Browser repository.
+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/environment.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/nix/xdg_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_view_util.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/time/time.h"
+#include "chrome/browser/hivey/hivey_taskbar_icon.h"
+#include "ui/gfx/codec/png_codec.h"
+
+namespace hivey {
+
+namespace {
+
+// The desktop entry and icon names the Linux package installs (Icon= and the
+// .desktop file name, see LINUX_DESKTOP_ENTRY in scripts/hb.py).
+constexpr char kDesktopFileName[] = "hivey-browser.desktop";
+constexpr char kIconFileName[] = "hivey-browser.png";
+
+scoped_refptr<base::SequencedTaskRunner> GetIconTaskRunner() {
+  static base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>> runner(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN}));
+  return *runner;
+}
+
+// Whether the desktop entry is installed, for the user or system-wide: the
+// dock and application menu only show the themed icon through it.
+bool IsDesktopEntryInstalled(base::Environment* env) {
+  for (const base::FilePath& dir : base::nix::GetXDGDataSearchLocations(env)) {
+    if (base::PathExists(dir.Append("applications").Append(kDesktopFileName))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Runs on the background sequence. Writes
+// $XDG_DATA_HOME/icons/hicolor/<s>x<s>/apps/hivey-browser.png, which the icon
+// theme lookup finds before the system-wide icons.
+void WriteIcons(std::vector<SkBitmap> bitmaps) {
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  if (!IsDesktopEntryInstalled(env.get())) {
+    return;
+  }
+  const base::FilePath hicolor_dir =
+      base::nix::GetXDGDataWriteLocation(env.get()).Append("icons/hicolor");
+  bool wrote_any = false;
+  for (const SkBitmap& bitmap : bitmaps) {
+    const std::string size = base::NumberToString(bitmap.width());
+    const base::FilePath apps_dir =
+        hicolor_dir.Append(size + "x" + size).Append("apps");
+    if (!base::CreateDirectory(apps_dir)) {
+      continue;
+    }
+    std::optional<std::vector<uint8_t>> png =
+        gfx::PNGCodec::EncodeBGRASkBitmap(bitmap,
+                                          /*discard_transparency=*/false);
+    if (!png) {
+      continue;
+    }
+    // Written to a temporary file in `apps_dir`, then renamed over the icon.
+    if (base::ImportantFileWriter::WriteFileAtomically(
+            apps_dir.Append(kIconFileName), base::as_string_view(*png))) {
+      wrote_any = true;
+    }
+  }
+  if (wrote_any) {
+    // GTK (and so GNOME Shell) rescans an icon theme when the mtime of its
+    // base directory changes.
+    const base::Time now = base::Time::Now();
+    base::TouchFile(hicolor_dir, now, now);
+  }
+}
+
+}  // namespace
+
+namespace internal {
+
+std::vector<int> GetTaskbarIconSizes() {
+  return {16, 22, 24, 32, 48, 64, 128, 256};
+}
+
+void WriteTaskbarIcon(SkColor accent, std::vector<SkBitmap> bitmaps) {
+  GetIconTaskRunner()->PostTask(
+      FROM_HERE, base::BindOnce(&WriteIcons, std::move(bitmaps)));
+}
+
+}  // namespace internal
+
+}  // namespace hivey
