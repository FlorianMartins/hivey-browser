+void HiveyStudioHandler::HandleGetAiModels(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], hivey::HiveyAiEngine::Get().Describe());
+}
+
+void HiveyStudioHandler::HandleAiModelAction(const base::ListValue& args) {
+  if (args.size() != 2 || !args[0].is_string() || !args[1].is_string()) {
+    return;
+  }
+  const std::string& action = args[0].GetString();
+  const std::string& model = args[1].GetString();
+  hivey::HiveyAiEngine& engine = hivey::HiveyAiEngine::Get();
+  if (action == "download") {
+    engine.SelectModel(model, /*download=*/true);
+  } else if (action == "select") {
+    engine.SelectModel(model, /*download=*/false);
+  } else if (action == "remove") {
+    engine.RemoveModel(model);
+  }
+}
