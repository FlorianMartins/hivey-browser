+// The local AI: Auto, or the models the user chose. Several can be on the disk.
+function buildAi() {
+  const list = el('div', {});
+  const act = (action, model) => {
+    chrome.send('aiModelAction', [action, model]);
+    setTimeout(refresh, 300);
+  };
+  const row = (label, hint, on, buttons) => el('div', {class: 'row'},
+      el('span', {class: 'row-label', text: `${on ? '\u25cf ' : ''}${label}`}),
+      el('span', {class: 'row-hint', text: hint}),
+      el('span', {class: 'task-actions'}, ...buttons));
+  const button = (text, onclick) => el('button', {class: 'button ghost', text, onclick});
+  const render = ai => {
+    const models = ai.models || [];
+    const busy = ai.state === 'downloading';
+    const auto = models.find(m => m.auto);
+    const rows = [row(t('aiAuto'), auto ? auto.name : '', ai.choice === 'auto',
+        ai.choice === 'auto' || busy ? [] : [button(t('aiUse'), () => act(auto && auto.installed ? 'select' : 'download', 'auto'))])];
+    for (const m of models) {
+      const current = ai.choice === m.name;
+      const buttons = [];
+      if (!current && !busy) {
+        buttons.push(button(m.installed ? t('aiUse') : t('aiDownload'), () => act(m.installed ? 'select' : 'download', m.name)));
+      }
+      if (m.installed && !busy) {
+        buttons.push(button(t('aiRemove'), () => act('remove', m.name)));
+      }
+      rows.push(row(m.name, `${m.gb} GB${m.slow ? ` \u00b7 ${t('aiSlow')}` : ''}`, current, buttons));
+    }
+    if (busy) {
+      rows.push(el('div', {class: 'row'}, el('span', {class: 'row-hint',
+          text: `${t('aiDownloading')} ${ai.modelName} : ${Math.round((ai.progress || 0) * 100)} %`})));
+    }
+    list.replaceChildren(...rows);
+  };
+  const refresh = () => sendWithPromise('getAiModels').then(render);
+  refresh();
+  const timer = setInterval(() => {
+    if (!list.isConnected) {
+      clearInterval(timer);
+    } else {
+      refresh();
+    }
+  }, 1500);
+  return el('div', {}, sectionHeader('aiTitle', 'aiText'), card(null, list));
+}
