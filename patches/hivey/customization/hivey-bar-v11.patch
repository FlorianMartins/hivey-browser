+#ifndef CHROME_BROWSER_UI_HIVEY_HIVEY_TOR_H_
+#define CHROME_BROWSER_UI_HIVEY_HIVEY_TOR_H_
+
+class GURL;
+class Profile;
+
+namespace hivey {
+
+// Private windows with Tor, like Brave's: the tor program that ships with
+// Hivey (next to the browser, in "tor") is started on demand, and a hidden
+// profile ("Hivey Tor") sends everything through it (SOCKS5, the names are
+// resolved by Tor too). Its windows are that profile's off-the-record ones:
+// nothing they see is kept. tor stops with the last of them, or with the
+// browser.
+//
+// Opens such a window on `url` (empty: check.torproject.org), once Tor is
+// connected; meanwhile the window says it is connecting.
+void OpenTorWindow(const GURL& url);
+
+// Whether `profile` is Hivey's Tor profile (or its off-the-record profile).
+bool IsTorProfile(const Profile* profile);
+
+}  // namespace hivey
+
+#endif  // CHROME_BROWSER_UI_HIVEY_HIVEY_TOR_H_
