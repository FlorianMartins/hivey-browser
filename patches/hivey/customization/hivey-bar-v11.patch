+// The hidden profile Tor windows belong to, in the user data directory.
+constexpr char kTorProfileDir[] = "Hivey Tor";
+constexpr char kCheckUrl[] = "https://check.torproject.org/";
+// tor connects within seconds; past this, the window says it could not.
+constexpr base::TimeDelta kBootstrapTimeout = base::Seconds(90);
+
+#if BUILDFLAG(IS_WIN)
+constexpr char kTorDir[] = "Tor";
+constexpr char kTorExe[] = "tor.exe";
+#else
+constexpr char kTorDir[] = "tor";
+constexpr char kTorExe[] = "tor";
+#endif
+
+// A page of the browser's own, as a data: URL (the window before and when
+// Tor connects).
+GURL StatusPage(int message_id) {
+  const std::string text = base::EscapeForHTML(
+      base::UTF16ToUTF8(l10n_util::GetStringUTF16(message_id)));
+  const std::string html = base::StringPrintf(
+      "<!doctype html><meta charset=utf-8><title>Tor</title>"
+      "<body style=\"margin:0;height:100vh;display:grid;place-items:center;"
+      "background:#13141f;color:#e6e7ff;font:20px system-ui,sans-serif\">"
+      "<div style=\"text-align:center\"><div style=\"font-size:56px\">"
+      "&#129477;</div><p>%s</p></div>",
+      text.c_str());
+  return GURL("data:text/html;base64," + base::Base64Encode(html));
+}
+
+// Runs on a blocking thread: waits for tor's log to say it is connected
+// ("Bootstrapped 100%"), or that it failed. True when connected.
+bool WaitForBootstrap(base::FilePath log) {
+  const base::TimeTicks deadline = base::TimeTicks::Now() + kBootstrapTimeout;
+  while (base::TimeTicks::Now() < deadline) {
+    std::string contents;
+    if (base::ReadFileToString(log, &contents)) {
+      if (contents.find("Bootstrapped 100%") != std::string::npos) {
+        return true;
+      }
+      if (contents.find("[err]") != std::string::npos) {
+        return false;
+      }
+    }
+    base::PlatformThread::Sleep(base::Milliseconds(300));
+  }
+  return false;
+}
+
+class TorController : public BrowserCollectionObserver {
+ public:
+  static TorController& Get() {
+    static base::NoDestructor<TorController> instance;
+    return *instance;
+  }
+
+  void Open(const GURL& url) {
+    ProfileManager* profile_manager = g_browser_process->profile_manager();
+    if (!profile_manager) {
+      return;
+    }
+    profile_manager->CreateProfileAsync(
+        profile_manager->user_data_dir().AppendASCII(kTorProfileDir),
+        base::BindOnce(&TorController::OnProfileReady,
+                       weak_factory_.GetWeakPtr(), url));
+  }
+
+  // BrowserCollectionObserver:
+  void OnBrowserClosed(BrowserWindowInterface* browser) override {
+    if (!IsTorProfile(browser->GetProfile())) {
+      return;
+    }
+    bool others = false;
+    GlobalBrowserCollection::GetInstance()->ForEach(
+        [&](BrowserWindowInterface* other) {
+          others |= other != browser && IsTorProfile(other->GetProfile());
+          return !others;
+        });
+    if (!others) {
+      Stop();
+    }
+  }
+
+ private:
+  friend class base::NoDestructor<TorController>;
+
+  enum class State { kStopped, kStarting, kReady };
+
+  TorController() {
+    observation_.Observe(GlobalBrowserCollection::GetInstance());
+  }
+
+  void OnProfileReady(GURL url, Profile* profile) {
+    if (!profile) {
+      return;
+    }
+    if (ProfileAttributesEntry* entry =
+            g_browser_process->profile_manager()
+                ->GetProfileAttributesStorage()
+                .GetProfileAttributesWithPath(profile->GetPath())) {
+      // Not a profile of its own for the user: no picker, no menu entry.
+      entry->SetIsOmitted(true);
+    }
+    PrefService* pref_service = profile->GetPrefs();
+    // Everything through Tor (SOCKS5: names are resolved by Tor as well),
+    // WebRTC included; no DNS prefetching, no suggestions while typing.
+    pref_service->SetDict(proxy_config::prefs::kProxy,
+                   ProxyConfigDictionary::CreateFixedServers(
+                       base::StringPrintf("socks5://127.0.0.1:%d", Port()),
+                       std::string()));
+    pref_service->SetString(prefs::kWebRTCIPHandlingPolicy,
+                            "disable_non_proxied_udp");
+    pref_service->SetInteger(
+        prefs::kNetworkPredictionOptions,
+        static_cast<int>(prefetch::NetworkPredictionOptions::kDisabled));
+    pref_service->SetBoolean(prefs::kSearchSuggestEnabled, false);
+
+    BrowserWindowInterface* window = chrome::OpenEmptyWindow(
+        profile->GetPrimaryOTRProfile(/*create_if_needed=*/true),
+        /*should_trigger_session_restore=*/false);
+    if (!window) {
+      return;
+    }
+    const GURL target = url.is_valid() ? url : GURL(kCheckUrl);
+    if (state_ == State::kReady) {
+      chrome::AddTabAt(window, target, -1, /*foreground=*/true);
+      return;
+    }
+    chrome::AddTabAt(window, StatusPage(IDS_HIVEY_TOR_CONNECTING), -1,
+                     /*foreground=*/true);
+    if (tabs::TabInterface* tab = window->GetActiveTabInterface()) {
+      waiting_.emplace_back(tab->GetContents()->GetWeakPtr(), target);
+    }
+    if (state_ == State::kStopped) {
+      Start(profile->GetPath());
+    }
+  }
+
+  // The port tor listens on: the same for a user data directory, apart
+  // from the usual Tor ports (9050, 9150).
+  int Port() const {
+    const std::string dir = g_browser_process->profile_manager()
+                                ->user_data_dir()
+                                .AsUTF8Unsafe();
+    return 9250 + static_cast<int>(base::PersistentHash(dir) % 500);
+  }
+
+  void Start(const base::FilePath& profile_dir) {
+    base::FilePath module_dir;
+    base::PathService::Get(base::DIR_MODULE, &module_dir);
+    const base::FilePath tor_dir = module_dir.AppendASCII(kTorDir);
+    const base::FilePath data_dir = profile_dir.AppendASCII("tor");
+    const base::FilePath log = data_dir.AppendASCII("notice.log");
+    base::CreateDirectory(data_dir);
+    base::DeleteFile(log);
+    const base::FilePath torrc = data_dir.AppendASCII("torrc");
+    if (!base::PathExists(torrc)) {
+      base::WriteFile(torrc, "");
+    }
+
+    base::CommandLine command(tor_dir.AppendASCII(kTorExe));
+    auto arg = [&](const char* name, const std::string& value) {
+      command.AppendArg(name);
+      command.AppendArg(value);
+    };
+    arg("-f", torrc.AsUTF8Unsafe());
+    arg("--defaults-torrc", torrc.AsUTF8Unsafe());
+    arg("--SocksPort", base::StringPrintf("127.0.0.1:%d", Port()));
+    arg("--DataDirectory", data_dir.AsUTF8Unsafe());
+    arg("--GeoIPFile", tor_dir.AppendASCII("geoip").AsUTF8Unsafe());
+    arg("--GeoIPv6File", tor_dir.AppendASCII("geoip6").AsUTF8Unsafe());
+    arg("--ClientOnly", "1");
+    arg("--AvoidDiskWrites", "1");
+    arg("--Log", "notice file " + log.AsUTF8Unsafe());
+    // tor exits by itself if the browser goes away.
+    arg("__OwningControllerProcess",
+        base::NumberToString(base::GetCurrentProcId()));
+
+    base::LaunchOptions options;
+#if BUILDFLAG(IS_WIN)
+    options.start_hidden = true;
+#else
+    options.kill_on_parent_death = true;
+#endif
+    process_ = base::LaunchProcess(command, options);
+    if (!process_.IsValid()) {
+      Finish(false);
+      return;
+    }
+    state_ = State::kStarting;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&WaitForBootstrap, log),
+        base::BindOnce(&TorController::Finish, weak_factory_.GetWeakPtr()));
+  }
+
+  void Finish(bool connected) {
+    state_ = connected ? State::kReady : State::kStopped;
+    if (!connected && process_.IsValid()) {
+      process_.Terminate(0, /*wait=*/false);
+      process_ = base::Process();
+    }
+    for (auto& [contents, url] : waiting_) {
+      if (contents) {
+        contents->GetController().LoadURL(
+            connected ? url : StatusPage(IDS_HIVEY_TOR_FAILED),
+            content::Referrer(), ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+            std::string());
+      }
+    }
+    waiting_.clear();
+  }
+
+  void Stop() {
+    if (process_.IsValid()) {
+      process_.Terminate(0, /*wait=*/false);
+      process_ = base::Process();
+    }
+    state_ = State::kStopped;
+    waiting_.clear();
+  }
+
+  State state_ = State::kStopped;
+  base::Process process_;
+  // Tabs waiting for Tor, with the page they then open.
+  std::vector<std::pair<base::WeakPtr<content::WebContents>, GURL>> waiting_;
+  base::ScopedObservation<BrowserCollection, BrowserCollectionObserver>
+      observation_{this};
+  base::WeakPtrFactory<TorController> weak_factory_{this};
+};
+
+}  // namespace
+
+void OpenTorWindow(const GURL& url) {
+  TorController::Get().Open(url);
+}
+
+bool IsTorProfile(const Profile* profile) {
+  return profile &&
+         profile->GetOriginalProfile()->GetPath().BaseName().AsUTF8Unsafe() ==
+             kTorProfileDir;
+}
+
+}  // namespace hivey
