+HiveyBarLayout GetHiveyBarLayout(const PrefService& prefs) {
+  // Every button in its default zone and order.
+  std::vector<std::pair<std::string, int>> known = {{"cyber", 0}};
+  for (const std::string& id : GetHiveyBarOrder(prefs)) {
+    known.emplace_back(id, 1);
+  }
+  for (const char* id : kHiveyBarTools) {
+    known.emplace_back(id, 2);
+  }
+  known.emplace_back("settings", 2);
+  // The user's order first (ids still known), then the others.
+  std::vector<std::string> order;
+  auto add = [&](const std::string& id) {
+    if (std::ranges::any_of(known, [&](const auto& k) { return k.first == id; }) &&
+        !std::ranges::contains(order, id)) {
+      order.push_back(id);
+    }
+  };
+  for (const base::Value& id : prefs.GetList(kHiveyBarOrder)) {
+    if (id.is_string()) {
+      add(id.GetString());
+    }
+  }
+  for (const auto& [id, zone] : known) {
+    add(id);
+  }
+  const base::DictValue& zones = prefs.GetDict(kHiveyBarZones);
+  HiveyBarLayout layout;
+  for (const std::string& id : order) {
+    int zone = std::ranges::find_if(known, [&](const auto& k) {
+                 return k.first == id;
+               })->second;
+    if (std::optional<int> chosen = zones.FindInt(id);
+        chosen && *chosen >= 0 && *chosen < kHiveyBarZoneCount) {
+      zone = *chosen;
+    }
+    layout[zone].push_back(id);
+  }
+  return layout;
+}
