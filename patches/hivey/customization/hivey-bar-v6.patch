+// Bookmarks import: Chromium-based browsers keep their bookmarks in a
+// "Bookmarks" JSON file in each profile folder (Default, Profile 1...);
+// Opera in its data folder itself.
+struct ChromiumBrowser {
+  const char* name;
+  const char* windows_dir;  // under %LOCALAPPDATA% (or %APPDATA% if roaming)
+  bool windows_roaming;
+  const char* linux_dir;    // under ~/.config
+  bool single_profile;      // Opera: the folder is the profile
+};
+constexpr ChromiumBrowser kChromiumBrowsers[] = {
+    {"Chrome", "Google/Chrome/User Data", false, "google-chrome", false},
+    {"Chromium", "Chromium/User Data", false, "chromium", false},
+    {"Edge", "Microsoft/Edge/User Data", false, "microsoft-edge", false},
+    {"Brave", "BraveSoftware/Brave-Browser/User Data", false,
+     "BraveSoftware/Brave-Browser", false},
+    {"Vivaldi", "Vivaldi/User Data", false, "vivaldi", false},
+    {"Opera", "Opera Software/Opera Stable", true, "opera", true},
+    {"Opera GX", "Opera Software/Opera GX Stable", true, nullptr, true},
+};
+
+// Blocking: every profile with bookmarks, as (file, "Browser — profile").
+std::vector<std::pair<base::FilePath, std::string>> FindImportSources() {
+  std::vector<std::pair<base::FilePath, std::string>> sources;
+  for (const ChromiumBrowser& browser : kChromiumBrowsers) {
+    base::FilePath dir;
+#if BUILDFLAG(IS_WIN)
+    if (!base::PathService::Get(browser.windows_roaming
+                                    ? base::DIR_ROAMING_APP_DATA
+                                    : base::DIR_LOCAL_APP_DATA,
+                                &dir)) {
+      continue;
+    }
+    dir = dir.AppendASCII(browser.windows_dir);
+#else
+    if (!browser.linux_dir) {
+      continue;
+    }
+    dir = base::GetHomeDir().AppendASCII(".config").AppendASCII(
+        browser.linux_dir);
+#endif
+    if (browser.single_profile) {
+      if (base::PathExists(dir.AppendASCII("Bookmarks"))) {
+        sources.emplace_back(dir.AppendASCII("Bookmarks"), browser.name);
+      }
+      continue;
+    }
+    base::FileEnumerator profiles(dir, /*recursive=*/false,
+                                  base::FileEnumerator::DIRECTORIES);
+    std::vector<base::FilePath> found;
+    for (base::FilePath profile = profiles.Next(); !profile.empty();
+         profile = profiles.Next()) {
+      if (base::PathExists(profile.AppendASCII("Bookmarks"))) {
+        found.push_back(profile);
+      }
+    }
+    std::ranges::sort(found);
+    for (const base::FilePath& profile : found) {
+      sources.emplace_back(
+          profile.AppendASCII("Bookmarks"),
+          found.size() == 1 ? std::string(browser.name)
+                            : base::StrCat({browser.name, " \u2014 ",
+                                            profile.BaseName().AsUTF8Unsafe()}));
+    }
+  }
+  return sources;
+}
+
+std::optional<base::Value> ReadBookmarksFile(const base::FilePath& path) {
+  std::string data;
+  if (!base::ReadFileToString(path, &data)) {
+    return std::nullopt;
+  }
+  return base::JSONReader::Read(data, base::JSON_PARSE_RFC);
+}
+
+// Adds a Bookmarks file's nodes under `parent`; returns the bookmarks added.
+int AddBookmarkNodes(bookmarks::BookmarkModel* model,
+                     const bookmarks::BookmarkNode* parent,
+                     const base::ListValue* children) {
+  int added = 0;
+  if (!children) {
+    return added;
+  }
+  for (const base::Value& child : *children) {
+    const base::DictValue* node = child.GetIfDict();
+    if (!node) {
+      continue;
+    }
+    const std::string* type = node->FindString("type");
+    const std::string* name = node->FindString("name");
+    const std::u16string title = base::UTF8ToUTF16(name ? *name : "");
+    if (type && *type == "url") {
+      const std::string* url = node->FindString("url");
+      const GURL gurl(url ? *url : std::string());
+      if (gurl.is_valid()) {
+        model->AddURL(parent, parent->children().size(), title, gurl);
+        ++added;
+      }
+    } else if (type && *type == "folder") {
+      added += AddBookmarkNodes(
+          model, model->AddFolder(parent, parent->children().size(), title),
+          node->FindList("children"));
+    }
+  }
+  return added;
+}
