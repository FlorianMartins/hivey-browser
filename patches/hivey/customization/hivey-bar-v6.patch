+// A modern icon: a translucent rounded tile in `color`, a hairline rim, and
+// the glyph (`mask`, white, 40 px for 20 DIP) in full `color`.
+gfx::ImageSkia GlassTile(const gfx::ImageSkia& mask,
+                         SkColor color,
+                         bool dark_toolbar) {
+  constexpr int kSize = 40;
+  gfx::Canvas canvas(gfx::Size(kSize, kSize), 1.0f, /*is_opaque=*/false);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(SkColorSetA(color, dark_toolbar ? 0x33 : 0x24));
+  canvas.DrawRoundRect(gfx::RectF(1, 1, 38, 38), 11, flags);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(1);
+  flags.setColor(SkColorSetA(color, 0x73));
+  canvas.DrawRoundRect(gfx::RectF(1.5f, 1.5f, 37, 37), 10.5f, flags);
+  const gfx::ImageSkia glyph = gfx::ImageSkia::CreateFrom1xBitmap(
+      mask.GetRepresentation(2.0f).GetBitmap());
+  canvas.DrawImageInt(gfx::ImageSkiaOperations::CreateColorMask(glyph, color),
+                      0, 0);
+  return gfx::ImageSkia::CreateFromBitmap(canvas.GetBitmap(), 2.0f);
+}
