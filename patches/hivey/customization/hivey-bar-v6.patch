+void HiveyStudioHandler::HandleGetImportSources(const base::ListValue& args) {
+  AllowJavascript();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&FindImportSources),
+      base::BindOnce(
+          [](base::WeakPtr<HiveyStudioHandler> handler, base::Value callback,
+             std::vector<std::pair<base::FilePath, std::string>> sources) {
+            if (!handler || !handler->IsJavascriptAllowed()) {
+              return;
+            }
+            base::ListValue list;
+            for (size_t i = 0; i < sources.size(); ++i) {
+              list.Append(base::DictValue()
+                              .Set("index", static_cast<int>(i))
+                              .Set("name", sources[i].second));
+            }
+            handler->import_sources_ = std::move(sources);
+            handler->ResolveJavascriptCallback(callback, list);
+          },
+          weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void HiveyStudioHandler::HandleImportBookmarks(const base::ListValue& args) {
+  // [callback, index in the sources last listed]: the number imported, or
+  // -1 when the file could not be read.
+  AllowJavascript();
+  const std::optional<int> index =
+      args.size() == 2 ? args[1].GetIfInt() : std::nullopt;
+  if (!index || *index < 0 ||
+      static_cast<size_t>(*index) >= import_sources_.size()) {
+    ResolveJavascriptCallback(args[0], base::Value(-1));
+    return;
+  }
+  const auto& [file, name] = import_sources_[*index];
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadBookmarksFile, file),
+      base::BindOnce(
+          [](base::WeakPtr<HiveyStudioHandler> handler, base::Value callback,
+             std::string name, std::optional<base::Value> json) {
+            if (!handler || !handler->IsJavascriptAllowed()) {
+              return;
+            }
+            bookmarks::BookmarkModel* model =
+                BookmarkModelFactory::GetForBrowserContext(
+                    handler->GetProfile());
+            const base::DictValue* roots =
+                json && json->is_dict() ? json->GetDict().FindDict("roots")
+                                        : nullptr;
+            if (!model || !model->loaded() || !roots) {
+              handler->ResolveJavascriptCallback(callback, base::Value(-1));
+              return;
+            }
+            // One folder per import, in Other bookmarks, named after the
+            // browser.
+            model->BeginExtensiveChanges();
+            const bookmarks::BookmarkNode* folder = model->AddFolder(
+                model->other_node(), model->other_node()->children().size(),
+                base::UTF8ToUTF16(name));
+            int added = 0;
+            for (const char* root : {"bookmark_bar", "other", "synced"}) {
+              if (const base::DictValue* node = roots->FindDict(root)) {
+                added +=
+                    AddBookmarkNodes(model, folder, node->FindList("children"));
+              }
+            }
+            model->EndExtensiveChanges();
+            handler->ResolveJavascriptCallback(callback, base::Value(added));
+          },
+          weak_factory_.GetWeakPtr(), args[0].Clone(), name));
+}
