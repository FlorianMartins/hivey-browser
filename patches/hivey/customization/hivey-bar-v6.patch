+// Hivey: the layers of the panel's content (web contents are native layers
+// a view's opacity does not reach), for its fade in.
+void CollectContentLayers(views::View& view,
+                          int depth,
+                          std::vector<ui::Layer*>& layers) {
+  if (view.layer()) {
+    layers.push_back(view.layer());
+  }
+  if (auto* const web_view = views::AsViewClass<views::WebView>(&view)) {
+    if (auto* holder = web_view->holder(); holder && holder->GetUILayer()) {
+      layers.push_back(holder->GetUILayer());
+    }
+  }
+  if (depth > 0) {
+    for (auto& child : view.children()) {
+      CollectContentLayers(*child, depth - 1, layers);
+    }
+  }
+}
