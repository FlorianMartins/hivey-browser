+// Bookmarks from another browser: Chromium-based ones read directly, Firefox
+// and HTML files through Chromium's import page.
+function importCard() {
+  const list = el('div', {class: 'bar-list'});
+  const status = el('p', {class: 'muted small'});
+  const find = async () => {
+    list.replaceChildren();
+    status.textContent = t('importSearching');
+    const sources = await sendWithPromise('getImportSources');
+    status.textContent = sources.length ? '' : t('importNone');
+    for (const source of sources) {
+      const button = el('button', {class: 'button', text: t('importButton')});
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        const count = await sendWithPromise('importBookmarks', source.index);
+        button.textContent = count < 0 ? t('importFailed') : t('importDone').replace('$1', count);
+      });
+      list.append(el('div', {class: 'bar-item'},
+                     el('span', {class: 'row-text'}, el('span', {class: 'row-label', text: source.name})),
+                     button));
+    }
+  };
+  return card(t('importTitle'),
+              el('p', {class: 'muted small', text: t('importHint')}),
+              el('div', {class: 'row'},
+                 el('div', {class: 'row-text'}, el('span', {class: 'row-label', text: t('importFind')})),
+                 el('button', {class: 'button', text: t('importFindButton'), onclick: find})),
+              status, list,
+              linkRow({label: t('importOther'), hint: t('importOtherHint'),
+                       onClick: () => chrome.send('openImportPage')}));
+}
