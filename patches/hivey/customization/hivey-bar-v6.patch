+void HiveyBarView::ToggleSidePanel(int entry_id, int fallback_command) {
+  BrowserWindowInterface* browser = browser_view_->browser();
+  SidePanelUI* side_panel = SidePanelUI::From(browser);
+  SidePanelRegistry* registry = SidePanelRegistry::From(browser);
+  const SidePanelEntryKey key(static_cast<SidePanelEntryId>(entry_id));
+  if (!side_panel || !registry || !registry->GetEntryForKey(key)) {
+    chrome::ExecuteCommand(browser, fallback_command);
+    return;
+  }
+  if (side_panel->IsSidePanelEntryShowing(key)) {
+    side_panel->Close();
+  } else {
+    side_panel->Show(key, SidePanelOpenTrigger::kToolbarButton);
+  }
+  UpdateActive();
 }
 
