+void SidePanel::FadeInContent(base::TimeDelta duration) {
+  if (!ShouldShowAnimation()) {
+    return;
+  }
+  std::vector<ui::Layer*> layers;
+  for (auto& child : content_parent_view_->children()) {
+    CollectContentLayers(*child, /*depth=*/3, layers);
+  }
+  if (layers.empty()) {
+    return;
+  }
+  views::AnimationBuilder builder;
+  builder.SetPreemptionStrategy(
+      ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET);
+  auto& block = builder.Once().SetDuration(duration);
+  for (ui::Layer* layer : layers) {
+    layer->SetOpacity(0.0f);
+    block.SetOpacity(layer, 1.0f, gfx::Tween::LINEAR_OUT_SLOW_IN);
+  }
+}
