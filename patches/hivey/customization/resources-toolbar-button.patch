+class HiveyResourcesCoordinator : public views::WidgetObserver {
+ public:
+  DECLARE_USER_DATA(HiveyResourcesCoordinator);
+
+  static HiveyResourcesCoordinator* From(BrowserWindowInterface* browser);
+
+  explicit HiveyResourcesCoordinator(BrowserWindowInterface* browser);
+  HiveyResourcesCoordinator(const HiveyResourcesCoordinator&) = delete;
+  HiveyResourcesCoordinator& operator=(const HiveyResourcesCoordinator&) =
