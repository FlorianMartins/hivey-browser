+
+HiveyResourcesUI::HiveyResourcesUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui, /*enable_chrome_send=*/true) {
+  // The same page as Hivey Studio; it shows only the Resources section when
+  // served from this host.
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), kChromeUIHiveyResourcesHost);
+  source->AddResourcePath("studio.css", IDR_HIVEY_STUDIO_CSS);
+  source->AddResourcePath("studio.js", IDR_HIVEY_STUDIO_JS);
+  source->AddResourcePath("i18n.js", IDR_HIVEY_STUDIO_I18N_JS);
+  source->AddResourcePath("logo.js", IDR_HIVEY_STUDIO_LOGO_JS);
+  source->SetDefaultResource(IDR_HIVEY_STUDIO_HTML);
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::RequireTrustedTypesFor,
+      "require-trusted-types-for 'script';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::TrustedTypes, "trusted-types;");
+  web_ui->AddMessageHandler(std::make_unique<HiveyStudioHandler>());
+}
+
+HiveyResourcesUI::~HiveyResourcesUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(HiveyResourcesUI)
