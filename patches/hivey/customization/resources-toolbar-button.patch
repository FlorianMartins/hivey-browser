+#include "url/gurl.h"
+
+DEFINE_USER_DATA(HiveyResourcesCoordinator);
+
+// static
+HiveyResourcesCoordinator* HiveyResourcesCoordinator::From(
+    BrowserWindowInterface* browser) {
+  return browser ? HiveyResourcesCoordinator::Get(
+                       browser->GetUnownedUserDataHost())
+                 : nullptr;
+}
+
+HiveyResourcesCoordinator::HiveyResourcesCoordinator(
+    BrowserWindowInterface* browser)
+    : browser_(browser),
+      bubble_manager_(WebUIBubbleManager::Create<HiveyResourcesUI>(
+          browser,
+          GURL(kChromeUIHiveyResourcesURL),
+          IDS_HIVEY_RESOURCES)),
+      scoped_unowned_user_data_(browser->GetUnownedUserDataHost(), *this) {}
+
+HiveyResourcesCoordinator::~HiveyResourcesCoordinator() = default;
+
+void HiveyResourcesCoordinator::ShowOrHide() {
+  if (bubble_manager_->GetBubbleWidget()) {
+    bubble_manager_->CloseBubble();
+    return;
+  }
+  BrowserWindow* window = BrowserWindow::FromBrowser(browser_);
+  PinnedToolbarActions* pinned =
+      window ? window->GetPinnedToolbarActions() : nullptr;
+  if (!pinned) {
+    return;
+  }
+  // Anchored on the button (or the overflow menu when the button is hidden).
+  pinned->GetBubbleAnchorAsync(
+      kActionShowHiveyResources,
+      base::BindOnce(&HiveyResourcesCoordinator::ShowAt,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void HiveyResourcesCoordinator::ShowAt(BubbleAnchorResult anchor) {
+  if (!anchor.has_value() || bubble_manager_->GetBubbleWidget()) {
+    return;
+  }
+  views::View* view = anchor->GetIfView();
+  const WebUIBubbleManager::Anchor bubble_anchor =
+      view ? WebUIBubbleManager::Anchor(view)
+           : WebUIBubbleManager::Anchor(anchor->GetAnchorRect());
+  bubble_manager_->ShowBubble(bubble_anchor, views::BubbleBorder::TOP_RIGHT);
+  if (views::Widget* widget = bubble_manager_->GetBubbleWidget()) {
+    widget_observation_.Observe(widget);
+    SetShowing(true);
+  }
+}
+
+void HiveyResourcesCoordinator::OnWidgetDestroying(views::Widget* widget) {
+  widget_observation_.Reset();
+  SetShowing(false);
+}
+
+void HiveyResourcesCoordinator::SetShowing(bool showing) {
+  // Highlights the button while its bubble is open.
+  if (!action_item_) {
+    action_item_ = actions::ActionManager::Get().FindAction(
+        kActionShowHiveyResources,
+        BrowserActions::From(browser_)->root_action_item());
+  }
+  if (action_item_) {
+    action_item_->SetIsShowingBubble(showing);
+  }
+}
