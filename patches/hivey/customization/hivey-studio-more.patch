+function textRow({label, hint, value, placeholder, onApply, restart}) {
+  const input = el('input', {type: 'url', class: 'text-input', placeholder, 'aria-label': label, 'data-key': label,
+                             spellcheck: 'false'});
+  input.value = value || '';
+  const apply = () => onApply(input.value.trim());
+  input.addEventListener('keydown', e => {
+    if (e.key === 'Enter') {
+      apply();
+    }
+  });
+  return el('div', {class: 'row'},
+            el('div', {class: 'row-text'},
+               el('span', {class: 'row-label'}, label, restart ? el('span', {class: 'pill', text: '↻'}) : null),
+               hint ? el('span', {class: 'row-hint', text: hint}) : null),
+            el('span', {class: 'text-field'}, input,
+               el('button', {class: 'button', text: t('apply'), onclick: apply})));
+}
