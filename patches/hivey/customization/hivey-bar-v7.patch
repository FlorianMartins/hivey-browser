-  canvas.DrawImageInt(gfx::ImageSkiaOperations::CreateColorMask(glyph, color),
-                      0, 0);
+  flags.setColor(SkColorSetA(SK_ColorWHITE, 0x40));
+  canvas.sk_canvas()->drawRRect(
+      SkRRect::MakeRectXY(SkRect::MakeXYWH(1.5f, 1.5f, 49, 49), 13.5f, 13.5f),
+      flags);
+  cc::PaintFlags knock_out;
+  knock_out.setBlendMode(SkBlendMode::kDstOut);
+  canvas.DrawImageInt(gfx::ImageSkia::CreateFrom1xBitmap(
