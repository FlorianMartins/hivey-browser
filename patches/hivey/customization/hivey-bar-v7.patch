+// Hivey: the content's margins, none on the Hivey bar's side (the bar keeps
+// its width when the panel opens); `top` is the header's height, or 0.
+gfx::Insets HiveyContentBorder(PrefService* prefs,
+                               bool right_aligned,
+                               int top) {
+  gfx::Insets insets = GetBorderInsets().set_top(top);
+  if (prefs->GetBoolean(hivey::kHiveyBarVisible)) {
+    if (right_aligned) {
+      insets.set_right(0);
+    } else {
+      insets.set_left(0);
+    }
+  }
+  return insets;
+}
