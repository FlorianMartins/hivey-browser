+      "2a04:4e42::/32"}},
+};
+
+// The CDN serving `address`, or null.
+const char* CdnName(const net::IPAddress& address) {
+  for (const Cdn& cdn : kCdns) {
+    for (const char* range : cdn.ranges) {
+      if (!range) {
+        break;
+      }
+      net::IPAddress prefix;
+      size_t bits = 0;
+      if (net::ParseCIDRBlock(range, &prefix, &bits) &&
+          net::IPAddressMatchesPrefix(address, prefix, bits)) {
+        return cdn.name;
+      }
+    }
+  }
+  return nullptr;
+}
+
+// The flag of a 2-letter country code, 16 x 12 DIP, or empty.
+gfx::ImageSkia FlagImage(const std::string& code) {
+  const auto* flag = std::ranges::find_if(
+      kHiveyFlags, [&](const HiveyFlag& f) { return code == f.code; });
+  if (flag == std::end(kHiveyFlags)) {
+    return gfx::ImageSkia();
+  }
+  const SkBitmap bitmap =
+      gfx::PNGCodec::Decode(base::span(flag->png, flag->size));
+  return bitmap.isNull() ? gfx::ImageSkia()
+                         : gfx::ImageSkia::CreateFromBitmap(bitmap, 2.0f);
+}
