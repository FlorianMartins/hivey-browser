 HiveyColorsObserver::HiveyColorsObserver() {
   if (PrefService* local_state = g_browser_process->local_state()) {
+    MigrateWholePalette(local_state);
     registrar_.Init(local_state);
-    registrar_.Add(kHiveyColors,
-                   base::BindRepeating(&HiveyColorsObserver::OnColorsChanged,
-                                       base::Unretained(this)));
+    auto changed = base::BindRepeating(&HiveyColorsObserver::OnColorsChanged,
+                                       base::Unretained(this));
+    registrar_.Add(kHiveyTheme, changed);
+    registrar_.Add(kHiveyColors, changed);
+  }
+}
+
+void HiveyColorsObserver::MigrateWholePalette(PrefService* local_state) {
+  if (local_state->HasPrefPath(kHiveyTheme) ||
+      !local_state->HasPrefPath(kHiveyColors)) {
+    return;
+  }
+  const base::DictValue& saved = local_state->GetDict(kHiveyColors);
+  // The theme sharing the most colors with the saved palette (an empty one
+  // was Material).
+  std::string_view best = saved.empty() ? "material" : "aura";
+  size_t best_shared = 0;
+  for (const Preset& preset : kPresets) {
+    size_t shared = 0;
+    for (const ColorEntry& entry : preset.colors) {
+      const std::string* hex = saved.FindString(entry.element);
+      shared += hex && *hex == entry.hex;
+    }
+    if (shared > best_shared) {
+      best = preset.name;
+      best_shared = shared;
+    }
+  }
+  const base::DictValue theme = GetHiveyColorPreset(best);
+  base::DictValue own;
+  for (const auto [element, value] : saved) {
+    const std::string* theirs = theme.FindString(element);
+    if (!theirs || !value.is_string() || value.GetString() != *theirs) {
+      own.Set(element, value.Clone());
+    }
   }
+  local_state->SetString(kHiveyTheme, best);
+  local_state->SetDict(kHiveyColors, std::move(own));
 }
 
 HiveyColorsObserver::~HiveyColorsObserver() = default;
