+// Hivey Tools on its translation workspace, in the side panel of `browser`.
+void ShowHiveyTranslation(BrowserWindowInterface* browser) {
+  if (!browser) {
+    return;
+  }
+  extensions::ExtensionSidePanelManager* manager =
+      extensions::ExtensionSidePanelManager::From(browser);
+  extensions::ExtensionSidePanelCoordinator* coordinator =
+      manager ? manager->GetCoordinator(HIVEY_BUNDLED_AI_ID) : nullptr;
+  SidePanelUI* side_panel = SidePanelUI::From(browser);
+  if (!coordinator || !side_panel) {
+    return;
+  }
+  coordinator->ShowHiveyMode("translate");
+  side_panel->Show(
+      SidePanelEntryKey(SidePanelEntryId::kExtension, HIVEY_BUNDLED_AI_ID),
+      SidePanelOpenTrigger::kExtension);
+}
+
+BrowserWindowInterface* BrowserWithTab(content::WebContents* contents) {
+  return contents
+             ? GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+                   contents)
+             : nullptr;
+}
