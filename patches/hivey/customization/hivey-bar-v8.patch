+void ResourceLimits::OnGamingModeChanged() {
+  namespace prefs = performance_manager::user_tuning::prefs;
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state) {
+    return;
+  }
+  // Inactive tabs sleep sooner while gaming (Memory Saver, which never
+  // discards a tab playing sound or video), then as before.
+  const int saved = local_state->GetInteger(
+      prefs::kHiveyGamingSavedAggressiveness);
+  if (local_state->GetBoolean(prefs::kHiveyGamingMode)) {
+    if (saved < 0) {
+      local_state->SetInteger(
+          prefs::kHiveyGamingSavedAggressiveness,
+          local_state->GetInteger(prefs::kMemorySaverModeAggressiveness));
+    }
+    local_state->SetInteger(
+        prefs::kMemorySaverModeAggressiveness,
+        static_cast<int>(prefs::MemorySaverModeAggressiveness::kAggressive));
+    local_state->SetInteger(
+        prefs::kMemorySaverModeState,
+        static_cast<int>(prefs::MemorySaverModeState::kEnabled));
+  } else if (saved >= 0) {
+    local_state->SetInteger(prefs::kMemorySaverModeAggressiveness, saved);
+    local_state->ClearPref(prefs::kHiveyGamingSavedAggressiveness);
+  }
+  OnCpuLimitChanged();
+  ApplyNetworkLimit();
+}
