+HiveyPageButtonView::HiveyPageButtonView(
+    Kind kind,
+    IconLabelBubbleView::Delegate* parent_delegate,
+    const gfx::FontList& font_list)
+    : IconLabelBubbleView(font_list, parent_delegate), kind_(kind) {
+  SetVisible(false);
+  SetImageModel(ui::ImageModel::FromVectorIcon(
+      kind == Kind::kTranslate
+          ? vector_icons::kGTranslateIcon
+          : (features::IsRoundedIconsEnabled()
+                 ? vector_icons::kInstallDesktopIcon
+                 : kInstallDesktopChromeRefreshOldIcon),
+      kColorOmniboxResultsIcon,
+      GetLayoutConstant(LayoutConstant::kLocationBarTrailingIconSize)));
+  const std::u16string tooltip = l10n_util::GetStringUTF16(
+      kind == Kind::kTranslate ? IDS_HIVEY_SERVER_INFO_TRANSLATE
+                               : IDS_HIVEY_OPEN_AS_APP);
+  SetTooltipText(tooltip);
+  GetViewAccessibility().SetName(tooltip);
+}
+
+HiveyPageButtonView::~HiveyPageButtonView() = default;
+
+void HiveyPageButtonView::Update(content::WebContents* web_contents,
+                                 bool force_hidden) {
+  web_contents_ = web_contents ? web_contents->GetWeakPtr() : nullptr;
+  bool visible = !force_hidden && web_contents &&
+                 web_contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS();
+  if (visible && kind_ == Kind::kTranslate) {
+    // Translation is Hivey Tools': not when it is turned off.
+    visible = extensions::ExtensionRegistry::Get(
+                  web_contents->GetBrowserContext())
+                  ->enabled_extensions()
+                  .Contains(HIVEY_BUNDLED_AI_ID);
+  }
+  if (visible != GetVisible()) {
+    SetVisible(visible);
+    PreferredSizeChanged();
+  }
+}
+
+bool HiveyPageButtonView::ShowBubble(const ui::Event& event) {
+  BrowserWindowInterface* browser = BrowserWithTab(web_contents_.get());
+  if (!browser) {
+    return false;
+  }
+  if (kind_ == Kind::kTranslate) {
+    ShowHiveyTranslation(browser);
+  } else {
+    // "Install page as app": any site, in its own window and taskbar icon;
+    // a shortcut where that is not offered.
+    if (!chrome::ExecuteCommand(browser, IDC_INSTALL_PWA)) {
+      chrome::ExecuteCommand(browser, IDC_CREATE_SHORTCUT);
+    }
+  }
+  return false;
+}
+
+bool HiveyPageButtonView::IsBubbleShowing() const {
+  return false;
+}
+
+bool HiveyPageButtonView::ShouldShowSeparator() const {
+  return false;
+}
