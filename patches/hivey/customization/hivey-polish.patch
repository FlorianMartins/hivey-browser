+
+void HiveyAiEngine::OnModelsRead(
+    bool download,
+    std::pair<std::string, std::vector<std::string>> models) {
+  g_choice = ModelNamed(models.first);
+  installed_ = std::move(models.second);
+  if (state_ == State::kChecking) {
+    const bool present = std::ranges::contains(installed_, ChosenModel().name);
+    state_ = present ? State::kOff : State::kNoModel;
+    if (!present && download) {
+      DownloadModel();
+      return;
+    }
+  }
+  Notify();
+}
+
+void HiveyAiEngine::SelectModel(const std::string& name, bool download) {
+  if (state_ == State::kDownloading) {
+    return;
+  }
+  Kill();
+  const Model* model = ModelNamed(name);
+  g_choice = model;
+  error_.clear();
+  state_ = State::kChecking;
+  base::ThreadPool::PostTaskAndReply(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&WriteChoice, model ? name : std::string()),
+      base::BindOnce(&HiveyAiEngine::CheckModels, weak_factory_.GetWeakPtr(),
+                     download));
+  Notify();
+}
+
+void HiveyAiEngine::RemoveModel(const std::string& name) {
+  const Model* model = ModelNamed(name);
+  if (!model || state_ == State::kDownloading) {
+    return;
+  }
+  if (model == &ChosenModel()) {
+    Kill();
+    state_ = State::kChecking;
+  }
+  base::ThreadPool::PostTaskAndReply(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&DeleteModel, PathOf(*model)),
+      base::BindOnce(&HiveyAiEngine::CheckModels, weak_factory_.GetWeakPtr(),
+                     false));
+  Notify();
 }
 
