+// The memory of the largest real graphics card, in GiB, 0 when there is none.
+int VideoMemoryGiB() {
+  static const int memory = [] {
+#if BUILDFLAG(IS_WIN)
+    HMODULE dxgi = ::LoadLibraryW(L"dxgi.dll");
+    if (!dxgi) {
+      return 0;
+    }
+    using CreateFactory = HRESULT(WINAPI*)(REFIID, void**);
+    auto create = reinterpret_cast<CreateFactory>(
+        ::GetProcAddress(dxgi, "CreateDXGIFactory1"));
+    Microsoft::WRL::ComPtr<IDXGIFactory1> factory;
+    if (!create || FAILED(create(IID_PPV_ARGS(&factory)))) {
+      return 0;
+    }
+    SIZE_T largest = 0;
+    Microsoft::WRL::ComPtr<IDXGIAdapter1> adapter;
+    for (UINT i = 0;
+         factory->EnumAdapters1(i, &adapter) != DXGI_ERROR_NOT_FOUND; ++i) {
+      DXGI_ADAPTER_DESC1 desc;
+      if (SUCCEEDED(adapter->GetDesc1(&desc)) &&
+          !(desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE)) {
+        largest = std::max(largest, desc.DedicatedVideoMemory);
+      }
+    }
+    // Cards report a little less than they say on the box.
+    return static_cast<int>((largest + (1 << 29)) >> 30);
+#else
+    return 0;
+#endif
+  }();
+  return memory;
+}
+
+bool UsesGpu() {
+  return VideoMemoryGiB() >= 8;
+}
+
+// What suits this machine.
+const Model& AutoModel() {
+  const int memory = base::SysInfo::AmountOfTotalPhysicalMemory().InGiB();
+  if (VideoMemoryGiB() >= 14 && memory >= 16) {
+    return kModelLarge;
+  }
+  if (UsesGpu() && memory >= 12) {
+    return kModelMedium;
+  }
+  return memory < 12 ? kModelSmall : kModelDefault;
+}
+
