+ui::ImageModel GradientIcon(const gfx::VectorIcon& icon) {
+  constexpr int kSize = 40;
+  gfx::Canvas canvas(gfx::Size(kSize, kSize), 1.0f, /*is_opaque=*/false);
+  gfx::PaintVectorIcon(&canvas, icon, kSize, SK_ColorWHITE);
+  cc::PaintFlags flags = GradientFlags(gfx::RectF(0, 0, kSize, kSize));
+  flags.setBlendMode(SkBlendMode::kSrcIn);
+  canvas.DrawRect(gfx::RectF(0, 0, kSize, kSize), flags);
+  return ui::ImageModel::FromImageSkia(
+      gfx::ImageSkia::CreateFromBitmap(canvas.GetBitmap(), 2.0f));
+}
 
