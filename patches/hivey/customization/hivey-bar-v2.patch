+bool HiveyBarView::OnMouseWheel(const ui::MouseWheelEvent& event) {
+  // With Hivey Tools open, the wheel moves to the workspace above or below.
+  SidePanelUI* side_panel = SidePanelUI::From(browser_view_->browser());
+  if (workspaces_.empty() || !side_panel ||
+      !side_panel->IsSidePanelEntryShowing(HiveyToolsKey())) {
+    wheel_accumulator_ = 0;
+    return false;
+  }
+  wheel_accumulator_ += event.y_offset();
+  if (std::abs(wheel_accumulator_) < ui::MouseWheelEvent::kWheelDelta) {
+    return true;  // a touchpad: wait for a full notch
+  }
+  const int step = wheel_accumulator_ > 0 ? -1 : 1;
+  wheel_accumulator_ = 0;
+  const int count = static_cast<int>(workspaces_.size());
+  int current = 0;
+  for (int i = 0; i < count; ++i) {
+    if (workspaces_[i].mode == active_mode_) {
+      current = i;
+    }
+  }
+  ShowWorkspace(workspaces_[(current + step + count) % count].mode);
+  return true;
+}
