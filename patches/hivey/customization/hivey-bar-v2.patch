 namespace {
 
+// Hivey: the sites Hivey Tools (the AI sidebar) may reach while its site
+// access is withheld: the AI providers' APIs named in its manifest, and the
+// web chats it shows in frames (Gemini, Claude, ChatGPT...: kHiveyAiFrameHosts,
+// from its header rules), which need host access for the rules that let them
+// be framed and for their sign-in cookies. Nothing else.
+void GrantHiveyToolsHosts(Profile* profile,
+                          const extensions::Extension* extension) {
+  extensions::PermissionsManager* permissions =
+      extensions::PermissionsManager::Get(profile);
+  if (!permissions->CanAffectExtension(*extension) ||
+      !permissions->HasWithheldHostPermissions(*extension)) {
+    return;  // the user gave it every site
+  }
+  extensions::ScriptingPermissionsModifier modifier(profile, extension);
+  // A copy: each grant replaces the extension's permission set.
+  const extensions::URLPatternSet granted =
+      extension->permissions_data()->active_permissions().explicit_hosts().Clone();
+  auto grant = [&](const URLPattern& pattern) {
+    if (!granted.ContainsPattern(pattern)) {
+      modifier.GrantHostPermission(pattern, base::DoNothing());
+    }
+  };
+  for (const URLPattern& pattern :
+       extensions::PermissionsParser::GetRequiredPermissions(extension)
+           .explicit_hosts()) {
+    if (!pattern.match_all_urls() && !pattern.host().empty() &&
+        !pattern.match_subdomains()) {
+      grant(pattern);
+    }
+  }
+  for (const char* host : kHiveyAiFrameHosts) {
+    grant(URLPattern(URLPattern::SCHEME_HTTPS,
+                     base::StrCat({"https://", host, "/*"})));
+  }
+}
