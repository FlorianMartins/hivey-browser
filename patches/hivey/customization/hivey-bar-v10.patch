+base::ListValue HiveyStudioHandler::BuildOptionalAddonsState() {
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(GetProfile());
+  base::ListValue addons;
+  for (const HiveyBundledExtension& extension : kHiveyBundledExtensions) {
+    if (extension.optional) {
+      addons.Append(base::DictValue()
+                        .Set("id", extension.id)
+                        .Set("name", extension.name)
+                        .Set("installed", registry->GetInstalledExtension(
+                                              extension.id) != nullptr));
+    }
+  }
+  return addons;
+}
+
+void HiveyStudioHandler::HandleAddOptionalAddon(const base::ListValue& args) {
+  // [id]: one of the optional bundled add-ons, installed now.
+  const std::string* id = args.size() == 1 ? args[0].GetIfString() : nullptr;
+  if (!id || !std::ranges::any_of(kHiveyBundledExtensions,
+                                  [&](const HiveyBundledExtension& extension) {
+                                    return extension.optional &&
+                                           *id == extension.id;
+                                  })) {
+    return;
+  }
+  PrefService* prefs = GetProfile()->GetPrefs();
+  base::ListValue chosen = prefs->GetList(hivey::kHiveyOptionalAddons).Clone();
+  if (!chosen.contains(*id)) {
+    chosen.Append(*id);
+    prefs->SetList(hivey::kHiveyOptionalAddons, std::move(chosen));
+  }
+  extensions::ExternalProviderManager::Get(GetProfile())
+      ->CheckForExternalUpdates();
+  FireStateChanged();
+}
