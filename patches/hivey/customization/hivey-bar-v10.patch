 namespace {
 
+// Hivey: "Copy link without tracking" (on a link) and "Copy page address
+// without tracking" (on the page), like Firefox's. Local command ids, in the
+// content context range Chromium leaves free.
+constexpr int kHiveyCopyCleanLink = 50198;
+constexpr int kHiveyCopyCleanPageUrl = 50199;
+
+// Query parameters that only follow people around: campaign tags and ad click
+// ids, as stripped by Firefox and the AdGuard URL tracking list.
+constexpr std::string_view kHiveyTrackingParams[] = {
+    "fbclid",  "gclid",    "gclsrc",   "dclid",       "gbraid",  "wbraid",
+    "msclkid", "mc_cid",   "mc_eid",   "yclid",       "ysclid",  "igshid",
+    "igsh",    "twclid",   "ttclid",   "li_fat_id",   "s_cid",   "_openstat",
+    "_hsenc",  "_hsmi",    "__hssc",   "__hstc",      "__hsfp",  "hsctatracking",
+    "mkt_tok", "oly_anon_id", "oly_enc_id", "vero_id", "vero_conv", "rb_clickid",
+    "wickedid", "epik",    "ref_src",  "ref_url",     "srsltid", "si",
+    "spm",     "sc_cid",   "trk",      "trkcampaign", "sr_share", "fb_action_ids",
+    "fb_action_types", "fb_ref", "fb_source", "action_object_map",
+    "action_type_map", "action_ref_map", "gs_l", "zanpid", "cvid", "oicd",
+};
+constexpr std::string_view kHiveyTrackingPrefixes[] = {"utm_", "pk_", "mtm_",
+                                                        "hsa_", "pf_rd_",
+                                                        "pd_rd_"};
+
+bool IsHiveyTrackingParam(std::string_view key) {
+  const std::string lower = base::ToLowerASCII(key);
+  if (std::ranges::contains(kHiveyTrackingParams, lower)) {
+    return true;
+  }
+  return std::ranges::any_of(kHiveyTrackingPrefixes, [&](std::string_view p) {
+    return lower.starts_with(p);
+  });
+}
+
+// `url` without its tracking query parameters (the others keep their order).
+GURL HiveyStripTracking(const GURL& url) {
+  if (!url.has_query()) {
+    return url;
+  }
+  std::vector<std::string> kept;
+  for (net::QueryIterator it(url); !it.IsAtEnd(); it.Advance()) {
+    if (!IsHiveyTrackingParam(it.GetKey())) {
+      kept.push_back(base::StrCat({it.GetKey(), it.GetValue().empty() ? "" : "=",
+                                   it.GetValue()}));
+    }
+  }
+  GURL::Replacements replacements;
+  const std::string query = base::JoinString(kept, "&");
+  if (kept.empty()) {
+    replacements.ClearQuery();
+  } else {
+    replacements.SetQueryStr(query);
+  }
+  return url.ReplaceComponents(replacements);
+}
