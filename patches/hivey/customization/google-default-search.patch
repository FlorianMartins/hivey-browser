# Google as the default search engine (its remote new tab page left out); the others stay in Settings > Search engine and Hivey Settings.
--- a/components/search_engines/template_url_prepopulate_data.cc
+++ b/components/search_engines/template_url_prepopulate_data.cc
@@ -317,14 +317,16 @@
     PrefService& prefs,
     const std::vector<raw_ptr<const PrepopulatedEngine>>&
         regional_prepopulated_engines) {
-  // Hivey: DuckDuckGo is the default search engine in every country (other
-  // engines stay one click away in Settings > Search engine).
+  // Hivey: Google is the default search engine in every country (Hivey
+  // Settings > Layout and Settings > Search engine change it; DuckDuckGo,
+  // Brave, Startpage... stay in the list). Its remote new tab page is left
+  // out: the new tab page stays local.
   if (std::unique_ptr<TemplateURLData> engine = FindPrepopulatedEngineInternal(
-          prefs, regional_prepopulated_engines, duckduckgo.id,
+          prefs, regional_prepopulated_engines, google.id,
           /*use_first_as_fallback=*/false)) {
     return engine;
   }
-  return PrepopulatedEngineToTemplateURLData(&duckduckgo);
+  return PrepopulatedEngineToTemplateURLData(&google);
 }
 
 }  // namespace TemplateURLPrepopulateData
