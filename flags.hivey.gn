# Hivey Browser GN args shared by every target, applied after
# ungoogled-chromium/flags.gn (and, for Windows, ungoogled-chromium-windows/
# flags.windows.gn); flags.hivey.<target>.gn comes last. Later values win.

# No Google services, no crash/usage reporting, no field trials.
enable_reporting=false
disable_fieldtrial_testing_config=true

# Release build tuned for speed (PGO profiles are fetched by `hb.py toolchain`).
is_official_build=true
chrome_pgo_phase=2
symbol_level=0
blink_symbol_level=0
v8_symbol_level=0

# The build host also serves production: ThinLTO limited to 4 threads per
# link.
hivey_thin_lto_jobs="4"
